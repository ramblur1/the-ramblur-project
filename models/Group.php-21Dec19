					}
					if (isset($searchChoice['club18']) && $searchChoice['club18']) {
						$query .= " OR s.type = " . self::TYPE_CLUB18;
					}
				}
				
				$query .= ")
						ORDER BY p.score DESC LIMIT 500
					) as s1 ON p.postId = s1.postId
					JOIN Subject AS s ON s.subjectId = p.subjectId 
					LEFT JOIN UserToSubject AS us ON us.subjectId = s.subjectId AND us.userId = ?
					JOIN ThemeColourOptions AS t ON t.id = IF(us.themeColourOptionId IS NULL, s.themeColourOptionId, us.themeColourOptionId)
					ORDER BY age ASC LIMIT $offset, $limit";

				$params = array($date, $userId, $userId, $userId);
			
				*/
				
				
			//the line below "AND FIND_IN_SET(categoryId,?)=0)" can now
			//most likely be removed.
			//AND FIND_IN_SET(categoryId,?)=0)

				
			//landingpage posts admin forum		
			} else if ((int)$thisType === self::TYPE_GENERAL && $this->getName($groupId) === "ramblur landing page posts") {
				
				//check if it's a scroll or a group feed refresh
				if($offset === 0) {
					$this->processWhiteList();
				}
				
				$query = "SELECT
					p.postId AS 'id',
					p.postType AS 'type',
					p.subjectId,
					TIMESTAMPDIFF(SECOND, p.`timeStamp`,NOW()) as 'age',
					t.value AS 'theme', 
					IF(us.opacity IS NULL, s.opacity, us.opacity) AS 'opacity'
					FROM Post AS p
					JOIN (
						SELECT p.postId 
						FROM Post AS p
						JOIN Subject AS s ON p.subjectId = s.subjectId 
						WHERE p.lastInput > ?
						AND s.private = FALSE 
						AND s.visible = TRUE
						AND p.modDeleted = 0
						AND (postType='post' OR postType = 'post_ad' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' OR postType = 'vlog')
						AND p.postId IN (SELECT postId FROM postWhiteList WHERE landingPage = TRUE)
						AND p.postId NOT IN (SELECT postId FROM postBlackList WHERE landingPage = TRUE)
						AND p.subjectId NOT IN (SELECT subjectId FROM forumBlackList WHERE landingPage = TRUE)
						AND p.userId NOT IN (SELECT userId FROM userPostBlackList WHERE landingPage = TRUE)
						AND (p.draftPost = FALSE OR p.draftPostVisible = TRUE)
						ORDER BY p.score DESC LIMIT 500
					) as s1 ON p.postId = s1.postId
					JOIN Subject AS s ON s.subjectId = p.subjectId 
					LEFT JOIN UserToSubject AS us ON us.subjectId = s.subjectId AND us.userId = ?
					JOIN ThemeColourOptions AS t ON t.id = IF(us.themeColourOptionId IS NULL, s.themeColourOptionId, us.themeColourOptionId)
					ORDER BY age ASC LIMIT $offset, $limit";

				//AND ((s.type = " . self::TYPE_RAMBLUR . ") OR (p.postId IN (SELECT postId FROM postWhiteList WHERE landingPage = TRUE)) OR (p.subjectId IN (SELECT subjectId FROM forumWhiteList WHERE landingPage = TRUE)))
					
				$date = date('Y-m-d', strtotime("-1000 days"));
				$params = array($date, $userId);
				
			//non-landingpage posts admin forum	
			} else if ((int)$thisType === self::TYPE_GENERAL && $this->getName($groupId) === 'ramblur excluded landing page posts') {			
				
				//check if it's a scroll or a group feed refresh
				if($offset === 0) {
					$this->processWhiteList();
				}
				
				$query = "SELECT
					p.postId AS 'id',
					p.postType AS 'type',
					p.subjectId,
					TIMESTAMPDIFF(SECOND, p.`timeStamp`,NOW()) as 'age',
					t.value AS 'theme', 
					IF(us.opacity IS NULL, s.opacity, us.opacity) AS 'opacity'
					FROM Post AS p
					JOIN (
						SELECT p.postId 
						FROM Post AS p
						JOIN Subject AS s ON p.subjectId = s.subjectId 
						WHERE p.lastInput > ?
						AND s.private = FALSE 
						AND s.visible = TRUE
						AND p.modDeleted = 0
						AND (p.draftPost = FALSE OR p.draftPostVisible = TRUE)
						AND (postType='post' OR postType = 'post_ad' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' OR postType = 'vlog')
