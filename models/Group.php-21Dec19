<?php if ( ! defined('BASEPATH')) exit('No direct script access allowed');

use Entities\Forum\Attribute;
use Entities\Forum\ForumVisibility;
use Entities\Forum\Visibility;

class Group extends CI_Model {

	function __construct() {

		// Call the Model constructor
		parent::__construct();

	}
	
	const DEFAULT_OPACITY 				= '100';
	const DEFAULT_PRIMARYCOLOUR			= '#008B8B';
	const DEFAULT_SECONDARYCOLOUR		= '#4169E1';
	const TYPE_RAMBLUR					= 0;
	const TYPE_RELATED					= 1;
	const TYPE_BUSINESS					= 2;
	const TYPE_GENERAL					= 3;
	const TYPE_CLUB18					= 4;
	const TYPE_SCHOOLS					= 5;
	
	// Masks for bit stuffed active and order in SubjectDisplayToUser table
	const SUBJECTDISPLAYTOUSER_ACTIVEMASK = 128;
	const SUBJECTDISPLAYTOUSER_DELETEDMASK = 64;
	const SUBJECTDISPLAYTOUSER_ORDERMASK = 15;
	
	// Results for an invitation to a subject
	const SUBJECTINVITE_DECLINE = 0;
	const SUBJECTINVITE_ACCEPT = 1;
	const SUBJECTINVITE_INVALID = 2;

	// Number of posts to retrieve for one page
	const NUMPOSTS_PERPAGE = 10;
	
	private $defaultThemeColourOption = NULL;
	private $defaultThemeFontOption = NULL;

	/**
	 * Creates a new forum. Used for any type of forum. If the forum is a non-ramblur forum, the creator will follow the forum, and
	 * be made a moderator for it.
	 * 
	 * @param array $data
	 * @param integer $data['relatedTo'] - subjectId of the subject that will be the parent of the new one
	 * @param string $data['name'] - name of the new subject
	 * @param string $data['type'] - type of the new subject eg. ramblur, general etc
	 * @param string $data['description'] - description text for the new subject
	 * @param boolean $data['private'] - determines if the forum will be public or private
	 * @param boolean $data['external'] - determines if the forum will be third party or not
	 * @param boolean $link - determines if the user should be added as a follower of the forum
	 * @param mixed $error - pass by reference variable to fill with an error message. Read by the caller
	 * @return array|boolean Returns false on failure, or an array with the new subject name and id on success
	 */
	function create($data, $link = true, &$error) {
	 
		// check if the user is logged in
		$userId = $this->user->authCheck();
		if ($userId === false) {
			$error = 'You must be logged in to create a forum.';
			return false;
		}
		// Validate data
		if (!isset($data['name']) || !$data['name']) {
			$error = 'Invalid forum name.';
			return false;
		}
		
		$nameError = false;
		$name = $this->validateForumName($data['name'], $nameError);
		if ($nameError !== false) {
			$error = $nameError;
			return false;
		}
		$this->load->helper(array('htmlpurifier', 'censor', 'stripper'));
		
		if (!isset($data['privacy'])) {
			$error = 'Forum privacy was not provided.';
			return false;
		}
		
		// Use the forum visibility value to determine if the forum is regarded as private or public
		try {
			$visibility = new Visibility($data['privacy']);
		} catch (UnexpectedValueException $e) {
			$error = 'Forum privacy was not valid.';
			return false;
		}
		$private = $this->subjectAttribute->getForumPrivateFromVisibility($visibility);
		
		// @todo - external. Where/how is it stored??
		
		if (!isset($data['type'])) {
			$error = 'Forum type was not provided.';
			return false;
		}
		if(!defined('self::TYPE_' . mb_strtoupper($data['type']))) {
			$error = 'Forum type could not be found.';
			return false;
		} else {
			$type = constant('self::TYPE_' . mb_strtoupper($data['type']));
		}

		if (!($type === self::TYPE_RAMBLUR || $type === self::TYPE_BUSINESS || $type === self::TYPE_CLUB18
				|| $type === self::TYPE_GENERAL || $type === self::TYPE_RELATED || $type === self::TYPE_SCHOOLS)) {
			$error = 'Invalid forum type.';
			return false;
		}
		
		if (($type == self::TYPE_RAMBLUR || $type == self::TYPE_SCHOOLS) && !$this->user->adminCheck()) {
			$error = 'You cannot create this type of forum. Try again through the settings area to find the correct type.';
			return false;
		}
		
		$ageBlock = false;
		if ($type === self::TYPE_CLUB18) {
			if (isset($data['ageBlock'])) {
				$ageBlock = $data['ageBlock'];
			} else {
				$error = 'ageBlock was not provided.';
				return false;
			}
		}
		
		if ((!isset($data['description']) || !$data['description'])) {
			// Allow admins to not send description for ramblur forums
			if ($this->user->adminCheck() && $type == self::TYPE_RAMBLUR) {
				$description = '';
			} else {
				$error = 'Invalid description.';
				return false;
			}
		}
		if (!isset($description)) {
			$description = censor_text(html_purify($data['description'], 'post'));
		}

		// Check related and business forum specific data
		if ($type === self::TYPE_RELATED || $type === self::TYPE_BUSINESS) {
			if (!isset($data['relatedTo'])) {
				$error = 'You must provide the forum id this forum will be related to.';
				return false;
			}
	
			// Check relatedTo exists
			$relatedForumId = $this->makeSubjectId($data['relatedTo'], $userId);
			if(!$relatedForumId) {
				$error = 'The forum this will be related to could not be found.';
				return false;
			}
			//get parent subject id from subject name
			// parentId will be the ramblur forum user wants the new forum to be under
			// Check if there is already a forum named 'business|related forums' with the parentId
			// If there is, the id of that forum is parentId for addSubjectAboveExisting
			$this->db->select('subjectId AS "id"')
				->from('Subject')
				->where(array(
					'parentSubjectId' => $relatedForumId,
					'subjectName' => $type == self::TYPE_BUSINESS ? 'business forums' : 'related forums')
				);
			$related = $this->db->get();
			if ($related->num_rows() > 0) {
				$parentId = $related->first_row('array')['id'];
			} else {
				// If there's not, check if there is already a forum named 'ramblur forums'. If not, have to also add
				// the ramblur forums branch.
				$this->db->select('subjectId AS "id"')
					->from('Subject')
					->where(array(
						'parentSubjectId' => $relatedForumId,
						'subjectName' => 'ramblur forums'
					));
				$ramblurBranchParent = $this->db->get();
				if ($ramblurBranchParent->num_rows() === 0) {
					$ramblurSql = 'CALL addRamblurForums(0, "", 1, ?, 0, 0, ?)';
					$this->db->query($ramblurSql, [$relatedForumId, $userId]);
				}
				// Create a new forum named 'business|related forums' using addSubjectAboveExisting (newPosition = 3 for business, 2 for related), with the ramblur forum as parentId, then use that newly created 
				// one as the parentId for addSubjectAboveExisting 
				// use userId 1 
				$sql = 'CALL AddSubjectAboveExisting(?, 0, "", 1, ?, ?, ?, ?, ?)';
				if($type == self::TYPE_RELATED ) {
					$result = $this->db->query($sql, array('related forums', $relatedForumId, 2, $userId, $type, $ageBlock));
				} else {
					$result = $this->db->query($sql, array('business forums', $relatedForumId, 3, $userId, $type, $ageBlock));
				}
				$parentId = is_null($result->row_array()["newSubjectId"]) ? false : $result->row_array()["newSubjectId"];

				if(!$parentId) {
					$error = 'There was an error trying to create the forum. Please try again.';
					return false;
				}
			}
			
		// Check general and club18 forum specific data
		} else if($type === self::TYPE_GENERAL || $type === self::TYPE_CLUB18) {
			
			$this->db->select('subjectId AS "id"')
				->from('Subject')
				->where(array(
					'type' => $type,
					'subjectName' => mb_substr($name, 0, 1))
				);
			$related = $this->db->get();
			if($related->num_rows() === 0) {
				$error = 'The parent forum could not be found.';
				return false;
			}
			$parentId = $related->first_row('array')['id'];
		// Ramblur forums need to have either no parent/relatedTo set, or the parent/relatedTo set to an existing ramblur forum
		} else if ($type === self::TYPE_RAMBLUR) {
			
			if (isset($data['relatedTo'])) {
				
				// get the related forum id from the forum name
				$relatedForumId = $this->makeSubjectId($data['relatedTo'], $userId);
				if(!$relatedForumId) {
					$error = 'The ramblur forum this will be related to could not be found.';
						return false;
					}
			
				// check if the 'ramblur forums' parent has previously been created for the forum		
				$this->db->select('subjectId AS "id"')
						->from('Subject')
						->where(array(
							'parentSubjectId' => $relatedForumId,
							'subjectName' => 'ramblur forums',
							'type' => self::TYPE_RAMBLUR
						));
				$related = $this->db->get();
				
				if($related->num_rows() > 0) {
					$parentId = $related->first_row()->id;
				} else {
					//if no 'ramblur forums' parent, then use the related forum as the parent
					$parentId = $relatedForumId; 
				}
			// create a top level ramblur forum
			} else {
				$parentId = 1;
			}
		}
		// Find how many subjects are above the new one in terms of alphabetical order.
		// mn added some untidy bits to this calculation based on the presence of some
		// 'non-alphabetic' elements at the start of the Subject table and the presence
		// of 'holes' in the Subject table where subjects have been moved or removed.
		// todo: write a routine that will crawl the whole table and close all of the
		//       holes - kind of a defrag...

		/*$this->db->select('COUNT(subjectId) AS "position"')
			->from('Subject')
		  ->where(array('parentSubjectId' => $parentId,'subjectName < ' => $name));
		  $position = $this->db->get()->row_array()["position"];*/
		$position = $this->getPosition($name,$parentId);

		// Create the subject
		$sql = 'CALL AddSubjectAboveExisting(?, ?, ?, 1, ?, ?, ?, ?, ?)';

		$result = $this->db->query($sql, array($name, $private, $description, $parentId, $position, $userId, $type, $ageBlock));

		if ($result->num_rows() > 0) {
			$subjectId = is_null($result->row_array()["newSubjectId"]) ? false : $result->row_array()["newSubjectId"];
			if($subjectId) {
				
				// Add attributes based on visibility
				$this->subjectAttribute->insertAttributesByVisibility($subjectId, $visibility);
				
				// if a non-ramblur forum, make the creator a moderator for that forum
				if (!($type == self::TYPE_RAMBLUR || $type == self::TYPE_SCHOOLS)) {
					$this->user->makeForumModerator($userId,$subjectId);
					$this->load->model('message');
					$this->message->systemMessage(1, $userId, $subjectId, message::MSG_FORUM_CREATE, array('subjectName' => $name));
				}
				
				// Add images that have already been uploaded to the subject
				$subjectDisplayInsertData = [];
				if (isset($data["memberBackgrounds"]) && is_array($data['memberBackgrounds'])) {
					$order = 0;
					foreach($data['memberBackgrounds'] as $m) {
						$order++;
						
						// Is the background one of our defaults?
						if (substr($m['id'], 0, 6) === 'sample') {
							// Copy it into user files
							$filename = $this->file->copyAssetFileToContent('img/backgrounds/'.substr($m['id'], 6).'.jpg', $userId);
							if (!$filename) {
								$error = 'There was a problem processing the background images, and so the forum was not created.';
								return false;
							}
						} else {
							$filename = $m['fileName'];
						}
						
						$subjectDisplayInsertData[] = [
							'subjectId' => $subjectId,
							'fileName' => $filename,
							'order' => $order,
							'active' => $m['active'],
							'type' => 'memberBg'
						];
						if ($private) {
							$this->file->moveFilesToPrivate($filename);
						}
						// add subject to content row
						$this->db->update('Content', ['subjectId' => $subjectId], ['fileName' => $filename]);
					}
				}
				if (isset($data['thirdPartyBackgrounds']) && is_array($data['thirdPartyBackgrounds'])) {
					$order = 0;
					foreach($data['thirdPartyBackgrounds'] as $m) {
						$order++;
						
						// Is the background one of our defaults?
						if (substr($m['id'], 0, 6) === 'sample') {
							// Copy it into user files
							$filename = $this->file->copyAssetFileToContent('img/backgrounds/'.substr($m['id'], 6).'.jpg', $userId);
							if (!$filename) {
								$error = 'There was a problem processing the background images, and so the forum was not created.';
								return false;
							}
						} else {
							$filename = $m['fileName'];
						}
						
						$subjectDisplayInsertData[] = [
							'subjectId' => $subjectId,
							'fileName' => $filename,
							'order' => $order,
							'active' => $m['active'],
							'type' => 'thirdPartyBg'
						];
						if ($private) {
							$this->file->moveFilesToPrivate($filename);
						}
						// add subject to content row
						$this->db->update('Content', ['subjectId' => $subjectId], ['fileName' => $filename]);
					}
				}
				
/* 				if (isset($data['carouselImages']) && is_array($data['carouselImages'])) {
					$order = 0;
					foreach($data['carouselImages'] as $m) {
						$order++;
						$subjectDisplayInsertData[] = [
							'subjectId' => $subjectId,
							'fileName' => $m['fileName'],
							'order' => $order,
							'active' => $m['active'],
							'type' => 'carousel'
						];
						if ($private) {
							$this->file->moveFilesToPrivate($m['fileName']);
						}
						// add subject to content row
						$this->db->update('Content', ['subjectId' => $subjectId], ['fileName' => $m['fileName']]);
					}
				} */
				
				if (isset($data['avatar'])) {
					$subjectDisplayInsertData[] = [
						'subjectId' => $subjectId,
						'fileName' => $data['avatar']['fileName'],
						'order' => 1,
						'active' => 1,
						'type' => 'avatar'
					];
					if ($private) {
						$this->file->moveFilesToPrivate($data['avatar']['fileName']);
					}
					// add subject to content row
					$this->db->update('Content', ['subjectId' => $subjectId], ['fileName' => $data['avatar']['fileName']]);
				}
				
				if (!empty($subjectDisplayInsertData)) {
					$this->db->insert_batch('SubjectDisplay', $subjectDisplayInsertData);
				}
				
				// Add categories
				if(isset($data['categories']) && count($data['categories'] > 0)) {
					if(count($data['categories']) > 1000) {
						$error = 'You have too many categories. Remove some and try again.';
						return false;
					}
					// create category with name = forum name and parentId = 0
					$rootCatResult = $this->db->query('CALL addCategory(?, ?, ?, ?, ?, ?, ?)', [$subjectId, $userId, $name, $description, 0, $private, 1]);
					if ($rootCatResult->num_rows() > 0) {
						$rootCatId = $rootCatResult->first_row('array')['newCategoryId'];
						if(!$rootCatId) {
							$error = 'There was a problem creating categories, so the forum could not be created. Please try again.';
							return false;
						}
						// Using try catch as processCreateCategories is recursive, and easier than relying on return values
						try {
							// create rest of categories
							$this->processCreateCategories($data['categories'], 'root', $rootCatId, $subjectId, $userId, $private);
						} catch (Exception $e) {
							$error = $e;
							return false;
						}
					} else {
						$error = 'There was a problem creating categories, so the forum could not be created. Please try again.';
						return false;
					}
				}
			
				// Set theme. Don't do earlier as part of the stored procedure, as setting it should be optional (there are defaults in the db)
				// and the create stored procedure is used as a utility. Always having to add 4 params is unnecessary.
				$themeUpdateData = [];
				if(isset($data['primaryColour'])) {
					$primaryColour = $data['primaryColour'];
					// Check value is a hex colour code
					$colourCode = ltrim($primaryColour, '#');
					if (mb_substr($primaryColour, 0, 1) === '#' && ctype_xdigit($colourCode) && (mb_strlen($colourCode) === 6) || mb_strlen($colourCode) === 3) {
						$themeUpdateData['primaryColour'] = $primaryColour;
					} else {
						$primaryColour = self::DEFAULT_PRIMARYCOLOUR;
					}
				} else {
					$primaryColour = self::DEFAULT_PRIMARYCOLOUR;
				}
				if(isset($data['secondaryColour'])) {
					$secondaryColour = $data['secondaryColour'];
					// Check value is a hex colour code
					$colourCode = ltrim($secondaryColour, '#');
					if (mb_substr($secondaryColour, 0, 1) === '#' && ctype_xdigit($colourCode) && (mb_strlen($colourCode) === 6) || mb_strlen($colourCode) === 3) {
						$themeUpdateData['secondaryColour'] = $secondaryColour;
					} else {
						$secondaryColour = self::DEFAULT_SECONDARYCOLOUR;
					}
				} else {
					$secondaryColour = self::DEFAULT_SECONDARYCOLOUR;
				}
				if(isset($data['primaryFontColour'])) {
					// Make sure font colour is set to valid value
					$this->db->select('id, value')
						->from('ThemeFontOptions')
						->where('value', $data['primaryFontColour']);
					$fontOption = $this->db->get();
					if ($fontOption->num_rows() > 0) {
						$primaryFontColour = $fontOption->first_row('array');
					} else {
						$primaryFontColour = $this->getDefaultThemeFontOption();
					}
					$themeUpdateData['primaryThemeFontOptionId'] = $primaryFontColour['id'];
				} else {
					$primaryFontColour = $this->getDefaultThemeFontOption();
				}
				if(isset($data['secondaryFontColour'])) {
					// Make sure font colour is set to valid value
					$this->db->select('id, value')
						->from('ThemeFontOptions')
						->where('value', $data['secondaryFontColour']);
					$fontOption = $this->db->get();
					if ($fontOption->num_rows() > 0) {
						$secondaryFontColour = $fontOption->first_row('array');
					} else {
						$secondaryFontColour = $this->getDefaultThemeFontOption();
					}
					$themeUpdateData['secondaryThemeFontOptionId'] = $secondaryFontColour['id'];
				} else {
					$secondaryFontColour = $this->getDefaultThemeFontOption();
				}
				if(isset($data['theme'])) {
					// Make sure theme is set to valid values
					$this->db->select('id, value')
						->from('ThemeColourOptions')
						->where('value', $data['theme']);
					$themeOption = $this->db->get();
					if ($themeOption->num_rows() > 0) {
						$theme = $themeOption->first_row('array');
					} else {
						$theme =  $this->getDefaultThemeColourOption();
					}
					$themeUpdateData['themeColourOptionId'] = $theme['id'];
				} else {
					$theme = $this->getDefaultThemeColourOption();
				}
				if(isset($data['opacity'])) {
					// Make sure opacity is a number between 0 and 100 inclusive
					$opacity = $data['opacity'] >= 0 && $data['opacity'] <= 100 ? (integer)$data['opacity'] : self::DEFAULT_OPACITY;
					$themeUpdateData['opacity'] = $opacity;
				} else {
					$opacity = self::DEFAULT_OPACITY;
				}
				if(!empty($themeUpdateData)) {
					$this->db->update('Subject', $themeUpdateData, ['subjectId' => $subjectId]);
				}
				
				if (isset($data['adsEnabled']) && !$data['adsEnabled']) {
					$this->db->insert('adsDisabled',
						[
							'forumId' => $subjectId,
							'userId' => $userId,
							'status' => 1,
							'lastModified' => date('Y-m-d H:i:s')
						]
					);
				}
				
				if ($link) {
					// Follow the new subject
					$insertData = array(
						'userId' => $userId,
						'subjectId' => $subjectId,
						'rootSubjectId' => $parentId,
						'banned' => '1000-01-01 00:00:00',
						'privateAccess' => $private ? 1 : 0,
						'primaryColour'  => $primaryColour,
						'secondaryColour'  => $secondaryColour,
						'themeColourOptionId' => $theme['id'],
						'primaryThemeFontOptionId' => $primaryFontColour['id'],
						'secondaryThemeFontOptionId' => $secondaryFontColour['id'],
						'opacity' => $opacity
					);
					$this->db->insert('UserToSubject', $insertData);
					
					$this->user->addUserToSubjectHistory($userId, $subjectId, true);
					
					// Add to main feed and my feed if they're not already following, since they're 
					// using ramblur forum features
					$mainFeedId = $this->group->findByNameAndType('main feed', self::TYPE_RAMBLUR);
					$mainFeedFollowed = $this->user->isForumSubscribed($mainFeedId);
					
					if (!$mainFeedFollowed) {
						$myFeedId = $this->group->findByNameAndType('my feed', self::TYPE_RAMBLUR);
						$query = "CALL addSubjectToUserList(?,?,?,?);";
						$this->db->query($query, array($userId, $mainFeedId, 0, 1));
						$this->db->query($query, array($userId, $myFeedId, 0, 1));
					}
				}
				return $subjectId;
			}
		}

		//if forum not created/updated.log error.
		$error = 'The forum could not be created.';
		return false;
	}
	
	public function validateForumName($name, &$error) {
		// Only allow numbers, lower case letter, space and -, taking unicode into account
		$name = preg_replace('/[^\p{N}\p{L}\s-]/u', '', $name);
		$name = mb_strtolower($name, 'UTF-8');

		if ($this->findByName($name) !== false) {
			$error = 'This forum name is unavailable. It may be already used, or reserved. Please choose a different name for your forum.';
			return false;
		}
		if (mb_strlen($name) < 3) {
			$error = 'Your forum name is invalid, it needs to be at least three letters in length.';
			return false;
		}
		return trim($name);
	}
	
	/**
	 * Calculates a subject's position in the Subject table hierarchy.  A bit of stuffing around as
	 * not all elements are in alphabetical order especially at level 1 of the hierarchy and there
	 * can be 'holes' in the hierarchy such that a straight count does not suffice
	 * @param string $name - name of new subject
	 * @param int|string $parentId - parent id of new subject
	 */

	private function getPosition($name,$parentId){

		$results = $this->db->query('SELECT nv,snv FROM Subject where subjectId = ?', [$parentId]);
		if ($results->num_rows() > 0) {
			$result = $results->result_array();
			$pnv = $result[0]['nv'];
			$psnv = $result[0]['snv'];
		} else {
			return 1;
		}

		// Start by getting all of the subjectnames on that level with that parentId
		// (ignoring first 30 subjectNames on the database as these are 'crap' subjects which would be
		// removed altogether if I could be bothered).

		$results=$this->db->query("SELECT subjectName, nv  FROM Subject where parentSubjectId=? and subjectId >= 30 ORDER BY nv/dv;",[$parentId]);

		if ($results->num_rows() > 0) {

			$subjects = $results->result_array();

			// Find the first subjectName in the results array that is lexicographically greater than $name,
			// otherwise return the next after last position

			for ($i=0; $i < count($subjects); $i++) {
				$nv = $subjects[$i]['nv'] + $psnv;
				if (strcmp($name,$subjects[$i]['subjectName']) < 0) {
					$nv = $subjects[$i]['nv'];
					break;
				}
			}
			//OK, get the position now based on nv, pnv, psnv of the first lexicographically greater subjectName
			// (side note: technically not ignoring the first 30 subjects in the db for this part)

			return round(($nv-$pnv)/$psnv);
		}
		return 1;
	}
	
	/**
	 * Recursive function that iterates over all the categories and adds them to the database with the correct parent ids etc.
	 * Can't just iterate over without some processing, as the parent may not be always before children.
	 * 
	 * @param array $cats - full array of categories to be added
	 * @param int|string $parent - root parent id (from client)
	 * @param int|string $realParentId	- root parent if (from database)
	 * @param int|string $subjectId - subject id categories will be added to
	 * @param int|string $userId - user creating the categories
	 * @param boolean $private - privacy of the subject
	 * @throws ErrorException
	 */
	private function processCreateCategories($cats, $parent, $realParentId, $subjectId, $userId, $private) {
	  $this->load->helper(array('htmlpurifier', 'censor'));

		foreach($cats as $key => $c) {
			if($c['parent'] === $parent) {
				unset($cats[$key]);
				$newCatResult = $this->db->query('CALL addCategory(?, ?, ?, ?, ?, ?, ?)', [$subjectId, $userId, censor_text(html_purify($c['name'], 'post')), censor_text(html_purify($c['description'], 'post')), $realParentId, $private, $c['visible']]);
				if($newCatResult->num_rows() === 0) {
					throw new ErrorException('The categories couldn\'t be created');
				}
				$newCatId = $newCatResult->first_row('array')['newCategoryId'];
				$this->processCreateCategories($cats, $c['id'], $newCatId, $subjectId, $userId, $private);
			}
		}
	}

	/*
		create or update forum in subject.
	 */
	function update($subjectId, $data, &$error) {
		//ChromePhp::log($data);
		$userId = $this->user->authCheck();
		if ($userId === false) {
			$error = 'You must be logged in to edit forums.';
			return false;
		}

		$subject = $this->dashboardInfo($subjectId);
		if(!$subject || !isset($subject['group'])) {
			$error = 'The forum could not be found.';
			return false;
		}
		$subject = $subject['group'];
		$accessType = $subject['accessType'];
		
		$subjectPrivacy = $this->subjectAttribute->getForumPrivateFromVisibility(new Visibility($subject['privacy']));
		
		$propertiesToUpdate = ['primaryColour', 'secondaryColour', 'primaryFontColour', 'secondaryFontColour', 'theme', 'opacity', 'memberBackgrounds'];
		if($accessType === 'admin' || $accessType === 'owner') {
			$propertiesToUpdate = array_merge($propertiesToUpdate, ['memberBackgrounds', 'thirdPartyBackgrounds', 'carouselImages', 'avatar', 'categories', 'description', 'adsEnabled', 'ageBlock']);
		}

		$updateValid = false;
		foreach($propertiesToUpdate as $p) {
			if (isset($data[$p])) {
				$updateValid = true;
				break;
			}
		}
		if (!$updateValid) {
			$error = 'Nothing to update.';
			return false;
		}

		// description
		$subjectDescription = $subject['description'];
		if (isset($data['description'])) {
			$this->load->helper(array('htmlpurifier', 'censor'));
			$subjectDescription = censor_text(html_purify($data['description'], 'post'));
			$this->db->update('Subject', ['description' => $subjectDescription], ['subjectId' => $subjectId]);
			
			// Update the root category description as well
			$this->db->update('Category', ['description' => $subjectDescription], ['subjectId' => $subjectId, 'parentCatId' => 0]);
		}
		
		/******************************* THEME ***********************************/
		$themeUpdateData = [];
		if (isset($data['primaryColour'])) {
			$primaryColour = $data['primaryColour'];
			// Check value is a hex colour code
			$colourCode = ltrim($primaryColour, '#');
			if (mb_substr($primaryColour, 0, 1) === '#' && ctype_xdigit($colourCode) && (mb_strlen($colourCode) === 6) || mb_strlen($colourCode) === 3) {
				$themeUpdateData['primaryColour'] = $primaryColour;
			} else {
				$error = 'The button and icon colour was not a valid hex colour code.';
				return false;
			}
		}
		if (isset($data['secondaryColour'])) {
			$secondaryColour = $data['secondaryColour'];
			// Check value is a hex colour code
			$colourCode = ltrim($secondaryColour, '#');
			if (mb_substr($secondaryColour, 0, 1) === '#' && ctype_xdigit($colourCode) && (mb_strlen($colourCode) === 6) || mb_strlen($colourCode) === 3) {
				$themeUpdateData['secondaryColour'] = $secondaryColour;
			} else {
				$error = 'The header colour was not a valid hex colour code.';
				return false;
			}
		}
		
		if(isset($data['primaryFontColour'])) {
				
			// Make sure font colour is set to valid values
			$this->db->select('id')
				->from('ThemeFontOptions')
				->where('value', $data['primaryFontColour']);
			$fontOption = $this->db->get();
			if ($fontOption->num_rows() === 0) {
				$error = 'The button font colour  is invalid.';
				return false;
			}
			$themeUpdateData['primaryThemeFontOptionId'] = $fontOption->first_row('array')['id'];
		}
		
		if(isset($data['secondaryFontColour'])) {
		
			// Make sure font colour is set to valid values
			$this->db->select('id')
				->from('ThemeFontOptions')
				->where('value', $data['secondaryFontColour']);
			$fontOption = $this->db->get();
			if ($fontOption->num_rows() === 0) {
				$error = 'The header font colour  is invalid.';
				return false;
			}
			$themeUpdateData['secondaryThemeFontOptionId'] = $fontOption->first_row('array')['id'];
		}
		
		if(isset($data['theme'])) {
			
			// Make sure theme is set to valid values
			$this->db->select('id')
				->from('ThemeColourOptions')
				->where('value', $data['theme']);
			$themeOption = $this->db->get();
			if ($themeOption->num_rows() === 0) {
				$error = 'The theme is invalid.';
				return false;
			}
			$themeUpdateData['themeColourOptionId'] = $themeOption->first_row('array')['id'];
		}
		if(isset($data['opacity'])) {
			// Make sure opacity is a number between 0 and 100 inclusive
			if ($data['opacity'] >= 0 && $data['opacity'] <= 100) {
				$themeUpdateData['opacity'] = (integer)$data['opacity'];
			} else {
				$error = 'The opacity is invalid';
				return false;
			}
		}
		if(!empty($themeUpdateData)) {
			if($accessType === 'follower') {
				$themeUpdateData['customisedTheme'] = 1;
				// Update User table as well if the forum is 'my feed'
				if($subjectId == 1) {
					$this->db->update('User', $themeUpdateData, ['userId' => $userId]);
				}
				$themeUpdateData['forumThemeSet'] = 0;
				$this->db->update('UserToSubject', $themeUpdateData, ['userId' => $userId, 'subjectId' => $subjectId]);
			} else {
				$this->db->update('Subject', $themeUpdateData, ['subjectId' => $subjectId]);
				// Update all users following the subject who haven't customised the field AND
				// explicitly make sure the current user sets their own customisation as well, to avoid the possibility of 
				// it getting out of sync with the forum theme
				
				// Update User table as well if the forum is 'my feed'
				if ($subjectId == 1) {
					$this->db->where('(customisedTheme = 0 OR userId = ' . $userId . ')')
						->update('User', $themeUpdateData);
				}
				$themeUpdateData['forumThemeSet'] = 0;
				$this->db->where('subjectId', $subjectId)
					->where('(customisedTheme = 0 OR userId = ' . $userId . ')')
					->update('UserToSubject', $themeUpdateData);
			}
			$themeSuccess = $this->db->affected_rows();
			if(!$themeSuccess) {
				$error = 'There was a problem updating the forum theme.';
				return false;
			}
		}
		
		/****************************** memberBackgrounds ********************************/
		$insertSubjectDisplayData = [];
		$insertCustomisedSubjectDisplayData = [];
		$deleteSubjectDisplayData = [];
		$updateSubjectDisplayData = [];
		if (isset($data['memberBackgrounds'])) {

			$memberBgsById = $this->getImageChangesMap($data['memberBackgrounds'], $subject['memberBackgrounds']);

			// loop over mapped backgrounds, if id='create', insert, if !new, delete, otherwise update
			foreach($memberBgsById as $id => $bg) {
				if ($id === 'create') {
					foreach($bg as $b) {
						$insertSubjectDisplayData[] = [
								'subjectId' => $subjectId,
								'fileName' => $b['fileName'],
								'userId' => $accessType === 'follower' ? $userId : NULL,
								'order' => $b['order'],
								'active' => $b['active'],
								'type' => 'memberBg'
						];
						// add subject to content row
						$this->db->update('Content', ['subjectId' => $subjectId], ['fileName' => $b['fileName']]);
					}
				} else if (!isset($bg['new'])) {
					if (is_null($bg['existing']['userId']) && $accessType === 'follower') {
						// Find if this wallpaper has been customised already
						$this->db->from('SubjectDisplayToUser')
							->where([
								'subjectDisplayId' => $id,
								'userId' => $userId
							]);
						$customised = $this->db->get();
						if ($customised->num_rows() > 0) {
							$updateSubjectDisplayData[] = [
								'table' => 'SubjectDisplayToUser',
								// can ignore active and order bits/set them to 0, as can't be turned back on after it's removed at this stage
								'set' => ['info' => self:: SUBJECTDISPLAYTOUSER_DELETEDMASK],
								'where' => [
									'subjectDisplayId' => $id,
									'userId' => $userId
								]
							];
						} else {
							$insertCustomisedSubjectDisplayData[] = [
								'subjectDisplayId' => $id,
								'userId' => $userId,
								'info' => self::SUBJECTDISPLAYTOUSER_DELETEDMASK
							];
						}
					} else {
						// for delete, just need id
						$deleteSubjectDisplayData[] = $id;
					}
				} else {
					// only update if active or order has been changed
					if($bg['new']['active'] !== $bg['existing']['active'] || $bg['new']['order'] !== $bg['existing']['order']) {
						// check userId of existing (should be same as new)
						// if null && $accessType === 'follower', insert into SubjectDisplayToUser (or update?)
						if (is_null($bg['existing']['userId']) && $accessType === 'follower') {
								// update SubjectDisplayToUser, or insert if doesn't exist
								$this->db->from('SubjectDisplayToUser')
									->where([
										'subjectDisplayId' => $id,
										'userId' => $userId
									]);
								$customised = $this->db->get();
								if($customised->num_rows() > 0) {
									$updateSubjectDisplayData[] = [
										'table' => 'SubjectDisplayToUser',
										// deleted flag is 0, as this one must be active, so can be ignored
										'set' => ['info' => $bg['new']['active'] ? self::SUBJECTDISPLAYTOUSER_ACTIVEMASK + $bg['new']['order'] : $bg['new']['order']],
										'where' => [
											'subjectDisplayId' => $id,
											'userId' => $userId
										]
									];
								} else {
									$insertCustomisedSubjectDisplayData[] = [
										'subjectDisplayId' => $id,
										'userId' => $userId,
										// deleted flag is 0, as we are putting one in, so can be ignored
										'info' => $bg['new']['active'] ? self::SUBJECTDISPLAYTOUSER_ACTIVEMASK + $bg['new']['order'] : $bg['new']['order']
									];
								}
						} else {
							// update SubjectDisplay
							$updateSubjectDisplayData[] = [
								'table' => 'SubjectDisplay',
								'set' => [
									'order' => $bg['new']['order'],
									'active' => $bg['new']['active']
								],
								'where' => [
									'id' => $id
								]
							];
						}
					}
				}
			}
		}
		
		/* **************** OWNER/ADMIN SPECIFIC PROPERTIES ***************** */
		
		if ($accessType === 'owner' || $accessType === 'admin') {
			// thirdPartyBackgrounds
			if (isset($data['thirdPartyBackgrounds'])) {
				$thirdPartyBgsById = $this->getImageChangesMap($data['thirdPartyBackgrounds'], $subject['thirdPartyBackgrounds']);
				
				// loop over mapped backgrounds, if id='create', insert, if !new, delete, otherwise update
				foreach($thirdPartyBgsById as $id => $bg) {
					if ($id === 'create') {
						foreach($bg as $b) {
							$insertSubjectDisplayData[] = [
								'subjectId' => $subjectId,
								'fileName' => $b['fileName'],
								'userId' => NULL,
								'order' => $b['order'],
								'active' => $b['active'],
								'type' => 'thirdPartyBg'
							];
							$updateSubjectDisplayData[] = [
								'table' => 'Content',
								'set' => [
									'subjectId' => $subjectId
								],
								'where' => [
									'fileName' => $b['fileName']
								]
							];
						}
					} else if (!isset($bg['new'])) {
						// for delete, just need id
						$deleteSubjectDisplayData[] = $id;
					} else {
						// only update if active or order has been changed
						if($bg['new']['active'] !== $bg['existing']['active'] || $bg['new']['order'] !== $bg['existing']['order']) {
							// update SubjectDisplay
							$updateSubjectDisplayData[] = [
								'table' => 'SubjectDisplay',
								'set' => [
									'order' => $bg['new']['order'],
									'active' => $bg['new']['active']
								],
								'where' => [
									'id' => $id
								]
							];
						}
					}
				}
			}
			
			// carousel pics
			/* if (isset($data['carouselImages'])) {
				$carouselImagesById = $this->getImageChangesMap($data['carouselImages'], $subject['carouselImages']);
			
				// loop over mapped images, if id='create', insert, if !new, delete, otherwise update
				foreach($carouselImagesById as $id => $bg) {
					if ($id === 'create') {
						foreach($bg as $b) {
							$insertSubjectDisplayData[] = [
								'subjectId' => $subjectId,
								'fileName' => $b['fileName'],
								'userId' => NULL,
								'order' => $b['order'],
								'active' => $b['active'],
								'type' => 'carousel'
							];
							$updateSubjectDisplayData[] = [
								'table' => 'Content',
								'set' => [
									'subjectId' => $subjectId
								],
								'where' => [
									'fileName' => $b['fileName']
								]
							];
						}
					} else if (!isset($bg['new'])) {
						// for delete, just need id
						$deleteSubjectDisplayData[] = $id;
					} else {
						// only update if active or order has been changed
						if($bg['new']['active'] !== $bg['existing']['active'] || $bg['new']['order'] !== $bg['existing']['order']) {
							// update SubjectDisplay
							$updateSubjectDisplayData[] = [
								'table' => 'SubjectDisplay',
								'set' => [
									'order' => $bg['new']['order'],
									'active' => $bg['new']['active']
								],
								'where' => [
									'id' => $id
								]
							];
						}
					}
				}
			} */
			
			// avatar
			if (isset($data['avatar'])) {
				// if old ones exists, delete it
				if($subject['avatar']) {
					$deleteSubjectDisplayData[] = $subject['avatar']['id'];
				}
				$insertSubjectDisplayData[] = [
					'subjectId' => $subjectId,
					'fileName' => $data['avatar']['fileName'],
					'userId' => NULL,
					'order' => 1,
					'active' => 1,
					'type' => 'avatar'
				];
				$updateSubjectDisplayData[] = [
					'table' => 'Content',
					'set' => [
						'subjectId' => $subjectId
					],
					'where' => [
						'fileName' => $data['avatar']['fileName']
					]
				];
			}
			
			// categories - add, hide, rename
			if (isset($data['categories'])) {
				
				$this->db->where('subjectId', $subjectId);
				$this->db->where('visible', null);
				$this->db->delete('Category');
				
				$newCategories = $data['categories'];
				$existingCategories = $subject['categories'];
				if (empty($newCategories)) {
					$error = 'You haven\'t provided any categories to add/update';
					return false;
				}

				// if no categories existing, treat as create categories does
				if(empty($existingCategories)) {
					if(count($newCategories) > 1000) {
						$error = 'You have too many categories. Remove some and try again.';
						return false;
					}

					// create category with name = forum name and parentId = 0
					$rootCatResult = $this->db->query('CALL addCategory(?, ?, ?, ?, ?, ?, ?)', [$subjectId, $userId, censor_text(html_purify($subject['name'], 'post')), $subjectDescription, 0, $subjectPrivacy, 1]);
					if ($rootCatResult->num_rows() > 0) {
						$rootCatId = $rootCatResult->first_row('array')['newCategoryId'];
						if(!$rootCatId) {
							$error = 'There was a problem updating the forum. Please try again.';
							return false;
						}
						// Using try catch as processCreateCategories is recursive, and easier than relying on return values
						try {
							// create rest of categories
							$this->processCreateCategories($newCategories, 'root', $rootCatId, $subjectId, $userId, $subjectPrivacy);
						} catch (Exception $e) {
							$error = $e;
							return false;
						}
					} else {
						$error = 'There was a problem updating the forum. Please try again.';
						return false;
					}
				// if already categories, go through and find changes.
				} else {
					// new, renames, and hides
					$catsById = [];
					$addingCats = false;

					for($i = 0; $i < count($newCategories); $i++) {
						$c = $newCategories[$i];

						// new ones have 'new' as the first part of the id. How to enforce this, or let the client know?
						if(mb_substr($c['id'], 0, 3) === 'new') {
							// new cats just get added. Don't need to add them to the map
							$addingCats = true;
						} else {
							$catsById[$c['id']] = ['new' => $c];
						}
					}
					
					for($i = 0; $i < count($existingCategories); $i++) {
						$c = $existingCategories[$i];
						if(isset($catsById[$c['id']])) {
							$catsById[$c['id']]['existing'] = $c;
						} else {
							$catsById[$c['id']] = ['existing' => $c];
						}
						// store root category
						if($c['parent'] == 0) {
							$rootCatId = $c['id'];
						}
					}
					
					// Update name and/or visible if changed
					foreach ($catsById as $id => $cat) {
						//ChromePhp::log($cat);
						$catUpdateData = [];
						if ($cat['new']['name'] !== $cat['existing']['name']) {
							$catUpdateData['name'] = $cat['new']['name'];
						}
						
						if ($cat['new']['description'] !== $cat['existing']['description']) {
							$catUpdateData['description'] = $cat['new']['description'];
						}
						
						if ($cat['new']['visible'] !== $cat['existing']['visible']) {
							$catUpdateData['visible'] = $cat['new']['visible'];
						}
						
						//DRAG AND DROP - for the category change where created cats can be moved
						if ($cat['new']['parent'] !== $cat['existing']['parent']) {
							$catUpdateData['parentCatId'] = $cat['new']['parent'];
						}
						
						if (!empty($catUpdateData)) {
							//ChromePhp::log($catUpdateData);
							$this->db->update('Category', $catUpdateData, ['categoryId' => $id]);
						}
					}
					
					// Add all categories at once, if any have been added
					if ($addingCats) {
						if(!isset($rootCatId)) {
							$error = 'The root category could not be found.';
							return false;
						}
						
						try {
							// create rest of categories
							$this->processAddCategories($newCategories, $rootCatId, $rootCatId, $subjectId, $userId, $subjectPrivacy);
						} catch (Exception $e) {
							$error = $e;
							return false;
						}
						
					}
				}
			}
			
			// ad settings
			if (isset($data['adsEnabled'])) {
				if ($data['adsEnabled']) {
					$this->db->delete('adsDisabled', ['forumId' => $subjectId]);
				} else {
					$this->db->insert('adsDisabled',
						[
							'forumId' => $subjectId,
							'userId' => $userId,
							'status' => 1,
							'lastModified' => date('Y-m-d H:i:s')
						]
					);
				}
			}
			
			// age settings
			if (isset($data['ageBlock'])) {
				if ($subject['type'] === 'club 18') {
					$this->db->update('Subject', ['requireAgeCheck' =>$data['ageBlock']], ['subjectId' => $subjectId]);
				}
			}
		}
		// Delete query
		if (!empty($deleteSubjectDisplayData)) {
			$this->db->where_in('id', $deleteSubjectDisplayData);
			$this->db->delete('SubjectDisplay');
		}
		
		// Insert forum wide and user only backgrounds
		if (!empty($insertSubjectDisplayData)) {
			$this->db->insert_batch('SubjectDisplay', $insertSubjectDisplayData);
		}
		
		// Insert customised forum wide backgrounds
		if (!empty($insertCustomisedSubjectDisplayData)) {
			$this->db->insert_batch('SubjectDisplayToUser', $insertCustomisedSubjectDisplayData);
		}
		
		// Update existing data
		foreach($updateSubjectDisplayData as $u) {
			$this->db->update($u['table'], $u['set'], $u['where']);
		}

		return $subjectId;
	}
	
	/**
	 * Does all the database work to set a forum to private
	 * @param int $subjectId
	 * @param bool $bePrivate
	 * @return boolean
	 */
	public function updateForumPrivacy(int $subjectId, Visibility $visibilityAttr){
		//Only allow the cli or admins run this at the moment
		if(!is_cli() && !$this->user->adminCheck()){
			return false;
		}
		
		if($subjectId === 0){
			return false;
		}
		
		$bePrivate = 0;
		if($visibilityAttr->equals($visibilityAttr::PRIVATE_())){
			$bePrivate = 1;
		}
		
		$this->load->model("SubjectAttribute");
		
		$this->db->trans_begin();
		$this->SubjectAttribute->updateAttributesByVisibility($subjectId, $visibilityAttr) ;
		
		$this->db->update('Subject', ['private' => $bePrivate, ], ['subjectId' => $subjectId]);
		$this->db->update('UserToSubject', ['privateAccess' => $bePrivate], ['subjectId' => $subjectId]);
		$this->db->trans_complete();
		if ($this->db->trans_status() === FALSE){
			$this->db->trans_rollback();
			return false ;
		}else{
			$this->db->trans_commit();
			return true;
		}
		return false;
		
	}
	
	
	
	private function getImageChangesMap($newImages, $existingImages) {
		$imagesById = [];
			
		// map both new and existing images to id, using the same mapping array
		for($i = 0; $i < count($newImages); $i++) {
			$b = $newImages[$i];
			$b['order'] = $i + 1;
			// new ones have id starting with 'new', so add to an array with 'create' as the key
			if(mb_substr($b['id'], 0, 3) === 'new') {
				if(!isset($imagesById['create'])) {
					$imagesById['create'] = [];
				}
				$imagesById['create'][] = $b;
			} else {
				$imagesById[$b['id']] = ['new' => $b];
			}
		}
		for($i = 0; $i < count($existingImages); $i++) {
			$b = $existingImages[$i];
			$b['order'] = $i + 1;
			if(isset($imagesById[$b['id']])) {
				$imagesById[$b['id']]['existing'] = $b;
			} else {
				$imagesById[$b['id']] = ['existing' => $b];
			}
		}
		return $imagesById;
	}
	
	private function processAddCategories($cats, $parent, $realParentId, $subjectId, $userId, $private) {
		$this->load->helper(array('htmlpurifier', 'censor'));
		
		foreach($cats as $key => $c) {
			if($c['parent'] === $parent) {
				unset($cats[$key]);
				
				// Only add those ones that don't exist
				if (mb_substr($c['id'], 0, 3) === 'new') {
					$newCatResult = $this->db->query('CALL addCategory(?, ?, ?, ?, ?, ?, ?)', [$subjectId, $userId, censor_text(html_purify($c['name'], 'post')), censor_text(html_purify($c['description'], 'post')), $realParentId, $private, $c['visible']]);
					if($newCatResult->num_rows() === 0) {
						throw new ErrorException('The categories couldn\'t be created');
					}
					$newCatId = $newCatResult->first_row('array')['newCategoryId'];
				} else {
					$newCatId = $c['id'];
				}
				$this->processAddCategories($cats, $c['id'], $newCatId, $subjectId, $userId, $private);
			}
		}
	}
	
	//groups(subjects) reported by users
	function reportForums($subjectId, $reason) {
		// check if the user is logged in
		$userId = $this->user->authCheck();
		
		if ( $userId === false ) {
			return false;
		}
		if($subjectId !== false) {
			$fields = array(
				'subjectId' => $subjectId,
					'userId' => $userId
			);
			$this->db->from('ReportForums')
				->where($fields);
			$existing = $this->db->get();
			if($existing->num_rows() > 0) {//check if user already complainted this forum
				$message = "You have already reported this Forum!";
				//return false;
			}
			else
			{
				$this->load->helper(array('htmlpurifier'));
				$this->db->insert('ReportForums',
					array(
						'subjectId' => $subjectId,
						'userId' => $userId,
						'reason' => html_purify($reason,'post')
				));
				$message = "The forum has been successfully reported!";
				//return true;
			}
			return  $message;
		} else {
			return false;
		}
	}
		//groups(subjects) suggested by users
	function suggestForums($subjectName, $description,$category,$subcategory, &$error) {
		// check if the user is logged in
		$userId = $this->user->authCheck();
		
		if ( $userId === false ) {
			return false;
		}
		
		//check if user already Suggested this forum
		$fields = array(
			'userId' => $userId,
			'subjectName' => $subjectName
		);
		$this->db->from('SuggestForums')
			->where($fields);
		$existing = $this->db->get();
		if($existing->num_rows() > 0) {
			$error = "You have already suggested this forum!";
			return false;
		}
		$this->load->helper(array('htmlpurifier'));
		
		$this->db->insert('SuggestForums',
			array(
				'userId' => $userId,
				'subjectName' => html_purify($subjectName,'post'),
				'description' => html_purify($description,'post'),
				'category'=>html_purify($category),
				'subcategory'=>html_purify($subcategory)
		));
		return $this->db->affected_rows() > 0;
	}
	
	//groups(subjects) to be adopted(adoptForums by users)
	function adoptForums($subjectName, $url,$softwares,$activeUsers) {
		// check if the user is logged in
		$userId = $this->user->authCheck();
		
		if ( $userId === false ) {
			return false;
		}
		$this->load->model('file');
		$url=$this->file->checkURL($url);
		if($url==false){
		  return (false);
		}
		$this->load->helper(array('htmlpurifier'));
		$fields = array(
			'userId' => $userId,
			'subjectName' => $subjectName
		);
		$this->db->from('AdoptForums')
			->where($fields);
		$existing = $this->db->get();
		if($existing->num_rows() > 0) {//check if user already Suggested to adopt this forum
			$message = "You have already applied for this forum to be transferred!";
			//return false;
		} else {
			$this->db->insert('AdoptForums',
				array(
					'userId' => $userId,
					'subjectName' => html_purify($subjectName,'post'),
					'url' => $url,
					'softwares' => html_purify($softwares,'post'),
					'activeUsers' => $activeUsers
			));
			$message = "Details for ".$subjectName." have been sent to Ramblur Admin to start the adoption process!";
		}
		return $message;
	}
	
	function delete($subjectId) {
		// check if the user is admin
		$userId = $this->user->adminCheck();
		if ($userId !== false) {
			$result = $this->db->query('CALL deleteSubject(?,?)', array($userId, $subjectId));
			if($result->num_rows() > 0) {
				//mysqli_next_result($this->db->conn_id);
				return $result->row_array()["isDeleted"];
			} else {
				return 'The subject was not deleted.';
			}
		} else {
			return 'You are not allowed to delete subjects.';
		}
		return true;
	}

	/**
	 * Retrieves a (paginated) list of subjects. If type is provided, only subjects of that type will
	 * be retrieved. 
	 * 
	 * @param number $page (optional) - determines the offset. Default is 0
	 * @param number $limit (optional) - determines the number of results. Default is 50
	 * @param number $type (optional) - restricts retrieved subjects to that type
	 * @return array|boolean
	 */
	function all($page = 0, $limit = 50, $type = null) {
		$limit = 1 * $limit;
		$page = 1 * $page;
		$this->load->database();
		$this->db->select("subjectName as 'name', subjectId as 'id', description")
			->from('Subject')
			->order_by('subjectName')
			->limit($limit, $page * $limit);
		if(!is_null($type)) {
			$this->db->where('type', $type);
		}

		$result = $this->db->get();
		
		if ($result->num_rows () > 0) {
			$groups = $result->result_array();
			return $groups;
		} else {
			return false;
		}
	}
	
	// Retrieves all the forums for the given ids
    function getForumsbyId(array $forumIds) {
		if(empty($forumIds)){
			return [];
		}
        $this->load->database();
		
		$groups = [] ;		
		// There can be many hundreds of subject ids, we can't pass them 
		// all at once to the db query so chunk them and query 200 at a time			
		foreach (array_chunk($forumIds, 200) as $chunkOfIds) {
			$this->db->select("*")			
				 ->from("Subject")
			     ->where_in('subjectId', $chunkOfIds);
			$result = $this->db->get() ;
			
			if ($result->num_rows () > 0) {
				$groups = array_merge($groups, $result->result_array());	
			} 			
		}
		
		if(!empty($groups)){
			return $groups;
		}
		return false;				
    }
	
    // Retrieves all the forum groups
    function getForums() {
        $query = "SELECT subjectName as 'group' FROM Subject ORDER BY subjectName";

        $query = $this->db->query($query);

        if ($query->num_rows() > 0) {

            $groups = array();
            $groups = $query->result_array();

            return $groups;
        } else {
            return false;
        }
    }
	 // Retrieves all the forum groups (ids and names)
    function getForumsNamesAndIds() {
		
        $query = "SELECT subjectName as 'name', subjectId as 'id' FROM Subject WHERE length(subjectName) > 2 and private = FALSE and visible = TRUE ORDER BY subjectName";

        $query = $this->db->query($query);

        if ($query->num_rows() > 0) {

            $groups = array();
            $groups = $query->result_array();

            return $groups;
        } else {
            return false;
        }
    }
	
	 // Retrieves all the draft forum groups (ids and names)
    function getDraftForumsNamesAndIds() {
		
		$this->load->model("user");
		
		$userId = $this->user->adminCheck();
		
        $query = "SELECT subjectName as 'name', subjectId as 'id' FROM Subject "
				. "WHERE subjectId in "
				. "(SELECT subjectId FROM Post where draftPost = TRUE AND (draftPostVisible = FALSE OR draftPostReplyCount > 0))"
				. "ORDER BY subjectName";

        $query = $this->db->query($query);

        if ($query->num_rows() > 0) {
            return $query->result_array();
        } else {
            return false;
        }
    }
	
	 // Retrieves all the draft forum groups (ids and names) for Admin
    function getAdminDraftForumsNamesAndIds() {
		
		$this->load->model("user");
		
		$userId = $this->user->adminCheck();
		
        $query = "SELECT subjectName as 'name', subjectId as 'id' FROM Subject "
				. "WHERE subjectId in "
				. "(SELECT subjectId FROM Post where draftPost = TRUE AND (draftPostVisible = FALSE OR draftPostReplyCount > 0) AND draftPostStatus = 1)"
				. "ORDER BY subjectName";

