	function updateForumAboutUsText($subjectId, $forumAboutUsText) {
		
		if(!$this->user->authCheck()) { //how bout checking for moderator here!!!!!
			return;
		}
		
		$this->load->helper(array('htmlpurifier', 'censor'));
		
		$purifiedText = censor_text(html_purify($forumAboutUsText,'post'));
		
		//could change this to check for existence first, then do an update if already there!
		$this->db->delete('SubjectToAboutText', ['id' => $subjectId]);
		
		$this->db->insert('SubjectToAboutText', [
			'id' => $subjectId,
			'aboutUsText' => $purifiedText
		]);

		if($this->db->affected_rows() > 0) {
			return $purifiedText;
		}
		return false;
	}
	
	function getAllPublicForums() {
		
		$userId = $this->user->authCheck();
		if(!$userId) {
			$userId = 0; //not logged in
		}
		
		$this->db->select('SubjectAttributes.name as inviteStatus, Subject.subjectId as forumId, subjectName, Subject.description, UserToSubject.subjectId AS subscribed, Subject.type, count(postId) AS numPosts')
				->from('Subject')
				->join('Post', 'Subject.subjectId = Post.subjectId and Post.visible = 1 and (Post.draftPost = 0 or Post.draftPostVisible = 1) and Post.modDeleted = 0 and Post.systemMsg = 0', 'LEFT')
				->join('UserToSubject', 'UserToSubject.subjectId = Subject.subjectId AND ' . $userId . ' = UserToSubject.userId', 'LEFT')
				->join('SubjectAttributeToSubject', 'SubjectAttributeToSubject.subjectId = Subject.subjectId', 'LEFT')
				->join('SubjectAttributes', 'SubjectAttributeToSubject.attributeId = SubjectAttributes.id', 'LEFT')
				->where('Subject.visible','1')
				->where('Subject.private','0')
				->where('length(Subject.subjectName)>','1')
				->where('Subject.subjectName != "main feed"')
				->where('Subject.subjectName != "my feed"')
				->where('Subject.subjectName != "ramblur forums"')
				->where('Subject.subjectId not in (select forumId from TopForums)')
				->group_by('forumId, subjectName, subscribed, inviteStatus')
				->order_by('numPosts', 'DESC')->order_by('subjectName');

		$allPublicForumsQuery = $this->db->get();
		
		if ($allPublicForumsQuery->num_rows() > 0) {
			return $allPublicForumsQuery->result_array();
		}
		return false;
		
	}
	
	function getAllPublicForumIds() {
		
		$userId = $this->user->authCheck();
		if(!$userId) {
			$userId = 0; //not logged in
		}
		
		$resultArray = [];
		
		$this->db->select('Subject.subjectId')
				->from('Subject')
				->where('Subject.visible','1')
				->where('Subject.private','0')
				->where('length(Subject.subjectName)>','1')
				->where('Subject.subjectName != "main feed"')
				->where('Subject.subjectName != "my feed"')
				->where('Subject.subjectName != "ramblur forums"')
				->where('Subject.subjectId not in (select forumId from TopForums)');

		$allPublicForumsQuery = $this->db->get();
		
		if ($allPublicForumsQuery->num_rows() > 0) {
			forEach($allPublicForumsQuery->result_array() as $forumId) {
				array_push($resultArray, $forumId["subjectId"]);
			}
			return $resultArray;
			//return $allPublicForumsQuery->result_array();
		}
		return null;
		
	}

}
