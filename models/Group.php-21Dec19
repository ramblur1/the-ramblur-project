        }
    }
	
	 // Retrieves all the draft forum groups (ids and names)
    function getDraftForumsNamesAndIdsByStatus($status) {
		
		$this->load->model("user");
		
		$userId = $this->user->adminCheck();
		
        $query = "SELECT subjectName as 'name', subjectId as 'id' FROM Subject "
				. "WHERE subjectId in "
				. "(SELECT subjectId FROM Post where draftPost = TRUE AND draftPostStatus = ? AND (draftPostVisible = FALSE OR draftPostReplyCount > 0) "
				. "AND (postType='post' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' OR postType = 'vlog'))"
				. "ORDER BY subjectName";

        $query = $this->db->query($query, array($status));

        if ($query->num_rows() > 0) {
            return $query->result_array();
        } else {
            return false;
        }
    }
	
	// Retrieves all the draft meta users
    function getDraftMetaUsers($subjectId = null) {

		$query = "SELECT userId, userName FROM draftMetaUsers ORDER BY userName";

		$query = $this->db->query($query);
		if ($query->num_rows() > 0) {
			return $query->result_array();
		} else {
			return false;
		}
	}
	
	// Retrieves all the draft users
    function getDraftUsers($userId = null, $subjectId = null) {
		
		$notAdminOnly = '';
		if(!$this->user->isAdmin($userId)) {
			$notAdminOnly = "AND User.userid in (select draftUserId from draftUserMapping where draftUserMapping.userId = $userId)";
		}

		if (!empty($subjectId) && !empty($userId)) {
			$query = "SELECT avatar, userName, FLOOR(DATEDIFF(CURDATE(),DOB) / 365) AS age, User.countryId, Country.name AS country, suburb, User.userId "
					. "FROM User join Country on User.countryId = Country.countryId "
					. "WHERE User.userType = 1 and User.userId in (select UserToSubject.userId from UserToSubject where subjectId = $subjectId) "
					. $notAdminOnly
					//. "and User.userId not in (select userId from draftMetaUsers)"
					. "ORDER BY userName";
		} else {
			$query = "SELECT avatar, userName, userId FROM User WHERE User.UserType = 1 ORDER BY userName";
		}

		$query = $this->db->query($query);

		if ($query->num_rows() > 0) {

			$users = $query->result_array();

			foreach ($query->result_array() as $key => $value) {
				$users[$key]["postCount"] = $this->getPostCount($value["userId"])->postCount;
			}
			return $users;
		} else {
			return false;
		}
	}

	function getPostCount($userId) {
		$query = "select count(postId) as postCount from Post where userId = $userId";

		$query = $this->db->query($query);

		if ($query->num_rows() > 0) {
			return $query->row();
		} else {
			return false;
		}
	}

	function getDraftPriorityDates() {
		
		$userId = $this->user->authCheck();
		if(!$userId) {
			return false;
		}
		
		$adminOnly = '';
		if($this->user->isAdmin($userId)) {
			$adminOnly = "AND postId in (select postId from Post where draftPostStatus = 1)";
		}
		
        $query = "SELECT postId, nodeId, DATE_FORMAT(nodePriorityDate, '%d-%m-%y') AS nodePriorityDate "
				. "FROM Nodes "
				. "WHERE nodePriorityDate is not NULL "
				. "AND draftNode = 1 AND draftNodeVisible = 0 "
				. $adminOnly
				. "ORDER BY nodePriorityDate";

        $query = $this->db->query($query);

        if ($query->num_rows() > 0) {
            $dates = $query->result_array();
            return $dates;
        } else {
            return false;
        }
    }
	
	/**
	 * Retrieve all user's forums and categories (if visible in Subject)
	 * @param string $name
	 * @return int
	 */
	function getUsersGroupsAndCats($subjectId, $useCatFilterListDefaults = false) {
		
		if ( !$userId = $this->user->authCheck() ) {
			return false;
		}
		if ($useCatFilterListDefaults) {
			$this->db->select('catFilterListDefault')
					->from('UserToSubject')
					->where('userId', $userId)
					->where('subjectId', $subjectId);

			$query = $this->db->get();

			if ($query->num_rows() > 0) {
				$catFilterListDefault = $query->result_array();
				$this->db->set('catFilterList', $catFilterListDefault[0]["catFilterListDefault"])
						->where('subjectId', $subjectId)
						->where('userId', $userId)
						->update('UserToSubject');
			}
		}

		$this->db->select('UserToSubject.subjectId')
				->select('UserToSubject.userId')
				->select('UserToSubject.displayed')
				->select('UserToSubject.catFilterList')
				->select('Subject.subjectName')
				->select('Category.categoryId')
				->select('Category.parentCatId')
				->select('Category.subjectId AS catSubId')
				->select('Category.name AS catName')
				->select('Category.description AS catDescription')
				->select('Category.level')
				->select('`Category`.`nv`/`Category`.`dv` AS catBranchOrder', FALSE)
				->from('UserToSubject')
				->join('Subject', 'UserToSubject.subjectId = Subject.subjectId')
				->join('Category', 'Category.subjectId = UserToSubject.subjectId', 'left')
				->where('UserToSubject.userId', $userId)
				->where('UserToSubject.subjectId', $subjectId)
				->where('UserToSubject.active', 1)
				->where('Subject.visible', 1)
				->where('Category.level < 31')
				->where('Category.visible', 1)
				->where('Subject.subjectName !=', "main feed")
				->order_by('Subject.subjectName, catBranchOrder');
				
		$query = $this->db->get();
		
		if($query->num_rows() > 0) {
			$groupsAndCats = $query->result_array();
			
			//need to find out if the forum or cat has any kittens
			foreach($groupsAndCats as &$subject) {
				$subject["hasKittens"] = $this->checkForKittens($subject["categoryId"], $subject["subjectId"]);
				$subject["visible"] = $this->checkCatVisibility($subject["categoryId"], $subject["subjectId"], $subject["catFilterList"]);
				$subject["parentVisibility"] = $this->getParentVisibility($subject["subjectId"]);
			}
			
			return $groupsAndCats;
		} else {
			return false;
		}
	}
	
	
	//checks for sub-categories or "kittens"!
	function checkForKittens($catId, $subjectId) {
		
		$this->db->select('subjectId')
				->from('Category')
				->where("parentCatId IN (SELECT categoryId FROM Category WHERE categoryId = '$catId' AND subjectId = '$subjectId')");
		
		$query = $this->db->get();
		if($query->num_rows() > 0) {
			return TRUE;
		} 
		return FALSE;
	}
	
	//checks if a cat is visible or not
	function checkCatVisibility($catId, $subjectId, $catFilterList) {
		$catFilterArr = explode(',', $catFilterList);
		return(!in_array($catId, $catFilterArr)); 
	} 
		
	//updates visibility of forums and cats
	function updateUsersGroupsAndCats($groupData) {
		if (!$userId = $this->user->authCheck()) {
			return false;
		}

		$groups = $groupData["forumStoreData"];
		
		$thirdParty = false;
		$forumsFollowed = $this->user->getUserForumIds($userId);
		if (count($forumsFollowed) == 1) {
			$thirdParty = true;
		}
		
		foreach ($groups as $group) {

			$newArr = [];
			$catFiltrerListArr = [];
			$catFiltrerList = null;
			$parts = [];
			$dbList = [];
			$parts_str = null;

			//@todo - check if bulk (batch) updates can be used here
			if ($group["parent"] === "root") {
				// If the user is only following one group, they can't hide it
				if (!$thirdParty) {
					$this->db->set('displayed', $group["visible"])
						->where('subjectId', $group["subjectId"])
						->where('userId', $userId)
						->update('UserToSubject');
				}
			} else if (!$group["visible"]) {
				//add it
				if (array_key_exists('catFilterList', $group)) {
					$catFiltrerListArr = explode(',', $group["catFilterList"]);
					if (!in_array($group["id"], $catFiltrerListArr)) {
						array_push($newArr, $group["id"]);
						$catFiltrerList = implode(",", $newArr);

						$this->db->set('catFilterList', 'TRIM(LEADING \',\' FROM CONCAT(catFilterList,\',\',\'' . $catFiltrerList . '\'))', FALSE);
						if($groupData["setCatFilterListDefault"]) {
							$this->db->set('catFilterListDefault', 'TRIM(LEADING \',\' FROM CONCAT(catFilterListDefault,\',\',\'' . $catFiltrerList . '\'))', FALSE);
						}		
						$this->db->where('userId', $userId)
								->where('subjectId', $group["subjectId"])
								->update('UserToSubject');
						
					}
					
					
				}
			} else if ($group["visible"]) {
				//delete it
				$this->db->select('catFilterList')
					->where('userId', $userId)
					->where('subjectId', $group["subjectId"])
					->from('UserToSubject');

				$query = $this->db->get();
				
				if ($query->num_rows() > 0) {
					$dbList = $query->result_array();
				}
				//put the string into an array and then remove the element
				if (!empty($dbList)) {
					$parts = array_unique(explode(',', $dbList[0]["catFilterList"]));
				}
				$key = array_search($group["id"], $parts);
				if ($key !== false) {
					unset($parts[$key]);
					$parts_str = implode(",", array_filter($parts));
					$this->db->set('catFilterList', $parts_str);
					if($groupData["setCatFilterListDefault"]) {
						$this->db->set('catFilterListDefault', $parts_str);
					}
					$this->db->where('subjectId', $group["subjectId"])
						->where('userid', $userId)
						->update('UserToSubject');
				}
				
			}
		} //end of for loop

		// end here if from device - group changing/status is handled in js
		if(isset($groupData['fromDevice'])) {

			return true;

		}
		
		$gotTo = $groupData["groupActive"];
		
		if (!$thirdParty) {
			//can't rely on the id's always being the same!
			$mainFeedId = $this->findByNameAndType('main feed', self::TYPE_RAMBLUR);
			$myFeedId = $this->findByNameAndType('my feed', self::TYPE_RAMBLUR);
			
			//if they are turning off the current active group
			if(!$this->getParentVisibility($groupData["groupActive"])) {
				$gotTo = $myFeedId;
				if(!$this->getParentVisibility($myFeedId) && $this->getParentVisibility($mainFeedId)) {
					$gotTo = $mainFeedId;
				} else if (!$this->getParentVisibility($myFeedId) && !$this->getParentVisibility($mainFeedId)) {
					//get the first active group left
					$this->db->select('UserToSubject.subjectId')
						->from('UserToSubject')
						->join('Subject', 'UserToSubject.subjectId = Subject.subjectId')
						->where('UserToSubject.displayed', 1)
						->where('UserToSubject.active', 1)
						->where('Subject.visible', 1)
						->where('UserToSubject.userId', $userId)
						->order_by('Subject.subjectName')
						->limit(1);
			
					$query = $this->db->get();
					if($query->num_rows() > 0) {
						$gotTo  = $query->row()->subjectId;
					} 
				}
			}
			//get count of filtered groups, and if zero, activate main feed
			//as we need at least one active (visible) group!!!
			if(!$this->getVisibilityCount($userId)) {
				$this->db->set('displayed', "1")
							->where('subjectId', $mainFeedId)
							->where('userId', $userId)
							->update('UserToSubject');
				
				$gotTo = $mainFeedId;
			}
		}
		
		//return the safe group to go to!
		return $gotTo;
	}

	//returns the vis of the parent cat or forum
	function getParentVisibility($subjectId) {
		
		if ( !$userId = $this->user->authCheck() ) {
			return false;
		}
		
		$this->db->select('UserToSubject.displayed')
				->from('UserToSubject')
				->join('Subject', 'UserToSubject.subjectId = Subject.subjectId')
				->where('UserToSubject.subjectId', $subjectId)
				->where('UserToSubject.userId', $userId)
				->where('Subject.visible', 1); //check this!!!!!!!!!!!!!!!!!!111
		
		$query = $this->db->get();
		if($query->num_rows() > 0) {
			return $query->result_array()[0]["displayed"];
		} 
		return NULL;
	}
	
	//returns the vis of the parent cat or forum
	function getVisibilityCount($userId) {
		
		$this->db->select('UserToSubject.displayed')
				->from('UserToSubject')
				->join('Subject', 'UserToSubject.subjectId = Subject.subjectId')
				->where('displayed', 1)
				->where('UserToSubject.userId', $userId)
				->where('Subject.visible', 1);
		
		$query = $this->db->get();
		if($query->num_rows() > 0) {
			return TRUE;
		} 
		return FALSE;
	}
		

	// find all suggested groups that are waiting for approval
	function unapproved() {
		$this->db->select("s.id, 
				s.subjectName AS 'name', 
				s.description, 
				s.userId,
				u.userName")
			->from('SuggestForums AS s')
			->join('User AS u', 'u.userId = s.userId', 'LEFT')
			->where('checkedResult IS NULL');
		$result = $this->db->get();

		if ($result->num_rows() > 0) {
			$groups = $result->result_array();
			return $groups;
		} else {
			return false;
		}
	}
	
	/**
	 * Handles checking of a suggested subject by an admin. If the subject was approved,
	 * it will be created as a proper subject. If it was not approved, it is still stored for historical purposes,
	 * and also can't be created again by either the same or different user
	 * 
	 * @param int $subjectId
	 * @param boolean $approved
	 */
	function adminChecked($suggestedSubjectId, $approved = FALSE, $parentSubjectName = null, &$error) {
		// check if the user is admin. Should be done by controller, but just to be safe, check again.
		if ($this->user->adminCheck() === false) {
			$error = 'You do not have access to this area.';
			return false;
		}
			
		// check suggested subject exists
		$this->db->select("id, userId, subjectName AS 'name', description")
			->from('SuggestForums')
			->where('id', $suggestedSubjectId);
		$suggestedSubjectResult = $this->db->get();
		if ($suggestedSubjectResult->num_rows() == 0) {
			$error = 'The suggested subject to be approved could not be found.';
			return false;
		}
		$suggestedSubject = $suggestedSubjectResult->first_row('array');
		
		if($approved) {	
			if(is_null($parentSubjectName)) {
				$error = 'A parent subject name was not provided.';
				return false;
			}
			$newSubjectId = $this->create([
				'relatedTo' => $parentSubjectName,
				'name' => $suggestedSubject['name'],
				'type' => 'ramblur',
				'description' => $suggestedSubject['description'],
				'private' => false,
				'external' => false], false, $error);
			if($newSubjectId === false) {
				// error message should already be filled from the create call
				return false;
			}
			$this->db->update('SuggestForums',
				array('checkedResult' => 1),
				array('id' => $suggestedSubjectId));
			
			// Send message to requester
			$this->message->systemMessage($this->user->authCheck(), $suggestedSubject["userId"], $newSubjectId, message::MSG_FORUM_APPROVED, ['suggestedName' => $suggestedSubject['name']]);
			return $newSubjectId;
		} else {
			$this->db->update('SuggestForums',
				array('checkedResult' => 0),
				array('id' => $suggestedSubjectId));
			if($this->db->affected_rows() > 0) {
				// Send message to requester, using home subject as kludge
				$this->message->systemMessage($this->user->authCheck(), $suggestedSubject["userId"], 1, message::MSG_FORUM_DENIED, ['suggestedName' => $suggestedSubject['name']]);
				return true;
			} else {
				return false;
			}
		}
	}
	
	/**
	 * Returns the count of subjects. If type is not provided, returns how many subjects there
	 * are in total, otherwise returns how many subjects there are of that type.
	 * 
	 * @param number $type
	 * @return number
	 */
	function countAll($type = null) {
		if(is_null($type)) {
			return $this->db->count_all('Subject');
		} else {
			$this->db->select("COUNT('subjectId') AS 'count'")
				->from('Subject')
				->where('type', $type);
			return (int)$this->db->get()->first_row('array')['count'];
		}
	}
	
	// find all groups that do not have a moderator
	function unmoderated($page = 0, $limit = 50) {
		$limit = 1 * $limit;
		$page = 1 * $page;
		$this->db->select("s.subjectId AS 'id', s.subjectName AS 'name', s.description")
			->from('Subject AS s')
			->join('ModeratorToSubject AS m', 'm.subjectId = s.subjectId AND m.moderator = 1', 'left')
			->where('m.subjectId IS NULL')
			->limit($limit, $page * $limit);
		$result = $this->db->get();
		if ($result->num_rows () > 0) {
			$groups = $result->result_array();
			return $groups;
		} else {
			return false;
		}
	}
	
	function UniqueRandomNumbersWithinRange($min, $max, $quantity) {
		$numbers = range($min, $max);
		shuffle($numbers);
		return array_slice($numbers, 0, $quantity);
	}

	// return some random global groups ( for when they aren't logged in )
	function random() {

		$randomGroups = array(525, 342, 263, 64, 473, 521, 240, 101, 78);
		$randomNumbers = $this->UniqueRandomNumbersWithinRange(0,8,8);

		// find out how many groups there are
		$query = "select count(`subjectId`) as 'total' from `Subject`";
		$query = $this->db->query($query);

		if ($query->num_rows() > 0) {

			$tmp = $query->result_array();
			$total = $tmp[0]["total"];

			if ( $total > 0 ) {

				// now pick a random few
				$groups = array();
				for ( $i = 0; $i < 8; $i++ ) {

					$query2 = "select `subjectName`,`subjectId` from `Subject` where subjectId=? LIMIT 1";
					$query2 = $this->db->query($query2, array($randomGroups[$randomNumbers[$i]]));
					if ( $query2->num_rows() > 0 ) {
			
						$tmp = $query2->result_array();
			
						$groups[] = array(
							"name" => $tmp[0]["subjectName"],
							"id" => $tmp[0]["subjectId"]
						);
					}
				}
				return $groups;
			} else {
				return false;
			}
		} else {
			return false;
		}
	}

// ##################################################################################################################


	// fetch a group feed
	function feed($data) {

		if (!isset($data["offset"]) || !filter_var($data["offset"],FILTER_VALIDATE_INT)) {
			$data["offset"] = 0;
		}
		if (!isset($data['limit'])) {
			$data['limit'] = self::NUMPOSTS_PERPAGE;
		}
		
		if (!isset($data['type'])) {
			return ['nodes' => false];
		}
		
		if(!isset($data["hash"])) {
			$data["hash"] = 0;
		}

		// $data["group"] = id of active group
		// $data["type"] = which column (to know whether to do ads)

		$userId = $this->user->authCheck();
		if (!is_numeric($data["group"]) ) {
			$data["group"] = $this->makeSubjectId($data["group"],$userId);
		}		
		$feed = array();

		if ($data["group"] == -1){
			$feed["nodes"] = false;
			return $feed;
		}

		// Check access permissions for private forums
		if (!$this->getUserAccess($data["group"], $userId)){
			$feed["nodes"] = false;
			return $feed;
		}

		// for the social feed
		if ($data["type"] == "social" ) {
			// fetch the social feed
			$feed["nodes"] = $this->feedSocial($data["group"], $data['offset'], $data['limit'], $userId);

		} else if ($data["type"] == "comment"){

			// adjust approach if comments requested from device
			if (isset($data['getNodeInfo']) && $data['getNodeInfo']) {

				$feed = $this->feedComments($data["group"], $userId, $data["fileName"], $data["commentedPostId"], $data["offset"], true, $data['limit']);

			} else {

				list($feed["nodes"],$feed["page"]) = $this->feedComments($data["group"], $userId, $data["fileName"], $data["commentedPostId"], $data["offset"], false, 0);

			}

		// for the main feed
		} else {

			// if we're after 'current topics':
			if ( $data["type"] == 'currentTopics' ) {

				$feed["nodes"] = $this->feedCurrentTopics($data["group"], $data["CTtype"], $userId, false, '', isset($data['CTsearch']) ? $data['CTsearch'] : false, $data['limit'], $data['offset']);

			// if we're after 'questions & posts'
			} else {

				list($feed["nodes"],$feed["page"]) = $this->feedQuestionsPosts($data["group"], $data['limit'], $data["offset"], $data["postName"], $data["hash"], $userId, $data["excludeCats"]);

			}
		}
		
		$this->db->select("t.value AS 'theme'", FALSE)
			->select("IF(`u`.`opacity` IS NULL, `s`.`opacity`, `u`.`opacity`) AS 'opacity'", FALSE)
			->from('Subject AS s')
			->join('UserToSubject AS u', 'u.subjectId = s.subjectId AND u.active = 1 AND u.userId '.($userId ? '= ' . $userId : 'IS NULL'), 'LEFT')
			->join('ThemeColourOptions AS t', 't.id = IF(u.themeColourOptionId IS NULL, s.themeColourOptionId, u.themeColourOptionId)', 'INNER', FALSE)
			->where('s.subjectId', $data['group']);
		$subjectThemeResults = $this->db->get();
		if($subjectThemeResults->num_rows() === 0) {
			$feed['opacity'] = self::DEFAULT_OPACITY;
			$feed['theme'] = $this->getDefaultThemeColourOption()['value'];
		} else {
			$feed['opacity'] = $subjectThemeResults->result_array()[0]['opacity'];
			$feed['theme'] = $subjectThemeResults->result_array()[0]['theme'];
		}
		return $feed;
	}


	function feedSample($groupId) {

		// start a nice shiny array
		$nodes = array();

		for ( $i = 0, $ilen = mt_rand(1, 5); $i < $ilen; $i++ ) {

			$nodes[] = array(
				"id" => "sample".mt_rand(11111111,99999999),
				"type" => "post"
			);

			// show an ad every 3 threads
			if ( fmod($i+1, 3) == 0 ) {

				// fetch an ad here
				// $nodes[] = $this->ad->fetch();
				$nodes[] = array(
					"type" => "ad"
				);

				// add some needed properties
				$nodes[count($nodes)-1]["depth"] = 0;

			}

		}

		return $nodes;

	}


	// builds a social feed tailored for the current user & group
		// lists all posts / questions as threads
		// < 7 days since creation / last reply
	
	function feedSocial($groupId, $offset = 0, $limit = self::NUMPOSTS_PERPAGE, $userId, $getNodeInfo=false) {
		if ($userId !== false ) {
			// mn mn adjust this query to reflect storage of social feeds.  Include headNodeId
			$this->db->select("
					p.subjectId,
					n.parentNodeId AS 'parent',
					p.postId AS 'id',
					n.nodeId,
					n.nodeId AS 'headNodeId',
					n.nodeId AS 'zeroNode',
					p.numViews,
					p.postType AS type,
					t.value AS theme,
					cat.name AS catName,
					cat.level as catLevel,
					UserPerms.agevisible")
				->select("IF(`us`.`opacity` IS NULL, `s`.`opacity`, `us`.`opacity`) AS 'opacity'", FALSE)
				->select("TIMESTAMPDIFF(SECOND, `n`.`datetime`,NOW()) as 'age'")
				->from('Post AS p')
				->join('Nodes AS n', 'n.postId = p.postId')
				->join('Subject AS s', 's.subjectId = p.subjectId')
				->join('Category AS cat', 'cat.categoryId = p.categoryId', 'LEFT')
				->join('UserToSubject AS us', 'us.subjectId = s.subjectId AND us.userId = '.$userId, 'LEFT')
				->join('ThemeColourOptions AS t', 't.id = IF(us.themeColourOptionId IS NULL, s.themeColourOptionId, us.themeColourOptionId)', 'INNER', FALSE)
				->join('Permissions AS UserPerms', 'p.userId = UserPerms.userId', 'LEFT')
				->where('p.postType !=', 'post_ad')
				->where('p.postType !=', 'message')
				->where('p.postType !=', 'subscription_msg')
				->where('p.postType !=', 'comment')
				->where('(n.draftNode = FALSE OR n.draftNodeVisible = TRUE)')	//don't show drafts in social feed
				->where([
					'p.visible' => 1,
					'n.visible' => 1,
					'n.active' => 1,
					'us.active' => 1,
					'p.modDeleted' => 0
				])
				->where("FIND_IN_SET(`p`.`CategoryId`, IF(`us`.`catFilterList` IS NULL, '', `us`.`catFilterList`)) = 0",null,false)	
				->order_by('age', 'ASC')
				->limit($limit, $offset);
			if ($groupId != '1'){
				$this->db->where('n.userId IN (SELECT socialId FROM UserToSocial WHERE userId = '.$userId.' AND subjectId = '.$groupId.' AND displayed = 1)')
					->where('(p.subjectId = '.$groupId.' OR p.subjectId IN (SELECT subjectId FROM subjectGroups WHERE userID = '.$userId.' AND groupWith = '.$groupId.' AND subjectId != '.$groupId.'))');
			} else {
				$this->db->where('n.userId IN (SELECT socialId FROM UserToSocial AS u WHERE u.userID = '.$userId.' AND u.subjectId = p.subjectId AND u.displayed = 1)');
			}
		
			$query = $this->db->get();

			if ($query->num_rows() > 0 ) {

				$threads = $query->result_array();
		
				// added cjt - if this method is called via a device:
				// - add node data array
				// - add "statuses" info, eg. "am i following this user in this thread?" for icon display
				if($getNodeInfo) {

					//added cjt 141217
					$utz = $this->user->getUserTimezone($userId);
					
					$i=0;
					foreach ($threads as $key => $row) {

						$threads[$i]['replies'] = (in_array($row['type'], $this->post->workareaTypes)) ? $this->post->getCommentCount($row['id']) : $this->post->getReplyCount($row['id']);
	
						$threads[$i]["info"] = $this->node->info($threads[$i]['nodeId']);
						// is user a super user
						$threads[$i]["info"]["isMod"] = $this->user->canManageSubject($threads[$i]["info"]["userId"], $threads[$i]["subjectId"]);
						// passes userId of owner and subjectId - gets an array
						$threads[$i]["statuses"] = $this->node->iconStatuses($threads[$i]["info"]["userId"], $threads[$i]["subjectId"], $threads[$i]['nodeId'], $threads[$i]['id']);

						// if it's an event and the user has a timezone set...
						//...flag if the user's timezone is different to that of the event and convert it to the time in their timezone
						$threads[$i]["info"]["userStartTime"] = null;
						$threads[$i]["info"]["userEndTime"] = null;

						if($threads[$i]['type']==='event'&&!empty($utz)) {

							if($utz!==$threads[$i]["info"]["postTimezone"]) {

								$this->load->model("Geo");
								$threads[$i]["info"]["userStartTime"] = $this->Geo->convertFromUtc($threads[$i]["info"]["startTime"], $utz)->format('Y-m-d H:i:s');
								$threads[$i]["info"]["userEndTime"] = $this->Geo->convertFromUtc($threads[$i]["info"]["endTime"], $utz)->format('Y-m-d H:i:s');

							}

						}

						$i++;
					}
				} else {
					for ($i = 0; $i < count($threads); $i++) {
						//$threads[$i]['post'] = $this->post($threads[$i]['id'], $threads[$i]['nodeId'], $userId, 0, 0, 'social', 'scrollNode');

						$post = $this->post($threads[$i]['id'], $threads[$i]['nodeId'], $userId, 0, 0, 'social', 'scrollNode');
						
						// event timezones
						$post["localStartTime"] = null;
						$post["localEndTime"] = null;
						if ($post["type"] === 'event' && !empty($post["timezone"])) {///!!!jbevent
							$this->load->model("Geo");
							$saveStartTime = $post["startTime"];
							$saveEndTime = $post["endTime"];
							$post["startTime"] = $this->Geo->convertFromUTC($post["startTime"], $post["timezone"])->format('Y-m-d H:i:s');
							$post["endTime"] = $this->Geo->convertFromUTC($post["endTime"], $post["timezone"])->format('Y-m-d H:i:s');

							if (!empty($post["userTimezone"])) {
								$post["localStartTime"] = $this->Geo->convertFromUTC($saveStartTime, $post["userTimezone"])->format('Y-m-d H:i:s');
								$post["localEndTime"] = $this->Geo->convertFromUTC($saveEndTime, $post["userTimezone"])->format('Y-m-d H:i:s');
							}
						}

						$threads[$i]['post'] = $post;
					}
				}
				return $threads;
			} else {
				return false;
			}
			return false;
		} else {
			return "auth failed";
		}
	}

	// returns a feed for a group of current topics
	// (questions and posts that have been migrated due to reply amount / popularity)
		// top 2 questions/posts by reply count
		// questions with at least 1 reply (used to be > 6)
		// // mn turned off posts with >= 20 replies
		// // mn turn on later: created/replied to < 7 days
	function feedCurrentTopics($groupId, $type, $userId, $getNodeInfo=false, $filter=false, $ctsearch=false, $limit=self::NUMPOSTS_PERPAGE, $offset=0) {
		// get all nodes of post/question type that are direct children of the supplied group
		
		// get forum type
		$forumType = $this->getType($groupId);
		if ($forumType === '') {
			$forumType = self::TYPE_GENERAL;
		}
		
		$forumName = $this->getName($groupId);
		
		// Get search choice here for Main Feed, as main db query is built piece by piece,
		// and the db query used in getSearchChoice breaks it if called while main query is being built
		if ((int)$forumType === self::TYPE_RAMBLUR && $forumName === 'main feed') {
			$searchChoice = $this->user->getSearchChoice();
		}

		$this->db->select("
				p.postId AS 'id',
				p.postType AS 'type',
				s.subjectId,
				p.score,
				p.numViews,
				cat.name AS catName,
				cat.level as catLevel,
				p.timeStamp")
			->select("IF(`us`.`opacity` IS NULL, `s`.`opacity`, `us`.`opacity`) AS 'opacity'", FALSE)
			->select("TIMESTAMPDIFF(SECOND, `p`.`timeStamp`,NOW()) as 'age'", FALSE)
			->select("ANY_VALUE(`t`.`value`) AS 'theme'")
			->select("ANY_VALUE(`n`.`nodeId`) AS 'nodeId'")
			->select("COUNT(`r`.`nodeId`) AS 'replies'", FALSE) // Count the number of replies for each post
			->from('Post AS p')
			->join('Nodes as n', 'n.postId = p.postId')
			->join('Nodes AS r', 'r.postId = p.postId')
			->join('Subject AS s', 's.subjectId = p.subjectId')
			->join('Category AS cat', 'cat.categoryId = p.categoryId', 'LEFT')
			->join('UserToSubject AS us', 'us.subjectId = s.subjectId AND us.userId = '.($userId ? $userId : '0'), 'LEFT')
			->join('ThemeColourOptions AS t', 't.id = IF(us.themeColourOptionId IS NULL, s.themeColourOptionId, us.themeColourOptionId)', 'INNER', FALSE)
			->where('(n.draftNode = FALSE OR n.draftNodeVisible = TRUE)')	//don't show drafts in current topics feed
			->where('(r.draftNode = FALSE OR r.draftNodeVisible = TRUE)')	//don't include drafts in reply count
			->where("(p.postType='post' OR p.postType='question')") //articles etc don't have replies at present!!
			->where([
				'p.visible' => 1,
				'p.modDeleted' => 0,
				//'p.postType' => 'question',
				'n.parentNodeId' => 0,
				'n.active' => 1,
				'r.parentNodeId !=' => 0//,
				//'p.lastInput >' => date('Y-m-d', strtotime("-1000 days")) // meets the recent requirement
			])
			->where("FIND_IN_SET(`p`.`CategoryId`, IF(`us`.`catFilterList` IS NULL, '', `us`.`catFilterList`)) = 0",null,false)
			->group_by('p.postId')
			->having('replies >= 1') // limits the result to those with at least the required number of replies
			->limit($limit, $offset);
		
		//AND FIND_IN_SET(p.CategoryId, IF(us.catFilterList IS NULL, '', us.catFilterList)) = 0) 
		
		
		// top 500 general or club18
		if($groupId == '624' || $groupId == '596') {


		// top 500 schools
		} else if($groupId == '655') {


		// main feed
		} else if ((int)$forumType === self::TYPE_RAMBLUR && $forumName === 'main feed') {
			$this->db->where([
				's.private' => 0,
				's.visible' => 1
			]);
			
			$typeWhere = '(s.type = ' . self::TYPE_RAMBLUR;
			if ($searchChoice) {
				if ($searchChoice['related']) {
					$typeWhere .= " OR s.type = " . self::TYPE_RELATED;
				}
				if ($searchChoice['business']) {
					$typeWhere .= " OR s.type = " . self::TYPE_BUSINESS;
				}
				if ($searchChoice['general']) {
					$typeWhere .= " OR s.type = " . self::TYPE_GENERAL;
				}
				if (isset($searchChoice['club18']) && $searchChoice['club18']) {
					$typeWhere .= " OR s.type = " . self::TYPE_CLUB18;
				}
			}
			$typeWhere .= ')';
			$this->db->where($typeWhere);
			
		// my feed
		} else if($groupId == '1') {
			$this->db->where('(p.subjectId IN (SELECT subjectId FROM UserToSubject WHERE userId = '.$this->db->escape($userId).') || p.subjectId IN (SELECT subjectId FROM subjectGroups WHERE userId = '.$this->db->escape($userId).'))');

		// all other forums
		} else {
			$this->db->where("(p.subjectId = ANY (SELECT subjectId FROM subjectGroups WHERE userId = ".$this->db->escape($userId)." AND groupWith = ".$this->db->escape($groupId)." AND subjectId !=".$this->db->escape($groupId).") || p.subjectId = ".$this->db->escape($groupId).")");
			if ($filter) {
				$this->db->where('p.categoryId', intval($filter));
			}
		}

		// current topics search
		if($ctsearch!==false) {

			$stopWords = array("and", "or", "the", "an", "if");
			$userWords = explode(',', mb_strtolower(str_replace(array('[', ']', '"'), '', $ctsearch)));
			// remove stopWords from userWords, to produce srchWords
			$srchWords = array_diff($userWords, $stopWords);
			// reformat the array of words passed to suit REGEXP
			$srchWords = implode("|",$srchWords);

			$this->db->where('(p.title REGEXP '.$this->db->escape($srchWords).' || n.text REGEXP '.$this->db->escape($srchWords).')');
			// order by timestamp desc - latest first?  ultimately advanced search will allow better sorting/searching..
			$this->db->order_by('p.timeStamp', 'DESC');
			

		} else {
			if ($type == "mostVoted") {
				$this->db->order_by('p.score', 'DESC');
			} else {
				$this->db->order_by('p.timeStamp', 'DESC');
			}
		}

		$query = $this->db->get();

		// if there were any results
		if ($query->num_rows() > 0) {

			$threads = $query->result_array();

			$i = 1;
			while ($i <= count($threads)) {
				
				$thread = $threads[$i-1];

				// add some needed bits that are missing
				$thread["depth"] = 0;

				// added cjt - if this method is called via a device:
				// - add node data array
				// - add "statuses" info, eg. "am i following this user in this thread?" for icon display
				// - get the first 6 replies
				if($getNodeInfo) { //mobile

					$nodeInfo = $this->node->info($thread['nodeId']);
					// is user a super user
					$nodeInfo["isMod"] = $this->user->canManageSubject($nodeInfo["userId"], $thread["subjectId"]);
					// passes userId of owner and subjectId - gets an array
					$threads[$i-1]["statuses"] = $this->node->iconStatuses($nodeInfo["userId"], $thread["subjectId"], $thread['nodeId'], $thread['id']);
					$threads[$i-1]["replydata"] = $this->post->getReplies($thread['id'], $thread['nodeId'], $userId, 6); // postId & limit (optional)
					$threads[$i - 1]["info"] = $nodeInfo;
					
					/*
					 * only return first 150 chars for current topics
					 * 
					 */
					if(mb_strlen($threads[$i-1]["info"]["body"])>150) {
						$threads[$i-1]["info"]["body"] = mb_substr($threads[$i-1]["info"]["body"], 0, 150).'...';
					}
					
					/*
					 * Temporarily do not return attachments for current topics.
					 * Will need them later on when a thumbnail is used possibly, so leaving post() process them
					 * for now
					 * 
					 */
					$threads[$i-1]['info']["attachments"] = null; //for mobile
					
				} else {
					$threads[$i - 1]['post'] = $this->post($thread['id'], $thread['nodeId'], $userId, 0, 0, 'currentTopics', 'scrollNode');
					/*
					 * Temporarily do not return attachments for current topics.
					 * Will need them later on when a thumbnail is used possibly, so leaving post() process them
					 * for now
					 */
					$threads[$i - 1]['post']["attachments"] = null;

					/* only return first 150 chars for current topics */
					if (mb_strlen($threads[$i - 1]['post']["body"]) > 150) {
						$threads[$i - 1]['post']["body"] = mb_substr($threads[$i - 1]['post']["body"], 0, 150) . '...';
					}
				}

				$i++;

				// show an ad every 4th spot
				
				/* no ads for current topics at the mo
				 * 
				 * 
				if (fmod($i, 4) == 0) {
				
					$adData = array();
					$adData['groupId'] = $groupId;

					$adv = $this->ad->fetchAd($adData);

					if(!empty($adv)) { // there are no ads to show for this subject

						array_splice($threads, $i-1, 0, array(array(
							"type" => "ad",
							"depth" => "0",
							"id" => $adv[0]["adId"],
							"style" => $adv[0]["style"],
							"url" => $adv[0]["url"],
							"media" => $adv[0]["fileName"],
							"devicefile" => $adv[0]["deviceFileName"],
							"title" => $adv[0]["headerText"],
							"copy" => $adv[0]["footerText"]
						)));

					} else {
						array_splice($threads, $i-1, 0, array(array(
							"type" => "ad",
							"depth" => "0",
							"id" => null,
							"style" => null,
							"url" => null,
							"media" => null
						)));

					}
					// move on again
					$i++;
				}
				 * 
				 */
				 
			}
			return $threads;
		} else {
			return false;
		}
	}

	function cmp1($a,$b){

		if((int)$a['age'] == (int)$b['age']){
			return 0;
		}
		return ((int)$a['age'] < (int)$b['age']) ? -1 : 1;
	}

	// returns a feed for a group of comments relating to one photo or video (or workarea posts)
	function feedComments($groupId,$userId,$fileName,$commentedPostId,$offset,$getNodeInfo,$limit) {

		$paginated=false;
		// limit2:
		// always 20 for desktop
		// also for device, unless offset > 0, then it gets changed! - cjt
		$limit2 = 20;

		// some conditions required by devices
		if($getNodeInfo&&$offset!==0) {

			$limit2 = $offset;
			$limit = 0;

		}

		if( !empty($fileName) && $fileName != 'null'){

			$where = 'p.fileName = ?';
			$params = [$fileName];

		} else {

			//$where = "p.commentedPostId = ? AND (p.fileName IS NULL OR p.fileName='null')";
			$where = "p.commentedPostId = ? AND (p.fileName IS NULL OR p.fileName='null' OR p.fileName = '')";
			$params = [$commentedPostId];

		}

		$query = "
			SELECT 
			p.postId AS 'id',
			p.postType AS 'type',
			p.subjectId,
			TIMESTAMPDIFF(SECOND, `p`.`timeStamp`,NOW()) as 'age',
			t.value AS 'theme',
			IF (u.subjectId IS NULL, s.opacity, u.opacity) AS 'opacity'
			FROM Post AS p
			JOIN Subject AS s ON s.subjectId = p.subjectId
			LEFT JOIN UserToSubject AS u ON u.subjectId = s.subjectId AND u.userId = $userId
			JOIN ThemeColourOptions AS t ON t.id = IF(u.subjectId IS NULL, s.themeColourOptionId, u.themeColourOptionId) 
			WHERE ".$where."
			ORDER BY age DESC
			LIMIT ".$limit.",".$limit2."
		";

		$query = $this->db->query($query, $params);

		// if there were any results
		if ($query->num_rows() > 0) {

			$threads = array();

			// go through each one
			foreach ($query->result_array() as $thread) {

				// is this even needed??? comments & their replies don't ever display a count?? - cjt
				$query2="SELECT COUNT(nodeId) as 'count' FROM Nodes WHERE postId = ?";
				$params=array($thread['id']);
				$query2 = $this->db->query($query2, $params);
				$result2 = $query2->row();
				$thread['replies'] = $result2->count;

				$query2="SELECT nodeId FROM Nodes WHERE postId = ? and parentNodeId = 0;";
				$params=array($thread['id']);
				$query2 = $this->db->query($query2, $params);
				$result2 = $query2->row();

				if ( $query2->num_rows() > 0 ) {

					$thread['nodeId'] = $result2->nodeId; 

					// device = get the info up front
					if($getNodeInfo) {

						$thread["info"] = $this->node->info($thread['nodeId']);
						// is user a super user
						$thread["info"]["isMod"] = $this->user->canManageSubject($thread["info"]["userId"], $thread["subjectId"]);
						// passes userId of owner and subjectId - gets an array

						if($userId) {

							$thread["statuses"] = $this->node->iconStatuses($thread["info"]["userId"], $thread["subjectId"], $thread['nodeId'], $thread['id']);
							// Not subscribed user won't be able to access comments so this isn't required - cjt 280717
							//$thread["isSubd"] = $this->user->isForumSubscribed($thread["subjectId"]);

						}

						//$thread["replydata"] = $this->post->getReplies($thread['id'], $thread['nodeId'], $userId, 6); // postId & limit (optional)...5 or 6????

						// a post with comments returns them 20 at a time
						// the comment displays how many replies there are, and then loads them progressively too
						// here, we get the count only so that the user can see
						$thread["replycount"] = $this->post->getCommentReplyCount($thread['id']);

					} else {
						$thread['post'] = $this->post($thread['id'],  $thread['nodeId'], $userId, 0, 0, 'comment', 'scrollNode');
					}

				}
				
				// store it
				$threads[] = $thread;

			}

			// return different depending on if from desktop or device
			// device
			if($getNodeInfo) {

				//$threads = array(); // added to test empty array - no comments
				return array($threads);

			// desktop
			} else {

				if(count($threads) == 20){

					$paginated = true;
					$threads = array_slice($threads, $offset, 19); // 19? or 20?

				}

				return array($threads,$paginated);

			}


		}
		return array(false,false);

	}
	
	
	// returns a feed for a group of questions & posts

	function feedQuestionsPosts($groupId,$limit = self::NUMPOSTS_PERPAGE,$offset = 0,$postName,$hash,$userId,$excludeCats) {
	
		$userInfo = $this->ad->getUserDetailsObj($userId);

