						AND s.private = FALSE
						AND s.visible = TRUE
						AND p.modDeleted = 0
						AND (p.postType='post' OR p.postType = 'post_ad' OR p.postType='question' OR p.postType='article' OR p.postType = 'blog' OR p.postType = 'review' OR p.postType = 'event' OR p.postType = 'vlog')
						AND ((p.draftPost = FALSE OR p.draftPostVisible = TRUE) OR (p.draftPost = TRUE AND (p.userId IN (select draftUserId from draftUserMapping where userId = ?)) OR p.userId = ?))
						ORDER BY p.score DESC
						LIMIT 500
					) as s1 ON p.postId = s1.postId
					JOIN Subject AS s ON s.subjectId = p.subjectId 
					LEFT JOIN UserToSubject AS us ON us.subjectId = s.subjectId AND us.userId = ?
					ORDER BY age DESC
					LIMIT $offset, $limit";

				$date = date('Y-m-d', strtotime("-1000 days"));

				// @todo - need to store users timezone so the post ads can be displayed
				// at the correct time for the user's country
				//
				$params = array($date, $userId, $userId, $userId);
				*/
			
			
			// main feed
			if ((int)$thisType === self::TYPE_RAMBLUR && $this->getName($groupId) === 'main feed') {
				
				//change this to not call api at all if main feed!!!!
