							OR (p.userId IN (SELECT userId FROM userPostBlackList WHERE landingPage = TRUE))
							)
					) as s1 ON p.postId = s1.postId
					JOIN Subject AS s ON s.subjectId = p.subjectId 
					LEFT JOIN UserToSubject AS us ON us.subjectId = s.subjectId AND us.userId = ?
					JOIN ThemeColourOptions AS t ON t.id = IF(us.themeColourOptionId IS NULL, s.themeColourOptionId, us.themeColourOptionId)
					ORDER BY age ASC LIMIT $offset, $limit";
				
				$date = date('Y-m-d', strtotime("-1000 days"));
				$params = array($date, $userId);
				
			} else if($groupId != '1'){
				
				$query = "
					SELECT
						p.postId AS 'id',
						p.postType AS 'type',
						s.subjectId,
						categoryId,
						TIMESTAMPDIFF(SECOND, `p`.`timeStamp`,NOW()) as 'age',
						t.value AS 'theme', 
						IF(us.opacity IS NULL, s.opacity, us.opacity) AS 'opacity'
					FROM Post AS p
					JOIN Subject AS s ON s.subjectId = p.subjectId 
					LEFT JOIN UserToSubject AS us ON us.subjectId = s.subjectId AND us.userId = ?
					JOIN ThemeColourOptions AS t ON t.id = IF(us.themeColourOptionId IS NULL, s.themeColourOptionId, us.themeColourOptionId)
					WHERE 
					(
						p.visible = true 
						AND p.modDeleted = 0
						AND ((p.draftPost = FALSE OR p.draftPostVisible = TRUE) OR (p.draftPost = TRUE AND (p.userId IN (select draftUserId from draftUserMapping where userId = ?)) OR p.userId = ?))
						AND (((p.subjectId = ANY (select subjectId FROM subjectGroups WHERE userId=? AND groupWith = ? AND subjectId != ?) || p.subjectId = ?)
							AND (postType='post' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' OR postType = 'vlog' OR postType = 'newsPost')
							AND FIND_IN_SET(p.CategoryId, IF(us.catFilterList IS NULL, '', us.catFilterList)) = 0) 
							OR postType LIKE 'admin%'
						)
					)
					OR
					(
						postType = 'post_ad' 
						AND p.postId IN 
						(
							SELECT postId FROM post_ads WHERE booked = '1' AND now() >= displayDate AND now() < endDate
							AND parentAdId IN 
							(
								SELECT adId FROM adToForum WHERE forumId = ?
								AND forumId IN (SELECT subjectId FROM UserToSubject WHERE userId = ?) 
								AND parentAdId IN (SELECT adId FROM adToCountry WHERE country = ? OR country = 'None')
								AND parentAdId IN (SELECT adId FROM adToState WHERE state = ? OR state = 'None')
								AND parentAdId IN (SELECT adId FROM adToPostCode WHERE postcode = ? OR postcode = 'None')
								AND parentAdId IN (SELECT adId FROM adToGender WHERE substr(gender,1,1) = ? OR gender = 'Both')
								AND parentAdId IN (SELECT adId FROM adToAgeGroup WHERE adToAgeGroup.agegroup IN 
									(SELECT agegroup FROM agegroup_mapping WHERE agegroup = 'All' OR agegroup LIKE ?))
							)
						)
					)
					ORDER BY p.pinned DESC, p.timeStamp DESC LIMIT $offset, $limit";

				// Post ads go to all forums and places that the parent ad goes to
				// Checks are made to UserToSubject to prevent post ads being displayed to non logged-in users.

				if (!empty($userId)) { //may not be logged in and viewing read-only moded
					$params = array(
						$userId,
						$userId,
						$userId,
						$userId,
						$groupId,
						$groupId,
						$groupId,
						$groupId,
						$userId,
						$userInfo->countryId,
						$userInfo->stateId,
						$userInfo->postcode,
						$userInfo->gender,
						"%$userInfo->age%"
					);
				} else {

					$params = array(
						$userId,
						$userId,
						$userId,
						$userId,
						$groupId,
						$groupId,
						$groupId,
						$groupId,
						$userId,
						null,
						null,
						null,
						null,
						null
					);

				}

			}else{
				
			  $query = "
				SELECT
					postId AS 'id',
					postType AS 'type',
					s.subjectId,
					TIMESTAMPDIFF(SECOND, `p`.`timeStamp`,NOW()) as 'age',
					t.value AS 'theme', 
					IF(us.opacity IS NULL, s.opacity, us.opacity) AS 'opacity'
				FROM Post AS p
				JOIN Subject AS s ON s.subjectId = p.subjectId 
				LEFT JOIN UserToSubject AS us ON us.subjectId = s.subjectId AND us.userId = ?
				JOIN ThemeColourOptions AS t ON t.id = IF(us.themeColourOptionId IS NULL, s.themeColourOptionId, us.themeColourOptionId)
				WHERE 
				(
					p.visible = true
					AND p.modDeleted = 0
					AND ((p.draftPost = FALSE OR p.draftPostVisible = TRUE) OR (p.draftPost = TRUE AND (p.userId IN (select draftUserId from draftUserMapping where userId = ?)) OR p.userId = ?))
					AND
					(((p.subjectId IN 
						(
						SELECT Subject.subjectId FROM UserToSubject 
						JOIN Subject ON UserToSubject.subjectId = Subject.subjectId WHERE userId = ?
						AND FIND_IN_SET(p.CategoryId, IF(us.catFilterList IS NULL, '', us.catFilterList)) = 0
						AND active = true AND displayed = true AND (private = false OR privateAccess = true)
						) 
						|| p.subjectId IN
						(
						SELECT subjectGroups.subjectId FROM subjectGroups JOIN UserToSubject ON subjectGroups.subjectId = UserToSubject.subjectId 
						AND subjectGroups.userId = ? JOIN Subject ON UserToSubject.subjectId = Subject.subjectId 
						WHERE subjectGroups.displayed = true
						AND FIND_IN_SET(p.CategoryId,IF(us.catFilterList IS NULL, '', us.catFilterList)) = 0
						AND inFeed=true AND UserToSubject.userId = ? AND (private = false or privateAccess = true)
						)
					 ) 
					 AND (postType='post' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' 
					 
					 OR postType = 'vlog' OR postType = 'newsPost'))
					 OR postType LIKE 'admin%'
					) 
				)
				OR
				(
					postType = 'post_ad' 
					AND postId IN 
					(
						SELECT postId FROM post_ads WHERE booked = '1' AND now() >= displayDate AND now() < endDate
						AND parentAdId IN 
						(
							SELECT adId FROM adToForum WHERE forumId = ?
							AND forumId IN (SELECT subjectId FROM UserToSubject WHERE userId = ?) 
							AND parentAdId IN (SELECT adId FROM adToCountry WHERE country = ? OR country = 'None')
							AND parentAdId IN (SELECT adId FROM adToState WHERE state = ? OR state = 'None')
							AND parentAdId IN (SELECT adId FROM adToPostCode WHERE postcode = ? OR postcode = 'None')
							AND parentAdId IN (SELECT adId FROM adToGender WHERE substr(gender,1,1) = ? OR gender = 'Both')
							AND parentAdId IN (SELECT adId FROM adToAgeGroup WHERE adToAgeGroup.agegroup IN 
							(SELECT agegroup FROM agegroup_mapping WHERE agegroup = 'All' OR agegroup LIKE ?))
						)
					)
				)
				ORDER BY timeStamp DESC LIMIT $offset, $limit";

				$params = array(
					$userId,
					$userId,
					$userId,
					$userId,
					$userId,
					$userId,
					$groupId,
					$userId,
					$userInfo->countryId,
					$userInfo->stateId,
					$userInfo->postcode,
					$userInfo->gender,
					"%$userInfo->age%"
				);
			}
		}else{
			
			// Make sure user has access to requested post
			if (!$this->getUserAccess($groupId, $userId)) {
				return false;
			}
			$query = "
				SELECT
					p.postId AS 'id',
					p.postType AS 'type',
					p.subjectId,
					t.value AS 'theme', 
					IF(us.opacity IS NULL, s.opacity, us.opacity) AS 'opacity'
				FROM Post AS p
				JOIN Subject AS s ON p.subjectId = s.subjectId
				LEFT JOIN UserToSubject AS us ON us.subjectId = s.subjectId AND us.userId = ?
				JOIN ThemeColourOptions AS t ON t.id = IF(us.themeColourOptionId IS NULL, s.themeColourOptionId, us.themeColourOptionId)
				WHERE p.visible = true
				AND p.modDeleted = 0
				AND ((p.draftPost = FALSE OR p.draftPostVisible = TRUE) OR (p.draftPost = TRUE AND (p.userId IN (select draftUserId from draftUserMapping where userId = ?)) OR p.userId = ?))
				AND (p.postType='post' OR p.postType='post_ad' OR p.postType='question' OR p.postType='article' OR p.postType = 'blog' OR p.postType = 'review' OR p.postType = 'event' OR p.postType = 'vlog' OR p.postType = 'newsPost')
				AND p.postId = ?
				AND p.subjectId = ?;";
			$myPID = explode('-',$postName);
			
			$params = array($userId, $userId, $userId, $myPID[count($myPID)-1], $groupId);

		}

		$query = $this->db->query($query, $params);
		
		// if there were any results
		if ( $query->num_rows() > 0 ) {
			$threads = array();

			// go through each one
			foreach ( $query->result_array() as $row ) {

				// store it
				$threads[] = $row;

				$query2="SELECT COUNT(nodeId) as 'count' FROM Nodes WHERE postId = ?";
				$params=array($row['id']);
				$query2 = $this->db->query($query2, $params);
				$result2 = $query2->row();
				$threads[count($threads)-1]['replies'] = $result2->count; 

				$query2="SELECT nodeId FROM Nodes WHERE postId = ? and parentNodeId = 0;";
				$params=array($row['id']);
				$query2 = $this->db->query($query2, $params);
				$result2 = $query2->row();
				if ( $query2->num_rows() > 0 ) {
					$threads[count($threads)-1]['nodeId'] = $result2->nodeId; 
					
					
					
				}
				
				//$threads[count($threads)-1]['post'] = $this->post($row['id'], $result2->nodeId, $userId, 0, 0, 'post', 'scrollNode');
				$post =  $this->post($row['id'], $result2->nodeId, $userId, 0, 0, 'post', 'scrollNode');
                
				// event timezones
				$post["localStartTime"] = null;
				$post["localEndTime"] = null;
				if (!empty($post["type"]) && $post["type"] === 'event' && !empty($post["timezone"])) {///!!!jbevent
					$this->load->model("Geo");
					$saveStartTime = $post["startTime"];
					$saveEndTime = $post["endTime"];
					$post["startTime"] = $this->Geo->convertFromUTC($post["startTime"], $post["timezone"])->format('Y-m-d H:i:s');
					$post["endTime"] = $this->Geo->convertFromUTC($post["endTime"], $post["timezone"])->format('Y-m-d H:i:s');

					if (!empty($post["userTimezone"])) {
						$post["localStartTime"] = $this->Geo->convertFromUTC($saveStartTime, $post["userTimezone"])->format('Y-m-d H:i:s');
						$post["localEndTime"] = $this->Geo->convertFromUTC($saveEndTime, $post["userTimezone"])->format('Y-m-d H:i:s');
					}
				}
				$threads[count($threads) - 1]['post'] = $post;
			}

			/* 			if(count($threads)==self::NUMPOSTS_PERPAGE){
				$paginated=true;
				$threads = array_slice($threads, 0, (self::NUMPOSTS_PERPAGE));
			}

			if (isset($hash) && $hash == 1){return array($threads,$paginated);} */

			//$maxPostAge = 7 * 24 * 3600 ; // total seconds in a week.This needs to be the same value as that found in memc.php
			//$maxPostAge = 770 * 24 * 3600 ; // total seconds in a week.  Debug value
			//$minPostAge = 5 * 24 * 3600 ; // total seconds in five days. This needs to be the same value as that found in memc.php
			//$minPostAge = 360 * 24 * 3600 ; // total seconds in five days. Debug value
			//$minNewThreads = 26;  // Minimum number of threads before we start inserting old threads
			//$minNewThreads = 10;  // Minimum number of threads before we start inserting old threads, debug value
			//$minOldThreads = 28;  //Minimum number of old threads before we start inserting same into the feed
			//$minOldThreads = 2;   //Minimum number of old threads before we start inserting same into the feed, debug value
 
			// Set up an array of subjectIds
			//$subjectIds = Array();

			//$m = new Memcached();
			/*$m = new Memcache(); 261016 */

			//$m->addServer($this->config->item('memchostname'),$this->config->item('memcport'));

			/* if( !isset($postName) || $postName == ''){

				if ($groupId != '1') {
					$subjectIds[0]["subjectId"]=$groupId;
				} else {
					$query="SELECT subjectId FROM UserToSubject WHERE (userId = ? AND active = true AND displayed = true) || subjectId IN (select subjectId FROM subjectGroups WHERE userId=? AND displayed = true)";
					$params = array($userId,$userId);

					$query = $this->db->query($query, $params);

					// if there were any results
					if ( $query->num_rows() > 0 ) {
						$subjectIds = $query->result_array();
					}

				}
				$i = 1;

				while ($i < count($threads) && $threads[$i]['age'] < $minPostAge ) {
			
					$i++;

					// show an old thread every 5th and 6th spots until age of the 'new' threads actually equals age of the 'old' threads 
					//
					if ( fmod($i, 6) == 5  ) {

						$tempgroupId = $subjectIds[rand(0,count($subjectIds)-1)]["subjectId"];
						$tempmcacheCount = $m->get('count_'.$tempgroupId);

						// Dont try to splice in some old Posts if the memcached repository is unavailable or
						// if the number of new posts and/or the number of old posts do not meet minimum requirements
						if( $tempmcacheCount == false || count($threads) < $minNewThreads || $tempmcacheCount < $minOldThreads ){continue;}

						// insert two old threads

						$insert1 = $m->get( rand(0,$tempmcacheCount-1).'_'.$tempgroupId);

						if(isset($insert1) && $insert1 != false){array_splice($threads, $i-1, 0, array($insert1));}

						$i++;

						$tempgroupId = $subjectIds[rand(0,count($subjectIds)-1)]["subjectId"];
						$tempmcacheCount = $m->get('count_'.$tempgroupId);

						$insert2 = $m->get( rand(0,$tempmcacheCount-1).'_'.$tempgroupId);
						while($insert2["id"] == $insert1["id"]){$insert2 = $m->get( rand(0,$tempmcacheCount-1).'_'.$tempgroupId);}

						if(isset($insert2) && $insert2 != false){array_splice($threads, $i-1, 0, array($insert2));}

						// move on again
						$i++;
					}
				}
			} */

			$i = 1;

			while ($i <= count($threads)) {

				// if the thread is outside updated/created age limits
				// or if it has too many replies for the node type
				// CHANGE THIS WHEN IN PRODUCTION
				/*if ( 
					( round($threads[$i-1]['age'] / 60 / 60 / 24, 2) > 730 ) ||
					( ( $threads[$i-1]['type'] == 'post' ) && ( intval($threads[$i-1]['replies']) >= 80 ) ) || 
					( ( $threads[$i-1]['type'] == 'question' ) && ( intval($threads[$i-1]['replies']) >= 80 ) )
					) {*/
				if ( 
					(($threads[$i-1]['type'] == 'post' ) && (intval($threads[$i-1]['replies']) >= 800 )) || 
					(($threads[$i-1]['type'] == 'question' ) && ( intval($threads[$i-1]['replies']) >= 800))
				){

					// remove it from the array
					array_splice($threads, $i-1, 1);

				// otherwise it is valid
				} else {

					// add some needed bits that are missing
					$threads[$i-1]["depth"] = 0;

					$i++;

					// show a banner every 5th spot
					// mn set frequency of banner ad displays here
					if ( fmod($i, 6) == 0 ) {

						// insert a banner
						// mn mn "array_splice" fails gracefully if $i == 0 ??
						array_splice($threads, $i-1, 0, array(array("type" => "ad",	"depth" => "0")));

						// move on again
						$i++;
					}
				}
			}

			// send the good threads back
			return array($threads,$paginated); // paginated is deprecated due to implementation of endless scroll and should be removed
			
		} else {
			return array(false,false);
		}
	}

// ##################################################################################################################

	// TMP 2nd feedQuestionsPosts - cjt 030816
	// see loadFeed below

	function feedQuestionsPosts2($groupId, $limit = 20, $offset = 0, $getNodeInfo=false) {
		
		/* 

		NB: Changes - cjt
		added order by
		
		*/
		
		$userId = $this->user->authCheck();
		// get all nodes of post/question type that are direct children of the supplied group
		
		$userInfo = $this->ad->getUserDetailsObj($userId);

		if($groupId == '624' || $groupId == '596') { ## top 500 general || top 500 club18
			## Get the top 500 subjects
		
			$type = $this->getType($groupId);
			$date = date('Y-m-d', strtotime("-1000 days"));
			
			$query="
				SELECT
				p.postId AS 'id',
				p.postType AS 'type',
				p.subjectId,
				p.numViews,
				p.pinned,
				cat.name AS catName,
				cat.level AS catLevel
				FROM Post AS p 
				JOIN (
					SELECT 
					s.subjectId
					FROM Subject AS s
					JOIN Post AS p ON s.subjectId = p.subjectId
					WHERE p.lastInput > ? 
					AND p.modDeleted = 0
					AND s.type = ?
					AND (p.draftPost = FALSE OR p.draftPostVisible = TRUE)
					AND (postType='post' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' OR postType = 'vlog')
					GROUP BY s.subjectId 
					ORDER BY avg(p.score) DESC LIMIT 500
				) AS s1 ON s1.subjectId = p.subjectId
				LEFT JOIN Category AS cat ON cat.categoryId = p.categoryId
				WHERE (postType='post' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' OR postType = 'vlog')
				ORDER BY p.postId DESC LIMIT ?, ?";
		
			$result = $this->db->query($query, array($date, $type, $offset, $limit));
		
		} else if($groupId == '655') { ## top 500 schools
		
			$query="
				SELECT 
				p.postId AS 'id',
				p.postType AS 'type',
				p.subjectId,
				p.numViews,
				p.pinned,
				cat.name AS catName,
				cat.level AS catLevel
				FROM Post AS p
				JOIN (
					SELECT
					p.postId
					FROM Post AS p
					JOIN Subject AS s ON p.subjectId = s.subjectId
					WHERE p.lastInput > ?
					AND (p.draftPost = FALSE OR p.draftPostVisible = TRUE)
					AND s.type = ".self::TYPE_SCHOOLS."
					AND s.private = FALSE
					AND s.visible = TRUE
					AND p.modDeleted = 0
					AND (postType='post' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' OR postType = 'vlog')
					ORDER BY score DESC LIMIT 500
				) AS s1 ON p.postId = s1.postId
				LEFT JOIN Category AS cat ON cat.categoryId = p.categoryId
				ORDER BY p.postId DESC LIMIT ?, ?";
		
			$date = date('Y-m-d', strtotime("-1000 days"));
		
			/* @todo - need to store users timezone so the post ads can be displayed
			 * at the correct time for the user's country
			 */
			$result = $this->db->query($query, array($date, $offset, $limit));
		
		// HOME FEED
		// KLUDGE to get getLandingPageFeed 'working' on mobile
		} else if ($groupId === 'home') {

			$date = date('Y-m-d', strtotime("-1000 days"));

			$query = "SELECT
						p.postId AS 'id',
						p.postType AS 'type',
						p.subjectId,
						p.numViews,
						p.pinned,
						TIMESTAMPDIFF(SECOND, p.`timeStamp`,NOW()) as 'age',
						t.value AS 'theme', 
						IF(us.opacity IS NULL, s.opacity, us.opacity) AS 'opacity',
						cat.name AS catName,
						cat.level AS catLevel
						FROM Post AS p
						JOIN (
							SELECT p.postId 
							FROM Post AS p
							JOIN Subject AS s ON p.subjectId = s.subjectId 
							WHERE p.lastInput > ?
							AND (p.draftPost = FALSE OR p.draftPostVisible = TRUE)
							AND s.private = FALSE 
							AND s.visible = TRUE
							AND p.modDeleted = 0
							AND (postType='post' OR postType = 'post_ad' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' OR postType = 'vlog')
							AND ((p.postId IN (SELECT postId FROM postWhiteList WHERE landingPage = TRUE AND deleted = FALSE)) 
											OR (p.postId IN (SELECT postId FROM postWhiteListPending WHERE landingPage = TRUE AND deleted = FALSE)) 
											OR (p.subjectId IN (SELECT subjectId FROM forumWhiteList WHERE landingPage = TRUE)))
							AND p.postId NOT IN (SELECT postId FROM postBlackList WHERE landingPage = TRUE)
							AND p.subjectId NOT IN (SELECT subjectId FROM forumBlackList WHERE landingPage = TRUE)
							AND p.userId NOT IN (SELECT userId FROM userPostBlackList WHERE landingPage = TRUE)
							ORDER BY p.score DESC LIMIT 500
						) as s1 ON p.postId = s1.postId
						JOIN Subject AS s ON s.subjectId = p.subjectId 
						LEFT JOIN Category AS cat ON cat.categoryId = p.categoryId
						LEFT JOIN UserToSubject AS us ON us.subjectId = s.subjectId AND us.userId = ?
						JOIN ThemeColourOptions AS t ON t.id = IF(us.themeColourOptionId IS NULL, s.themeColourOptionId, us.themeColourOptionId)
						ORDER BY age ASC LIMIT $offset, $limit";
			
			$result = $this->db->query($query, array($date, NULL));

		// main feed
		//} else if ((int)$this->getType($groupId) === 0 && $this->getName($groupId) === 'main feed') {
		} else if ($groupId === 'main' || ($this->getName($groupId) === 'main feed' && (int)$this->getType($groupId) === self::TYPE_RAMBLUR)) {
			
			
			return false;
			# top 500 across all forums user has searchable
			/** @todo - have a separate filter for this editable in settings */
			$searchChoice = $this->user->getSearchChoice();
			$date = date('Y-m-d', strtotime("-30 days")); //was 1000
			
			
			 /* main feed query to return all posts */
			
			// ORDER BY p.postId DESC LIMIT ?, ?";  - this will not work due to draft posts!
			
			//WHERE p.lastInput > ?
			
			//ORDER BY p.score DESC LIMIT 500
			
			//$result = $this->db->query($query, array($date, $offset, $limit));
			
			$query = "SELECT
				p.postId AS 'id',
				p.postType AS 'type',
				p.subjectId,
				p.pinned,
				p.numViews,
				cat.name AS catName,
				cat.level AS catLevel
				FROM Post AS p
				JOIN (
					SELECT p.postId
					FROM Post AS p
					JOIN Subject AS s ON p.subjectId = s.subjectId
					WHERE (p.draftPost = FALSE OR p.draftPostVisible = TRUE)
					AND s.private = FALSE
					AND s.visible = TRUE
					AND p.modDeleted = 0
					AND (postType='post' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' OR postType = 'vlog')
					AND (s.type = 0";
		
			$query .= ")
				) as s1 ON p.postId = s1.postId
				LEFT JOIN Category AS cat ON cat.categoryId = p.categoryId
				ORDER BY p.pinned DESC, timeStamp DESC LIMIT ?, ?";
		
			$result = $this->db->query($query, array($offset, $limit));
		
			/* 
			 * This main feed query uses score and postid to determine 
			 * the content and position. However, using postid will not work correctly 
			 * due to draft posts! Date (timestamp) should be used.
			 * 
			$query = "SELECT
				p.postId AS 'id',
				p.postType AS 'type',
				p.subjectId,
				p.numViews
				FROM Post AS p
				JOIN (
					SELECT p.postId
					FROM Post AS p
					JOIN Subject AS s ON p.subjectId = s.subjectId
					WHERE p.lastInput > ?
					AND (p.draftPost = FALSE OR p.draftPostVisible = TRUE)
					AND s.private = FALSE
					AND s.visible = TRUE
					AND p.modDeleted = 0
					AND (postType='post' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' OR postType = 'vlog')
					AND (s.type = 0";
			// only include top 500 posts from forum types user doesn't filter out
			if ($searchChoice) {
				if ($searchChoice['related']) {
					$query .= " OR s.type = " . self::TYPE_RELATED;
				}
				if ($searchChoice['business']) {
					$query .= " OR s.type = " . self::TYPE_BUSINESS;
				}
				if ($searchChoice['general']) {
					$query .= " OR s.type = " . self::TYPE_GENERAL;
				}
				if (isset($searchChoice['club18']) && $searchChoice['club18']) {
					$query .= " OR s.type = " . self::TYPE_CLUB18;
				}
			}
		
			$query .= ")
					ORDER BY p.score DESC LIMIT 500
				) as s1 ON p.postId = s1.postId
				ORDER BY p.postId DESC LIMIT ?, ?";  - this will not work due to draft posts!
		
			$result = $this->db->query($query, array($date, $offset, $limit));
			 * 
			 * 
			 */
			
			
		// load from a specific group
		} else if($groupId != '1'){ // !==??
			
			$query = "
				SELECT
					p.postId AS 'id',
					p.postType AS 'type',
					p.numViews,
					p.pinned,
					s.subjectId,
					p.categoryId,
					cat.name AS catName,
					cat.level AS catLevel,
					TIMESTAMPDIFF(SECOND, `p`.`timeStamp`,NOW()) as 'age',
					t.value AS 'theme', 
					IF(us.opacity IS NULL, s.opacity, us.opacity) AS 'opacity'
				FROM Post AS p
				JOIN Subject AS s ON s.subjectId = p.subjectId 
				LEFT JOIN UserToSubject AS us ON us.subjectId = s.subjectId AND us.userId = ?
				LEFT JOIN Category AS cat ON cat.categoryId = p.categoryId
				JOIN ThemeColourOptions AS t ON t.id = IF(us.themeColourOptionId IS NULL, s.themeColourOptionId, us.themeColourOptionId)
				WHERE 
				(
					p.visible = true 
					AND p.modDeleted = 0
					AND ((p.draftPost = FALSE OR p.draftPostVisible = TRUE) OR (p.draftPost = TRUE AND (p.userId IN (select draftUserId from draftUserMapping where userId = ?)) OR p.userId = ?))					
					AND (((p.subjectId = ANY (select subjectId FROM subjectGroups WHERE userId=? AND groupWith = ? AND subjectId != ?) || p.subjectId = ?)
						AND (postType='post' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' OR postType = 'vlog' OR postType = 'newsPost')
						AND FIND_IN_SET(p.CategoryId, IF(us.catFilterList IS NULL, '', us.catFilterList)) = 0) 
						OR postType LIKE 'admin%'
					)
				)
				OR
				(
					postType = 'post_ad' 
					AND p.postId IN 
					(
						SELECT postId FROM post_ads WHERE booked = '1' AND now() >= displayDate AND now() < endDate
						AND parentAdId IN 
						(
							SELECT adId FROM adToForum WHERE forumId = ?
							AND forumId IN (SELECT subjectId FROM UserToSubject WHERE userId = ?) 
							AND parentAdId IN (SELECT adId FROM adToCountry WHERE country = ? OR country = 'None')
							AND parentAdId IN (SELECT adId FROM adToState WHERE state = ? OR state = 'None')
							AND parentAdId IN (SELECT adId FROM adToPostCode WHERE postcode = ? OR postcode = 'None')
							AND parentAdId IN (SELECT adId FROM adToGender WHERE substr(gender,1,1) = ? OR gender = 'Both')
							AND parentAdId IN (SELECT adId FROM adToAgeGroup WHERE adToAgeGroup.agegroup IN 
								(SELECT agegroup FROM agegroup_mapping WHERE agegroup = 'All' OR agegroup LIKE ?))
						)
					)
				)
				ORDER BY p.pinned DESC, p.timeStamp DESC LIMIT $offset, $limit";

			// Post ads go to all forums and places that the parent ad goes to
			// Checks are made to UserToSubject to prevent post ads being displayed to non logged-in users.

			if (!empty($userId)) { //may not be logged in and viewing read-only moded
				$params = array(
					$userId,
					$userId,				
					$userId,
					$userId,
					$groupId,
					$groupId,
					$groupId,
					$groupId,
					$userId,
					$userInfo->countryId,
					$userInfo->stateId,
					$userInfo->postcode,
					$userInfo->gender,
					"%$userInfo->age%"
				);
			} else {

				$params = array(
					$userId,
					$userId,				
					$userId,
					$userId,
					$groupId,
					$groupId,
					$groupId,
					$groupId,
					$userId,
					null,
					null,
					null,
					null,
					null
				);

			}			
			$result = $this->db->query($query, $params);
			
		// <strikethrough>mainFeed "Home" feed</strikethrough> "My" Feed
		} else {

			$query = "
			SELECT
				p.postId AS 'id',
				p.postType AS 'type',
				p.numViews,
				s.subjectId,
				p.pinned,
				TIMESTAMPDIFF(SECOND, `p`.`timeStamp`,NOW()) as 'age',
				t.value AS 'theme', 
				IF(us.opacity IS NULL, s.opacity, us.opacity) AS 'opacity',
				cat.name AS catName,
				cat.level AS catLevel
			FROM Post AS p
			JOIN Subject AS s ON s.subjectId = p.subjectId 
			LEFT JOIN UserToSubject AS us ON us.subjectId = s.subjectId AND us.userId = ?
			LEFT JOIN Category AS cat ON cat.categoryId = p.categoryId
			JOIN ThemeColourOptions AS t ON t.id = IF(us.themeColourOptionId IS NULL, s.themeColourOptionId, us.themeColourOptionId)
			WHERE 
			(
				p.visible = true
				AND p.modDeleted = 0
				AND (p.draftPost = FALSE OR p.draftPostVisible = TRUE) AND
				(((p.subjectId IN 
					(
					SELECT Subject.subjectId FROM UserToSubject 
					JOIN Subject ON UserToSubject.subjectId = Subject.subjectId WHERE userId = ?
					AND FIND_IN_SET(p.CategoryId, IF(us.catFilterList IS NULL, '', us.catFilterList)) = 0
					AND active = true AND displayed = true AND (private = false OR privateAccess = true)
					) 
					|| p.subjectId IN
					(
					SELECT subjectGroups.subjectId FROM subjectGroups JOIN UserToSubject ON subjectGroups.subjectId = UserToSubject.subjectId 
					AND subjectGroups.userId = ? JOIN Subject ON UserToSubject.subjectId = Subject.subjectId 
					WHERE subjectGroups.displayed = true
					AND FIND_IN_SET(p.CategoryId,IF(us.catFilterList IS NULL, '', us.catFilterList)) = 0
					AND inFeed=true AND UserToSubject.userId = ? AND (private = false or privateAccess = true)
					)
				 ) 
				 AND (postType='post' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' 
				 OR postType = 'vlog' OR postType = 'newsPost'))
				 OR postType LIKE 'admin%'
				) 
			)
			OR
			(
				postType = 'post_ad' 
				AND postId IN 
				(
					SELECT postId FROM post_ads WHERE booked = '1' AND now() >= displayDate AND now() < endDate
					AND parentAdId IN 
					(
						SELECT adId FROM adToForum WHERE forumId = ?
						AND forumId IN (SELECT subjectId FROM UserToSubject WHERE userId = ?) 
						AND parentAdId IN (SELECT adId FROM adToCountry WHERE country = ? OR country = 'None')
						AND parentAdId IN (SELECT adId FROM adToState WHERE state = ? OR state = 'None')
						AND parentAdId IN (SELECT adId FROM adToPostCode WHERE postcode = ? OR postcode = 'None')
						AND parentAdId IN (SELECT adId FROM adToGender WHERE substr(gender,1,1) = ? OR gender = 'Both')
						AND parentAdId IN (SELECT adId FROM adToAgeGroup WHERE adToAgeGroup.agegroup IN 
						(SELECT agegroup FROM agegroup_mapping WHERE agegroup = 'All' OR agegroup LIKE ?))
					)
				)
			)
			ORDER BY p.pinned DESC, timeStamp DESC LIMIT $offset, $limit";

			$params = array(
				$userId,
				$userId,
				$userId,
				$userId,
				$groupId,
				$userId,
				$userInfo->countryId,
				$userInfo->stateId,
				$userInfo->postcode,
				$userInfo->gender,
				"%$userInfo->age%"
			);

			$result = $this->db->query($query, $params);

		}

		$nr = $result->num_rows();

		$result = $result->result_array();

		if ($nr > 0) {
			
			$threads = array();

			// go through each one
			foreach ( $result as $row ) {

				// make sure it has no parents of type "post" or "question"

					// store it
					$threads[] = $row;

					// get comments as replies if workarea type (blog/article/event/vlog/review)
					$threads[count($threads)-1]['replies'] = (in_array($threads[count($threads)-1]['type'], $this->post->workareaTypes)) ? $this->post->getCommentCount($row['id']) : $this->post->getReplyCount($row['id']);

					$query2="SELECT nodeId FROM Nodes WHERE postId = ? and parentNodeId = 0;";
					$params=array($row['id']);
					$query2 = $this->db->query($query2, $params);
					$result2 = $query2->row();
					if ( $query2->num_rows() > 0 ) {
					  $threads[count($threads)-1]['nodeId'] = $result2->nodeId; 
					}

					// mn mn 20150422  sorts by time of input of a post/question 
					$query2="SELECT TIMESTAMPDIFF(SECOND, `Post`.`timeStamp`,NOW()) as 'age' FROM Post WHERE postId = ?;";
					$params=array($row['id']);
					$query2 = $this->db->query($query2, $params);
					$result2 = $query2->row();
					$threads[count($threads)-1]['age'] = $result2->age;
					

			}
//print_r($threads);
			// now sort the threads by 'age'
			foreach ($threads as $key => $row) {
				$updated[$key] = $row['age'];
			}
//print_r($threads);
			
			//why!!!!!!!!!!!!!!!!!!!!!!!!!!!?????????????????????????
			//array_multisort($updated, SORT_ASC, $threads);

//print_r($threads);

			//usort($threads,array($this, "cmp1"));
			// array_multisort is faster for large sorts
			// now go through our remaining threads
			$subjectVisibility = null; 
			$i = 1;
			while ( $i <= count($threads) ) {

				// if the thread is outside updated/created age limits
				// or if it has too many replies for the node type
				// CHANGE THIS WHEN IN PRODUCTION <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<< SEE feedQuestionsPosts above!
				/*
				 * if ( 
				 
					( round($threads[$i-1]['age'] / 60 / 60 / 24, 2) > 365 ) ||
					( ( $threads[$i-1]['type'] == 'post' ) && ( intval($threads[$i-1]['replies']) >= 80 ) ) || 
					( ( $threads[$i-1]['type'] == 'question' ) && ( intval($threads[$i-1]['replies']) >= 80 ) )
				) {
				*/
					
					if ( 
					(($threads[$i-1]['type'] == 'post' ) && (intval($threads[$i-1]['replies']) >= 800 )) || 
					(($threads[$i-1]['type'] == 'question' ) && ( intval($threads[$i-1]['replies']) >= 800))
				){
					//var_dump(round($threads[$i-1]['age'] / 60 / 60 / 24, 2) > 365);
					// remove it from the array
					array_splice($threads, $i-1, 1);

				// otherwise it is valid
				} else {

					// add some needed bits that are missing
					$threads[$i-1]["depth"] = 0;

					// added cjt - if this method is called via a phone:
					// - add node data array
					// - add "statuses" info, eg. "am i following this user in this thread?" for icon display
					// - get the first 6 replies
					if($getNodeInfo) {

						$threads[$i-1]["info"] = $this->node->info($threads[$i-1]['nodeId']);
						// if w/a type, return truncated body text if more than 100 chars
						if(in_array($threads[$i-1]["type"], $this->post->workareaTypes)&&mb_strlen($threads[$i-1]["info"]["body"])>100) {
							$threads[$i-1]["info"]["body"] = mb_substr($threads[$i-1]["info"]["body"], 0, 100).'...';
						}
						// is user a super user
						$threads[$i-1]["info"]["isMod"] = $this->user->canManageSubject($threads[$i-1]["info"]["userId"], $threads[$i-1]["subjectId"]);
						// passes userId of owner and subjectId - gets an array
						if($userId) {
							$threads[$i-1]["statuses"] = $this->node->iconStatuses($threads[$i-1]["info"]["userId"], $threads[$i-1]["subjectId"], $threads[$i-1]['nodeId'], $threads[$i-1]['id']);
						}
						// always returns even if !loggedin
						$threads[$i-1]["isSubd"] = $this->user->isForumSubscribed($threads[$i-1]["subjectId"]);
						$threads[$i-1]["replydata"] = $this->post->getReplies($threads[$i-1]['id'], $threads[$i-1]['nodeId'], $userId, 6, $groupId); // postId & limit (optional)...5 or 6????

						// if it's an event and the user has a timezone set...
						//...flag if the user's timezone is different to that of the event and convert it to the time in their timezone
						$threads[$i-1]["info"]["userStartTime"] = null;
						$threads[$i-1]["info"]["userEndTime"] = null;
						if($threads[$i-1]['type']==='event'&&!empty($userInfo)) {

							if(!empty($userInfo->timezone)&&($userInfo->timezone!==$threads[$i-1]["info"]["postTimezone"])) {

								$this->load->model("Geo");
								$threads[$i-1]["info"]["userStartTime"] = $this->Geo->convertFromUtc($threads[$i-1]["info"]["startTime"], $userInfo->timezone)->format('Y-m-d H:i:s');
								$threads[$i-1]["info"]["userEndTime"] = $this->Geo->convertFromUtc($threads[$i-1]["info"]["endTime"], $userInfo->timezone)->format('Y-m-d H:i:s');

							}

						}
						
						// add attribute info
						$threads[$i-1]['info']['subjectAttributes'] = $this->subjectAttribute->getSubjectAttributesArray($threads[$i-1]["subjectId"]);
						$threads[$i-1]['info']['subjectVisibility'] = $this->subjectAttribute->getForumVisibility($threads[$i-1]['subjectId'], $threads[$i-1]['info']['subjectPrivate']);
						//isn't this always going to be the same!!!
						$subjectVisibility = $threads[$i-1]['info']['subjectVisibility'];
					}

					$i++;

					// show a banner every 5th spot
					// mn set frequency of banner ad displays here
					if ( fmod($i, 6) == 0 ) {
					
						// insert a banner
						if($getNodeInfo && $groupId) {

							/*$adData = array();
							$adData['groupId'] = $groupId;
							//$adData['adtype'] = 'banner'; // banner hardcoded for initial mobile feed requirements...cjt

							$adv = $this->ad->fetchAd($adData);

							if(!empty($adv)) { // there are no ads to show for this subject

								array_splice($threads, $i-1, 0, array(array(
									"type" => "ad",
									"depth" => "0",
									"id" => $adv[0]["adId"],
									"style" => $adv[0]["style"],
									"url" => $adv[0]["url"],
									"media" => $adv[0]["fileName"],
									"devicefile" => $adv[0]["deviceFileName"],
									"title" => $adv[0]["headerText"],
									"copy" => $adv[0]["footerText"]
								)));

							} else {

								array_splice($threads, $i-1, 0, array(array(
									"type" => "ad",
									"depth" => "0",
									"id" => null,
									"style" => null,
									"url" => null,
									"media" => null
								)));

							}*/

							// <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<< hardcoded empty ads whilst ramblur has no ads
							array_splice($threads, $i-1, 0, array(array(
								"type" => "ad",
								"depth" => "0",
								"id" => null,
								"style" => null,
								"url" => null,
								"media" => null,
								"subjectVisibility" => $subjectVisibility
							)));							

						} else {

						    // mn mn "array_splice" fails gracefully if $i == 0 ??
							array_splice($threads, $i-1, 0, array(array("type" => "ad", "depth" => "0")));

						}


						// move on again
						$i++;

					}

				}

			}

			// send the good threads back
			return $threads;
		}
		return false;
	}

	// END TMP 2nd feedQuestionsPosts

	// gives an overview of a thread
	function overview($nodeId = 0) {

		// build the first post
		$post = $this->post($nodeId);

		if ( $post !== false ) {

			$post["depth"] = 0;
			$post["thread"] = '';
			$post["overview"] = 'true';
			$post["replies"] = $this->node->childrenTotal($nodeId, "post,question");

			return $post;

		} else {

			return false;

		}

	}



	// returns a thread of posts

	function thread($data) {
		
		$userId = $this->user->authCheck();

		// Check access permissions for private databases
		$query = "CALL checkPostId(?,?,@valid,true);";
		$params = array($data["postId"],$userId);
		$query = $this->db->query($query, $params);
		$tmp = $query->result_array(); 
		if (!isset($tmp[0]["valid"]) || $tmp[0]["valid"] == false) {
			return false;
		}

		if( !isset($data["zing"]) ){$data["zing"] = 0;} 
		if( !isset($data["numZings"]) || !filter_var($data["numZings"],FILTER_VALIDATE_INT)){$data["numZings"] = 0;}
		if(isset($data['resetHeadNode']) && $data['resetHeadNode'] == 1) {
			$data['headNodeId']=$this->resetHeadNode($data['headNodeId']);
		}
	
		// catch if this is a sample request
		if ( mb_substr($data["postId"], 0, 6) == "sample" ) {
			$post = $this->postSample();
		} else {
			
			// Bump numViews for this subject if $data['bumpViewCount'] == true
			if($data["bumpViewCount"] == 'true') {

				$this->library->bumpNumViews($data["postId"]);
			}

			// build the post
			// cjt added false for allowInvisible, or something, and true/false for getNodeInfo (had to add false otherwise parameters didn't match)
			$post = $this->post($data["postId"],$data["headNodeId"],$userId,$data['zing'],$data['numZings'],$data['threadTypeId'],$data['scrollNodeId'],false, (isset($data['device']) && $data['device']===1) ? true : false, false, false);
			if (!$post || empty($post)) {
				return false;
			}
		}
	
		// event timezones
		$post["localStartTime"] = null;
		$post["localEndTime"] = null;
		if($post["type"] === 'event' && !empty($post["timezone"])) {///!!!jbevent
			$this->load->model("Geo");
			$saveStartTime = $post["startTime"];
			$saveEndTime = $post["endTime"];
			$post["startTime"] = $this->Geo->convertFromUTC($post["startTime"], $post["timezone"])->format('Y-m-d H:i:s');
			$post["endTime"] = $this->Geo->convertFromUTC($post["endTime"], $post["timezone"])->format('Y-m-d H:i:s');
			
			if(!empty($post["userTimezone"])) {
				$post["localStartTime"] = $this->Geo->convertFromUTC($saveStartTime, $post["userTimezone"])->format('Y-m-d H:i:s');
				$post["localEndTime"] = $this->Geo->convertFromUTC($saveEndTime, $post["userTimezone"])->format('Y-m-d H:i:s');
			}
		}

		$post['headNodeId'] = $data['headNodeId'];

		if ($post ["type"] === 'subscription_msg') {

			$parent_array = $this->getParentPost($data["postId"]);
			$post['postType'] = $parent_array["postType"];
			$post['subscriptionParentPostId'] = $parent_array['parentPostId'];
			$post['subscriptionSubjectTitle'] = $parent_array['title'];
			$post['subscriptionParentNumViews'] = $parent_array['numViews'];
			$post['subscribed'] = $this->post->getSubscribed($parent_array['parentPostId'], $userId, $parent_array['postType']);
		}

		// add some data for message comment notifications
		if($post['type']==='message'&&!is_null($post['commentedPostId'])) {

			// we need the post title & type
			$this->db->select("title, postType")
				->from('Post')
				->where('postId', $post['commentedPostId']);
			$sql = $this->db->get();

			$row = $sql->row();
			$post['title'] = $row->title;
			$post['postType'] = $row->postType;

		}

		if ($post ["type"] === 'post_ad') {

			// If this is too much of an overhead, then call a local function to get the ad stuff
			$this->load->model('ad');

			//only originator should see replies
			if($post["userId"] !== $userId) {
				$post["children"] = NULL;
			}

			$post ["adUrl"] = null;
			$post ["postAdVotingText1"] = null;
			$post ["postAdVotingText2"] = null;
			$post ["adVote1"] = null;
			$post ["adVote2"] = null;
			$post_ad = $this->ad->getPostAdDetails($data ["postId"]);

			if (!empty($post_ad)) {

				$post ["adUrl"] = $post_ad->url;

				$post ["postAdVotingText1"] = $post_ad->voteText1;
				$post ["postAdVotingText2"] = $post_ad->voteText2;

				// avoid divide by zero!
				if (empty($post_ad->vote1) && empty($post_ad->vote2)) {
					$post ["adVote1"] = ' 00.00%';
					$post ["adVote2"] = ' 00.00%';
				} else if (!empty($post_ad->vote1) && empty($post_ad->vote2)) {
					$post ["adVote1"] = ' 100.0%';
					$post ["adVote2"] = ' 00.00%';
				} else if (empty($post_ad->vote1) && !empty($post_ad->vote2)) {
					$post ["adVote1"] = ' 00.00%';
					$post ["adVote2"] = ' 100.0%';
				} else {
					$post ["adVote1"] = ' ' . $this->pad(round(($post_ad->vote1 / ($post_ad->vote1 + $post_ad->vote2)) * 100, 2)) . '%';
					$post ["adVote2"] = ' ' . $this->pad(round(($post_ad->vote2 / ($post_ad->vote1 + $post_ad->vote2)) * 100, 2)) . '%';
				}
			}
		}
		if(!empty($data["subjectId"])) {
			$post["forumAvatar"] = $this->getThirdPartyAvatar($data["subjectId"]);
		}
		return $post;

	}

	function getParentPost($postId) {

		if ($postId != '') {

			$this->db->select('userToSubscriptionMsg.parentPostId')
				->select('Post.postType')
				->select('Post.subjectId')
				->select('Post.title')
				->select('Post.numViews')
				->select('Nodes.nodeId')
				->from('userToSubscriptionMsg')
				->where('userToSubscriptionMsg.postId', $postId)
				->where('Nodes.level', 0)
				//$this->db->join('subscription', 'subscription.subscriptionId = userToSubscriptionMsg.parentPostId');
				->join('Post', 'userToSubscriptionMsg.parentPostId = Post.postId')
				->join('Nodes', 'Nodes.postId = userToSubscriptionMsg.parentPostId');

			$query = $this->db->get();
			$parent = $query->result_array();
			//limit 1 here !!!!

			if ($query->num_rows() > 0) {
				// get node id separately here or put in query above?
				return ($parent[0]);
			} else {
				return (NULL);
			}
		}
		return (NULL);
	}

	function pad($n) {
		return ($n < 10) ? ("0" . $n) : $n;
	}


	function postSample() {

		$parent = 1;

		if ( fmod($parent, 3) == 0 ) {
			$files = array("file1.zip", "file2.zip", "file3.zip");
			$photos = array("littleGraffiti.jpg", "littleGraffiti2.jpg");
			$links = array("http://www.google.com", "//www.youtube.com/embed/pyhYUjA4IbQ", "//www.youtube.com/embed/trCKMJmz8fg");
			$ads = array("adGraffiti");
			$group = 'Graffiti';
		} else if ( fmod($parent, 2) == 0 ) {
			$files = array("file1.zip", "file2.zip", "file3.zip");
			$photos = array("littleSurfing.jpg", "littleSurfing2.jpg");
			$links = array("http://www.google.com", "//www.youtube.com/embed/8YqOo-s_07k", "//www.youtube.com/embed/gLg6qxkQ94A");
			$ads = array("adSurfing");
			$group = 'Surfing';
		} else {
			$files = array("file1.zip", "file2.zip", "file3.zip");
			$photos = array("littleJohnny.jpg", "littleJohnny2.jpg");
			$links = array("http://www.google.com", "//www.youtube.com/embed/jOz4uUBFAaI", "//www.youtube.com/embed/oPWO_C1rT34");
			$ads = array("adJohnny");
			$group = 'John Deere';
		}

		// different attachment types
		$attachments = array("file", "photo", "video", "drawing", "sound", "link");

		// set up the post
		$node = array(
			"id" => "sample".mt_rand(11111111, 99999999),
			"type" => "post",
			"created" => "Friday, 31 Jan 2014" . ' - ' . mt_rand(1111, 9999),
			"group" => $group,
			"subject" => "this is the title of a thread",
			"userName" => "unknown",
			"userId" => "unknown",
			"country" => "AU",
			"gender" => "?",
			"age" => mt_rand(18, 80),
			"avatar" => "unknown",
			"body" => "Lorem ipsum dolor sit amet, consectetur adipiscing elit."
		);

		if ( mt_rand(0, 100) > 50 ) {
			$node["gender"] = 'M';
		} else {
			$node["gender"] = 'F';
		}

		if ( mt_rand(0, 100) > 50 ) {
			$node["body"] .= " Pellentesque eu interdum odio.";
			if ( mt_rand(0, 100) > 50 ) {
				$node["body"] .= " Suspendisse egestas laoreet nibh sed sollicitudin. #Suspendisse #potenti.";
				if ( mt_rand(0, 100) > 50 ) {
					$node["body"] .= " Sed sit amet mattis nunc. Morbi malesuada, lorem in condimentum venenatis, purus enim rhoncus tortor, eu #volutpat turpis tortor a erat.";
					if ( mt_rand(0, 100) > 50 ) {
						$node["body"] .= " Vivamus sit amet lorem dapibus, gravida neque sit amet, euismod nibh. Nullam luctus massa ac luctus porta.";
					}
				}
			}
		}


		// filter the text
		if ( isset($node["body"]) ) {
			$node["body"] = $this->globals->filter($node["body"]);
		}
		if ( isset($node["title"]) ) {
			$node["title"] = $this->globals->filter($node["title"]);
		}
		if ( isset($node["description"]) ) {
			$node["description"] = $this->globals->filter($node["description"]);
		}


		// choose whether to show an attachment
		if ( mt_rand(0, 100) > 50 ) {

			$node["attachments"] = array();

			// choose a random attachment type for now
			$type = $attachments[mt_rand(0, count($attachments)-1)];

			// set up the post
			$node["attachments"][] = array(
				"id" => mt_rand(11111111, 99999999),
				"type" => $type
			);

			if ( $type == "photo" ) {
				$node["attachments"][count($node["attachments"])-1]["post"] = $photos[mt_rand(0, count($photos)-1)];
			} else if ( $type == "file" ) {
				$node["attachments"][count($node["attachments"])-1]["original"] = $files[mt_rand(0, count($files)-1)];
			} else if ( $type == "link" ) {
				$node["attachments"][count($node["attachments"])-1]["url"] = $links[mt_rand(0, count($links)-1)];
			}

		}

		return $node;

	}

	// builds a post from a postId and level, with attachments
	function post($postId,$headNodeId,$userId,$zingLevel,$numZings,$threadType,$scrollNodeId, $allowInvisible = false, $getNodeInfo=false, $landingPage=false, $drafts=false) {

		// used to figure out if replies count should be from replies or comments...
		$commentTypes = array("article", "event", "blog", "vlog", "review");

		// kwik kludge - cjt
		// seems that 'question' types are set to 'post' (AFAICT from desktop site)
		if($threadType === 'question' || $threadType === 'thread') $threadType = 'post'; // <<<<<<<<<<<<<<<<<<<<<<<<<<<< CHECK THIS?!?!?!?!??

		if($threadType == "post" || $threadType == "subscription" || $threadType == "article" || $threadType == "blog" || $threadType=="review"|| $threadType=="event" || $threadType == "vlog" || $threadType == "newsPost" || $threadType == "message" || $threadType == "comment") {

			// Conditional parts of post retrieval query
			if ( $zingLevel == 0 && $numZings == 0 ){
				$where = "WHERE p.postId = ? AND n.level = ?";
				$selectUser="p";
				$params = array($postId, $zingLevel);
			} else {
				$where = "WHERE n.nodeId = ?";
				$selectUser="n";
				$params = array($headNodeId);
			}
			// KB - two single line queries here were getting difficult to read and maintain (eg. skype and facetime were included twice), so reformatted, and extracted differences as above
			$query = "SELECT s.subjectName,
				p.numComments,
				s.subjectId,
				s.private AS 'subjectPrivate',
				p.postId,
				u.userId,
				u.skype,
				u.facetime,
				n.nodeId AS 'id',
				p.postType AS 'type',
				n.datetime AS 'created',
				p.startTime,
				p.endTime,
				p.timezone,
				u.userName,
				c.countryId AS 'country',
				u.gender,
				FLOOR(DATEDIFF(CURDATE(),u.DOB) / 365) AS age,
				u.avatar,
				u.timezone AS userTimezone,
				p.title AS 'subject',
				n.text AS 'body',
				n.level - ". $zingLevel . " AS 'depth',
				n.hasOffSpring,
				n.tick AS 'ticked',
				p.userId AS 'threadOwner',
				p.score,
				n.parentNodeId,
				n.lastEdit,
				n.reason,
				n.visible,
				n.deleted,
				LCASE(n.deleteReason) AS 'deleteReason',
				p.author,
				p.aboutAuthor,
				m.msgStatus AS recipientMsgStatus,
				mc.commentedPostId,
				p.ownerMsgStatus,
				p.systemMsg AS 'isSystemMessage',
				m.toUser AS 'recipientId',
				rec.userName AS 'recipientUserName',
				p.categoryId,
				cat.name AS catName,
				cat.level AS catLevel,
				p.pinned,
				p.modDeleted AS 'threadDeleted',
				p.draftPost,
				p.draftPostVisible,
				p.draftPostStatus,
				n.draftNode,
				n.draftNodeVisible,
				DATE_FORMAT(n.nodePriorityDate, '%d-%m-%y') AS 'nodePriorityDate',
				u.email,
				s.type AS subjectType,
				UserPerms.ageVisible,
				UserPerms.genderVisible,
				UserPerms.locationVisible,
				UserPerms.emailSearch
				FROM Post AS p
				JOIN Subject AS s ON s.subjectId = p.subjectId
				LEFT JOIN Nodes AS n ON p.postId = n.postId AND n.active = TRUE
				JOIN User AS u ON u.userId = ".$selectUser.".userId
				JOIN Country AS c ON c.countryId = u.countryId
				LEFT JOIN MessagesToUser AS m ON m.messageId = n.nodeId
				LEFT JOIN Category AS cat ON p.categoryId = cat.categoryId
				LEFT JOIN MessagesToComments AS mc ON mc.messageId = n.nodeId
				LEFT JOIN User AS rec ON rec.userId = m.toUser
				LEFT JOIN Permissions AS UserPerms ON u.userId = UserPerms.userId
				" . $where .($allowInvisible ? "" : " AND p.visible = TRUE ");

			$query = $this->db->query($query, $params);
			$tmp= $query->result_array();
			if (empty($tmp)) {
				return [];
			}
			//$query->free_result();
			if ( !isset($tmp[0]["avatar"]) ) {
				// filler avatar
				$tmp[0]["avatar"] = '';
			} else {
				$tmp[0]["avatar"] = $tmp[0]["avatar"] . '-avatar';
			}
			$tmp[0]['isSystemMessage'] = (boolean)$tmp[0]['isSystemMessage'];
			
			$tmp[0]['attributes'] = $this->subjectAttribute->getSubjectAttributesArray($tmp[0]['subjectId']);
			$tmp[0]['visibility'] = $this->subjectAttribute->getForumVisibility($tmp[0]['subjectId'], $tmp[0]['subjectPrivate']);
			
			empty($tmp[0]['ageVisible'])?$tmp[0]['age'] = null:null;
			empty($tmp[0]['genderVisible'])?$tmp[0]['gender'] = null:null;
			empty($tmp[0]['locationVisible'])?$tmp[0]['country'] = null:null;
			empty($tmp[0]['emailSearch'])?$tmp[0]['email'] = null:null;
				
			
					
			// added - cjt
			// get extra data for device
			//if ($getNodeInfo) $tmp[0]["statuses"] = $this->node->iconStatuses($tmp[0]["userId"], $tmp[0]["subjectId"], $tmp[0]['id'], $postId); // HMM, this is a duplicate of same line below??

			// PONDER: i shoehorned the User.timezone field in here, because i needed it!
			// should this be here, or better off in a single select or function? - cjt 301117
			$query1 = "SELECT
				User.timezone,
				t.value AS 'theme',
				IF(u.opacity IS NULL, s.opacity, u.opacity)  AS 'opacity',
				IF(u.primaryColour IS NULL, s.primaryColour, u.primaryColour)  AS 'primaryColour',
				IF(u.secondaryColour IS NULL, s.secondaryColour, u.secondaryColour)  AS 'secondaryColour',
				fp.value AS 'primaryFontColour',
				fs.value AS 'secondaryFontColour'
				FROM Subject AS s
				LEFT JOIN User ON User.userId = ?
				LEFT JOIN UserToSubject u ON u.subjectId = s.subjectId AND u.userId = ?
				JOIN ThemeColourOptions AS t ON t.id = IF(u.themeColourOptionId IS NULL, s.themeColourOptionId, u.themeColourOptionId)
				JOIN ThemeFontOptions AS fp ON fp.id = IF(u.primaryThemeFontOptionId IS NULL, s.primaryThemeFontOptionId, u.primaryThemeFontOptionId)
				JOIN ThemeFontOptions AS fs ON fs.id = IF(u.secondaryThemeFontOptionId IS NULL, s.secondaryThemeFontOptionId, u.secondaryThemeFontOptionId)
				WHERE s.subjectName = ?";
			if (isset($userId) && $userId != '') {
				$params1 = array($userId,$userId,$tmp[0]["subjectName"]);
			} else {
				$params1 = array(null,null,$tmp[0]["subjectName"]);
			}
			$query1 = $this->db->query($query1, $params1);
			$tmp2 = $query1->result_array(); 
			//$query1->free_result(); 
			foreach($tmp2 as $row){ 
				$theme = $row["theme"];
				$opacity = $row["opacity"];
				$primaryColour = $row["primaryColour"];
				$secondaryColour = $row["secondaryColour"];
				$primaryFontColour = $row["primaryFontColour"];
				$secondaryFontColour = $row["secondaryFontColour"];
			}


		// added - cjt
		// get extra data for device
		if ($getNodeInfo) {

			$tmp[0]["statuses"] = $this->node->iconStatuses($tmp[0]["userId"], $tmp[0]["subjectId"], $tmp[0]['id'], $postId);
			// is user a super user
			$tmp[0]["isMod"] = $this->user->canManageSubject($tmp[0]["userId"], $tmp[0]["subjectId"]);
			// is user sub'd to this forum
			$tmp[0]["isSubd"] = $this->user->isForumSubscribed($tmp[0]["subjectId"]);

			// if it's an event convert timzones n'shit
			$tmp[0]["eventStartTime"] = null;
			$tmp[0]["eventEndTime"] = null;
			$tmp[0]["userStartTime"] = null;
			$tmp[0]["userEndTime"] = null;

			if($tmp[0]["type"] === "event"  && !empty($tmp[0]["timezone"])) {
				
	        	$this->load->model("Geo");
	  	    	$tmp[0]["eventStartTime"] = $this->Geo->convertFromUtc($tmp[0]["startTime"], $tmp[0]["timezone"])->format('Y-m-d H:i:s');
	  	    	$tmp[0]["eventEndTime"] = $this->Geo->convertFromUtc($tmp[0]["endTime"], $tmp[0]["timezone"])->format('Y-m-d H:i:s');

				//...flag if the user's timezone is different to that of the event
				// and convert it to the time in their timezone
				if(!is_null($row["timezone"])&&($row["timezone"]!==$tmp[0]["timezone"])) {

					$tmp[0]["userTimeZone"] = $row["timezone"];
					$tmp[0]["userStartTime"] = $this->Geo->convertFromUtc($tmp[0]["startTime"], $row["timezone"])->format('Y-m-d H:i:s');
					$tmp[0]["userEndTime"] = $this->Geo->convertFromUtc($tmp[0]["endTime"], $row["timezone"])->format('Y-m-d H:i:s');

				}

	  		}

		}

			// bugfix for values if they're not set
			if (!isset($theme)) {$theme = $this->getDefaultThemeColourOption()['value'];}
			if (!isset($opacity)) {$opacity = self::DEFAULT_OPACITY;}
			if (!isset($primaryColour)) {$primaryColour = self::DEFAULT_PRIMARYCOLOUR;}
			if (!isset($secondaryColour)) {$secondaryColour = self::DEFAULT_SECONDARYCOLOUR;}
			if (!isset($primaryFontColour)) {$primaryFontColour = $this->getDefaultFontColourOption()['value'];}
			if (!isset($secondaryFontColour)) {$secondaryFontColour = $this->getDefaultFontColourOption()['value'];}

			$tmp[0]["theme"] = $theme;
			$tmp[0]["opacity"] = $opacity;
			$tmp[0]["primaryColour"] = $primaryColour;
			$tmp[0]["secondaryColour"] = $secondaryColour;
			$tmp[0]["primaryFontColour"] = $primaryFontColour;
			$tmp[0]["secondaryFontColour"] = $secondaryFontColour;

			$query = "SELECT nodeId AS 'zeroNode' FROM Nodes WHERE postId = ? and parentNodeId=0";
			$params = array($tmp[0]["postId"]);
			$query = $this->db->query($query, $params); 
			$tmp1 = $query->result_array();

			$tmp[0]["zeroNode"] = $tmp1[0]["zeroNode"];

			/* NUM REPLIES 
	
				Q/P
				-----------
				Replies to Q/P are a straight count of nodes where the postId matches, but parentNodeId isn't 0

				Workarea
				-----------
				Replies to workarea types have to add the number of comments there are, and add that to the number
				of reply nodes there are to any of those comments

			*/
			$tmp[0]["replies"] = (in_array($tmp[0]["type"], $commentTypes)) ? $this->post->getCommentCount($tmp[0]['postId']) : $this->post->getReplyCount($tmp[0]['postId']);

			// moved this to within above if stmt so articles etc do not include image comments
			//$params = array($tmp[0]["postId"]);
			//$query = $this->db->query($query, $params); 
			//$tmp1 = $query->result_array();

			$query = "SELECT numViews FROM Post WHERE postId = ?";
			$params = array($tmp[0]["postId"]);
			$query = $this->db->query($query, $params); 
			$tmp1 = $query->result_array();

			$tmp[0]["numViews"] = $tmp1[0]["numViews"];
			// Get subscription info
			if ($tmp[0]["type"] == "article" || $tmp[0]["type"] == "event" || $tmp[0]["type"] == "blog" || $tmp[0]["type"] == "vlog" || $tmp[0]["type"] == "review" || $tmp[0]["type"] == "subscription_msg") {

				if ($tmp [0]["type"] == "subscription_msg") {
					$parentArr = $this->getParentPost($tmp[0]["postId"]);
					$tmp[0]["subs"] = $this->post->getSubscribedCount($parentArr["parentPostId"], $parentArr["postType"]);
					$tmp[0]["subscribed"] = $this->post->getSubscribed($parentArr["parentPostId"], $userId, $parentArr["postType"]);
				} else {
					$tmp[0]["subs"] = $this->post->getSubscribedCount($tmp[0]['postId'], $tmp[0]['type']);
					$tmp[0]["subscribed"] = $this->post->getSubscribed($tmp[0]['postId'], $userId, $tmp[0]['type']);
				}
			}
			$query = "SELECT thumbsUp FROM Votes WHERE userId = ? AND nodeId = ?";
			$params = array($userId,$tmp[0]["id"]);
			$query = $this->db->query($query, $params); 
			$tmp1 = $query->result_array();
			if (isset($tmp1[0]["thumbsUp"]) && $tmp1[0]["thumbsUp"] == true) {
				$tmp[0]["liked"] = true;
			} else {
				$tmp[0]["liked"] = false;
			}
			$query = "SELECT socialId FROM UserToSocial WHERE userId = ? AND socialId = ? AND subjectId = ?";
			$params = array($userId,$tmp[0]["threadOwner"],$tmp[0]["subjectId"]);
			$query = $this->db->query($query, $params); 
			$tmp1 = $query->result_array();
			if (isset($tmp1[0]["socialId"])) {
				$tmp[0]["socialId"] = $tmp1[0]["socialId"];
			} else {
				$tmp[0]["socialId"] = null;
			}
			
			
			// added mimeType for differentiating how to display various file types - cjt
			// added userFileName for updated attachment display - cjt
			$query1="SELECT userTitle as 'title',Content.description,URL as 'url', numViews, mimeType, "
				. "userFileName as filename, ContentToNodes.fileName as 'post', ContentToNodes.fileName as 'original',"
				. "fileType as 'type',nodeId as 'node',timeStamp,private,ContentToNodes.deleted, "
				. "ContentToNodes.deleteReason,'".$theme."' as 'theme', "
				. "width, height "
				. "FROM ContentToNodes "
				. "JOIN Content ON ContentToNodes.fileName = Content.fileName "
				. "JOIN Subject ON Content.subjectId = Subject.subjectId where nodeId = ? "
				. "ORDER BY fileType <> 'photo', timeStamp, Content.fileName";

			$params=array($headNodeId);
			$query1 = $this->db->query($query1, $params);
			$tmp[0]["attachments"] = [];
			
			if ($query1->num_rows() > 0) {
				$tmp[0]["attachments"] = $query1->result_array();
				//get lightox image extension for parent post
				$tmp[0]["lightboxImgExt"] = $this->getLightboxImg($tmp[0]["attachments"][0]["original"], $tmp[0]["attachments"][0]["private"]);
			}
			
			
			/* 
			 * find out if it is a map, and if so, 
			 * create the info needed to display the 
			 * default map with correct location in the post.
			 * Note this is dummy attachment data as maps do not
			 * currently have an entry in the Content table.
			 * 
			 */
			$mapArr = $this->getMaps($headNodeId);
			if(!empty($mapArr)) {
				array_push($tmp[0]["attachments"], $mapArr);
			}
			
			// Comment feed doesn't have an 'original' post, so only retrieve 3 levels of replies, unless we're in a zing
			$depthToRetrieve = 4;
			if ($threadType == 'comment' /*&& $zingLevel == 0*/) {
				$depthToRetrieve = 3;
			}
			
			if($landingPage) {
				$query11 = "Call getBranchForLandingPage(?,?,?,?,1000000);"; 
			} else if($drafts) {
				$depthToRetrieve = 4;
				$tmp[0]["postOnLandingPage"] = $this->checkPostOnLandingPage($tmp[0]['postId']);
				$query11 = "Call getBranchForDraftPosts(?,?,?,?, 1000000);"; 
			} else {
				$query11 = "Call getBranch(?,?,?,?, 1000000);"; // unreachable limit added - cjt (for only getting 6 replies on a device)
			}
			$params11 = array(($headNodeId=='0'?$tmp[0]['id']:$headNodeId),$depthToRetrieve,$postId,$userId);
			$query11 = $this->db->query($query11, $params11);
			$tmp[0]["children"] = [];
			if ($query11->num_rows() > 0) {
				$tmp[0]["children"] = $query11->result_array();
			}

			for($i = 0;$i < count($tmp[0]["children"]); $i++) {
				$tmp[0]["children"][$i]["theme"] = $theme;
				$tmp[0]["children"][$i]["opacity"] = $opacity;
				$tmp[0]["children"][$i]["primaryColour"] = $primaryColour;
				$tmp[0]["children"][$i]["secondaryColour"] = $secondaryColour;
				$tmp[0]["children"][$i]["primaryFontColour"] = $primaryFontColour;
				$tmp[0]["children"][$i]["secondaryFontColour"] = $secondaryFontColour;
				$tmp[0]["children"][$i]["threadTypeId"] = $threadType;
				$tmp[0]["children"][$i]["scrollNodeId"] = $scrollNodeId;
				$tmp[0]["children"][$i]["replyOnLandingPage"] = $this->checkNodeOnLandingPage($tmp[0]["children"][$i]["id"]);
				$this->db->select("draftNode, draftNodeVisible")
					->from('Nodes')
					->where('nodeId', $tmp[0]["children"][$i]["id"]);
				$q = $this->db->get();
				if ($q->num_rows() > 0) {
					$tmp[0]["children"][$i]["draftNode"] = $q->row()->draftNode;
					$tmp[0]["children"][$i]["draftNodeVisible"] = $q->row()->draftNodeVisible;

					empty($tmp[0]["children"][$i]['ageVisible']) ? $tmp[0]["children"][$i]['age'] = null : null;
					empty($tmp[0]["children"][$i]['genderVisible']) ? $tmp[0]["children"][$i]['gender'] = null : null;
					empty($tmp[0]["children"][$i]['locationVisible']) ? $tmp[0]["children"][$i]['country'] = null : null;
				}


				// added - cjt
				// needed to unify mobile code for two separate cases - make this conditional on being invoked by device?
				if ($getNodeInfo) {
					$tmp[0]["children"][$i]["statuses"] = $this->node->iconStatuses($tmp[0]["children"][$i]["userId"], $tmp[0]["children"][$i]["subjectId"], $tmp[0]["children"][$i]['id'], $postId);
					$tmp[0]["children"][$i]["hasZings"] = $this->node->hasZings($tmp[0]["children"][$i]['id'], $depthToRetrieve); // id = nodeId
					// is this from "me"? - added cjt 150517
					$tmp[0]["children"][$i]["thisUserReply"] = ($tmp[0]["children"][$i]["userId"]==$userId) ? 1 : 0;
					// "harcoding" isSubd which will always (as at 150517) be the case if a user is loading workare comments/replies
					if($threadType==='comment') $tmp[0]["children"][$i]["isSubd"] = 1;
				}

				if ( !isset($tmp[0]["children"][$i]["avatar"]) ) {
					// filler avatar
					$tmp[0]["children"][$i]["avatar"] = '';
				} else {
					$tmp[0]["children"][$i]["avatar"]= $tmp[0]["children"][$i]["avatar"] . '-avatar';
				}

				$query = "SELECT thumbsUp FROM Votes WHERE userId = ? AND nodeId = ?";
				$params = array($userId,$tmp[0]["children"][$i]["id"]);
				$query = $this->db->query($query, $params); 
				$tmp22 = $query->result_array();
				if (isset($tmp22[0]["thumbsUp"]) && $tmp22[0]["thumbsUp"] == true) {
					$tmp[0]["children"][$i]["liked"] = $tmp22[0]["thumbsUp"];
				} else {
					$tmp[0]["children"][$i]["liked"] = false;
				}
				if($this->user->canManageSubject($tmp[0]["children"][$i]['userId'], $tmp[0]["subjectId"])) {
					$tmp[0]["children"][$i]['byManagement'] = true;
					$tmp[0]["children"][$i]['authorLevel'] = $this->user->getUserLevel($tmp[0]["children"][$i]['userId']);
				} else {
					$tmp[0]["children"][$i]['byManagement'] = false;
				}
				// NB: isn't this query pretty much the same as the one above (AND BELOW!!!?  Refactor? cjt
				$query1 = "SELECT userId,userTitle as 'title',Content.description,URL as 'url',ContentToNodes.fileName as 'post', mimeType, userFileName as filename, ContentToNodes.fileName as 'original',fileType as 'type', nodeId as 'node', timeStamp,private,ContentToNodes.deleted, LCASE(ContentToNodes.deleteReason) AS deleteReason,'".$theme."' as 'theme', width, height FROM ContentToNodes JOIN Content ON ContentToNodes.fileName = Content.fileName JOIN Subject ON Content.subjectId = Subject.subjectId where nodeId = ? ORDER BY fileType <> 'photo', timeStamp,Content.fileName";

				$params1 = array($tmp[0]["children"][$i]['id']);
				$query1 = $this->db->query($query1, $params1);
				$tmp[0]["children"][$i]["attachments"] = [];
				if ($query1->num_rows() > 0) {
					$tmp[0]["children"][$i]["attachments"] = $query1->result_array();
					//get lightox image extension for child
					$tmp[0]["children"][$i]["lightboxImgExt"] = $this->getLightboxImg(
							$tmp[0]["children"][$i]["attachments"][0]["original"], $tmp[0]["children"][$i]["attachments"][0]["private"]
					);
				}
			}

		} else if ($threadType == 'social'  || $threadType == 'currentTopics') {

			$additionalJoin = '';
			$additionalSelect = '';
			if ($threadType == 'social') {
				// If no userId was specified, we can't retrieve a social thread
				if (!$userId) {
					return [];
				}
				$additionalJoin = "JOIN UserToSocial ON UserToSocial.userId = ".$userId." AND Post.subjectId = UserToSocial.subjectId AND Nodes.userId = UserToSocial.socialId and UserToSocial.displayed = true";
				$additionalSelect = "UserToSocial.socialId,";
			}

			//$query = "SELECT Post.subjectId,Post.postId,User.userId,Nodes.nodeId AS 'id',postType AS 'type',timeStamp AS 'created',userName,Country.countryId AS 'country',gender,age,avatar,title AS 'subject', text AS 'body',Nodes.level - ".$zingLevel * ($numZings+1) ." AS 'depth',Nodes.hasOffSpring FROM Nodes JOIN Post on Nodes.postId = Post.postId JOIN User ON Nodes.userID = User.userID JOIN Country ON Country.countryId = User.countryId where nodeId = ?;"; 
			$query = "SELECT ".$additionalSelect.
					" Post.subjectId,
					Subject.private AS 'subjectPrivate',
					Post.postId,
					User.userId,
					Nodes.nodeId AS 'id',
					postType AS 'type',
					datetime AS 'created',
					userName,
					Country.countryId AS 'country',
					gender,
					FLOOR(DATEDIFF(CURDATE(),User.DOB) / 365) AS age,
					avatar,
					User.timezone AS userTimezone,
					title AS 'subject',
					text AS 'body',
					Post.startTime,
					Post.endTime,
					Post.timezone,
					Nodes.level - ".$zingLevel * ($numZings+1) ." AS 'depth',
					Nodes.hasOffSpring,
					tick as 'ticked',
					Post.userId AS 'threadOwner',
					score,
					parentNodeId,
					lastEdit,
					reason,
					Nodes.visible,
					Nodes.deleted,
					Nodes.draftNode,
					Nodes.draftNodeVisible,
					LCASE(Nodes.deleteReason) AS 'deleteReason',
					author,
					aboutAuthor,
					skype,
					facetime,
					Post.numComments,
					UserPerms.ageVisible,
					UserPerms.genderVisible,
					UserPerms.locationVisible,
					UserPerms.emailSearch,
					cat.name AS catName,
					cat.level AS catLevel
				FROM Nodes
				JOIN Post on Nodes.postId = Post.postId
				JOIN Subject ON Subject.subjectId = Post.subjectId
				JOIN User ON Nodes.userID = User.userID
				LEFT JOIN Permissions AS UserPerms ON User.userId = UserPerms.userId
				LEFT JOIN Category AS cat ON cat.categoryId = Post.categoryId
				JOIN Country ON Country.countryId = User.countryId ".
				$additionalJoin.
				" WHERE nodeId = ? AND postType != 'message' AND postType != 'subscription_msg';"; 

			$params = array($headNodeId); 

			$query = $this->db->query($query, $params);
			
			if ($query->num_rows() === 0) {
				return [];
			}

			$tmp = $query->result_array();

			if (!isset($tmp[0]["avatar"])) {
				// filler avatar
				$tmp[0]["avatar"] = '';
			} else {
				$tmp[0]["avatar"] = $tmp[0]["avatar"] . '-avatar';
			}
			
			empty($tmp[0]['ageVisible'])?$tmp[0]['age'] = null:null;
			empty($tmp[0]['genderVisible'])?$tmp[0]['gender'] = null:null;
			empty($tmp[0]['locationVisible'])?$tmp[0]['country'] = null:null;
			//email not retrieved in social or current topics
			//empty($tmp[0]['emailSearch'])?$tmp[0]['email'] = null:null;
			
			
			// added - cjt
			// extra data for device
			if ($getNodeInfo) $tmp[0]["statuses"] = $this->node->iconStatuses($tmp[0]["userId"], $tmp[0]["subjectId"], $tmp[0]['id'], $postId);	    

			$query = "SELECT
				s.subjectName,
				t.value AS 'theme',
				IF(u.opacity IS NULL, s.opacity, u.opacity)  AS 'opacity',
				IF(u.primaryColour IS NULL, s.primaryColour, u.primaryColour)  AS 'primaryColour',
				IF(u.secondaryColour IS NULL, s.secondaryColour, u.secondaryColour)  AS 'secondaryColour',
				fp.value AS 'primaryFontColour',
				fs.value AS 'secondaryFontColour'
				FROM
				Subject AS s
				LEFT JOIN UserToSubject u ON u.subjectId = s.subjectId AND u.userId = ?
				JOIN ThemeColourOptions AS t ON t.id = IF(u.themeColourOptionId IS NULL, s.themeColourOptionId, u.themeColourOptionId)
				JOIN ThemeFontOptions AS fp ON fp.id = IF(u.primaryThemeFontOptionId IS NULL, s.primaryThemeFontOptionId, u.primaryThemeFontOptionId)
				JOIN ThemeFontOptions AS fs ON fs.id = IF(u.secondaryThemeFontOptionId IS NULL, s.secondaryThemeFontOptionId, u.secondaryThemeFontOptionId)
				WHERE s.subjectId = ?";
			if (isset($userId) && $userId != '') {
				$params = array($userId, $tmp[0]["subjectId"]);
			} else {
				$params = array(null, $tmp[0]["subjectId"]);
			}
			$query = $this->db->query($query, $params); 
			$tmp1 = $query->result_array();

			$tmp[0]["subjectName"] = $tmp1[0]["subjectName"];
			// Set to default values if not in db
			$tmp[0]["theme"] = is_null($tmp1[0]["theme"]) ? $this->getDefaultThemeColourOption()['value'] : $tmp1[0]["theme"];
			$tmp[0]["opacity"] = is_null($tmp1[0]["opacity"]) ? self::DEFAULT_OPACITY : $tmp1[0]["opacity"];
			$tmp[0]["primaryColour"] = is_null($tmp1[0]["primaryColour"]) ? self::DEFAULT_PRIMARYCOLOUR : $tmp1[0]["primaryColour"];
			$tmp[0]["secondaryColour"] = is_null($tmp1[0]["secondaryColour"]) ? self::DEFAULT_SECONDARYCOLOUR : $tmp1[0]["secondaryColour"];
			$tmp[0]["primaryFontColour"] = is_null($tmp1[0]["primaryFontColour"]) ? $this->getDefaultThemeFontOption()['value'] : $tmp1[0]["primaryFontColour"];
			$tmp[0]["secondaryFontColour"] = is_null($tmp1[0]["secondaryFontColour"]) ? $this->getDefaultThemeFontOption()['value'] : $tmp1[0]["secondaryFontColour"];

			$query = "SELECT nodeId AS 'zeroNode' FROM Nodes WHERE postId = ? and parentNodeId=0";
			$params = array($tmp[0]["postId"]);
			$query = $this->db->query($query, $params); 
			$tmp1 = $query->result_array();

			$tmp[0]["zeroNode"] = $tmp1[0]["zeroNode"];

			// get a different count for 'replies' if type is a particular workarea item, as comments are replies
			if(in_array($tmp[0]["type"], $commentTypes)) {
				// workarea comments
				$tmp[0]["replies"] = $tmp[0]["numComments"];
				//$query = "SELECT count(nodeId) AS 'replies' FROM Nodes n JOIN Post p ON n.postId = p.postId WHERE p.commentedPostId = ?"; 
			} else {
				// q/p replies
				$query = "SELECT COUNT(nodeId) AS 'replies' FROM Nodes WHERE postId = ? AND (Nodes.draftNode = FALSE OR Nodes.draftNodeVisible = TRUE)";
				$params = array($tmp[0]["postId"]);
				$query = $this->db->query($query, $params); 
				$tmp1 = $query->result_array();
				// only decrement if q/p
				$tmp[0]["replies"] = ($tmp[0]["type"]==='post'||$tmp[0]["type"]==='question') ? $tmp[0]["replies"] = $tmp1[0]["replies"] - 1 : $tmp1[0]["replies"];
			}


			$query = "SELECT numViews FROM Post WHERE postId = ?"; 
			$params = array($tmp[0]["postId"]); 
			$query = $this->db->query($query, $params);  
			$tmp1 = $query->result_array(); 

			$tmp[0]["numViews"] = $tmp1[0]["numViews"]; 

			if( $tmp[0]["type"] == "article" || $tmp[0]["type"] == "event" || $tmp[0]["type"] == "blog" || $tmp[0]["type"] == "vlog" || $tmp[0]["type"] == "review") {
				$tmp[0]["subs"] = $this->post->getSubscribedCount($tmp[0]['postId'], $tmp[0]['type']);
				$tmp[0]["subscribed"] = $this->post->getSubscribed($tmp[0]['postId'], $userId, $tmp[0]['type']);
			}

			$query = "SELECT thumbsUp FROM Votes WHERE userId = ? AND nodeId = ?"; 
			$params = array($userId,$tmp[0]["id"]); 
			$query = $this->db->query($query, $params);  
			$tmp1 = $query->result_array(); 
			if(isset($tmp1[0]["thumbsUp"]) && $tmp1[0]["thumbsUp"] == true){ 
				$tmp[0]["liked"] = $tmp1[0]["thumbsUp"]; 
			}else{ 
				$tmp[0]["liked"] = false; 
			}

			$query1="SELECT userTitle as 'title',Content.description,URL as 'url',numViews, ContentToNodes.fileName as 'post', ContentToNodes.fileName as 'original',fileType as 'type', mimeType, userFileName as filename, nodeId as 'node',timeStamp,private,ContentToNodes.deleted, LCASE(ContentToNodes.deleteReason) AS deleteReason,'".$tmp[0]["theme"]."' as 'theme', width, height FROM ContentToNodes JOIN Content ON ContentToNodes.fileName = Content.fileName JOIN Subject ON Content.subjectId = Subject.subjectId where nodeId = ? ORDER BY fileType <> 'photo', timeStamp, Content.fileName"; 

			//$params=array($tmp[0]['id']); 
			$params=array($headNodeId); 
			$query1 = $this->db->query($query1, $params);
			$tmp[0]["attachments"] = [];
			if ($query1->num_rows() > 0) {
				$tmp[0]["attachments"] = $query1->result_array(); 
				//get lightox image extension forsocial feed or current topic post
				$tmp[0]["lightboxImgExt"] = $this->getLightboxImg($tmp[0]["attachments"][0]["original"], $tmp[0]["attachments"][0]["private"]);
			}
			
			
			
			
			/* 
			 * find out if it is a map, and if so, 
			 * create the info needed to display the 
			 * default map with correct location in the post.
			 * Note this is dummy attachment data as maps do not
			 * currently have an entry in the Content table.
			 * 
			 */
			
			$mapArr = $this->getMaps($headNodeId);
			if(!empty($mapArr)) {
				array_push($tmp[0]["attachments"], $mapArr);
			}
			
		}
		
		$tmp[0]['byManagement'] = false;

		if(!isset($tmp[0]["subjectId"])) {
			$tmp[0]["subjectId"] = $this->node->getSubjectId($headNodeId);
		}
		if($this->user->canManageSubject($tmp[0]['userId'], $tmp[0]["subjectId"])) {
			$tmp[0]['byManagement'] = true;
			$tmp[0]['authorLevel'] = $this->user->getUserLevel($tmp[0]['userId']);
			/*$this->db->select('postLink')
				->from('Moderator')
				->where('userId', $tmp[0]['userId']);
			$modInfo = $this->db->get();
			if($modInfo->num_rows() > 0) {
				$tmp[0]['moderatorLink'] = $modInfo->first_row('array')['postLink'];
			}*/
		}
		
	//convert the event times on the landing page (home page)
	if($landingPage || $drafts) {	
		$tmp[0]["headNodeId"] = $headNodeId;
		$tmp[0]["short"] = 'true'; //wants a string here!
		if($tmp[0]["type"] === 'event' && !empty($tmp[0]["timezone"])) {///!!!jbevent
			$this->load->model("Geo");
			$tmp[0]["startTime"] = $this->Geo->convertFromUTC($tmp[0]["startTime"], $tmp[0]["timezone"])->format('Y-m-d H:i:s');
			$tmp[0]["endTime"] = $this->Geo->convertFromUTC($tmp[0]["endTime"], $tmp[0]["timezone"])->format('Y-m-d H:i:s');
		}
	}
	return($tmp[0]);
	}
	
	
	function getLightboxImg($originalFilename, $private) {
		$lbImgExt = $this->config->item("lightboxImage");
		$fallbackLbImgExt = $this->config->item("fallbackLightboxImage");
		if(file_exists($this->file->getFilePath($originalFilename . $lbImgExt, $private))) {
			return $lbImgExt; //return files generated from 3/5/18
		}
		return $fallbackLbImgExt; //return original files
	}

// ##################################################################################################################

	/**
	 * Forum information specifically for dashboard tool, as complete information for forum editing is required.
	 */
	
	function dashboardInfo($id) {
		$userId = $this->user->authCheck();
		if(!$userId) {
			return [];
		}
		// Get if user is retrieving the subject as an owner/admin or just for themselves
		$accessType = $this->getUserAccessType($id, $userId);
		if(!$accessType) {
			return [];
		}
		$userOnlyRetrieval = $accessType === 'admin' || $accessType === 'owner' ? false : true;
		
		// forum basic info
		if($userOnlyRetrieval) {
			$this->db->select("
				s.subjectId AS 'id',
				s.parentSubjectId AS 'parentId',
				s.subjectName AS 'name',
				s.description,
				u.primaryColour,
				u.secondaryColour,
				pf.value AS 'primaryFontColour',
				sf.value AS 'secondaryFontColour',
				t.value AS 'theme',
				u.opacity,
				s.private,
				s.type,
				s.createdBy,
				User.userName,
				s.requireAgeCheck AS 'ageBlock'
			")
			->from('Subject  AS s')
			->join('UserToSubject AS u', 'u.subjectId = s.subjectId')
			->join('ThemeColourOptions AS t', 't.id = u.themeColourOptionId')
			->join('ThemeFontOptions AS pf', 'pf.id = u.primaryThemeFontOptionId')
			->join('ThemeFontOptions AS sf', 'sf.id = u.secondaryThemeFontOptionId')
			->join('User', 'User.userId = s.createdBy', 'LEFT')		
			->where([
				's.subjectId' => $id,
				'u.userId' => $userId
			]);
		} else {
			$this->db->select("
				s.subjectId AS 'id',
				s.parentSubjectId AS 'parentId',
				s.subjectName AS 'name',
				s.description,
				s.primaryColour,
				s.secondaryColour,
				pf.value AS 'primaryFontColour',
				sf.value AS 'secondaryFontColour',
				t.value AS 'theme',
				s.opacity,
				s.private,
				s.type,
				s.createdBy,
				User.userName,
				s.requireAgeCheck AS 'ageBlock'
				")
				->from('Subject AS s')
				->join('ThemeColourOptions AS t', 't.id = s.themeColourOptionId')
				->join('ThemeFontOptions AS pf', 'pf.id = s.primaryThemeFontOptionId')
				->join('ThemeFontOptions AS sf', 'sf.id = s.secondaryThemeFontOptionId')
				->join('User', 'User.userId = s.createdBy', 'LEFT')		
				->where('subjectId', $id);
		}
		
		$group = $this->db->get();
		if($group->num_rows() === 0) {
			return false;
		}
		$group = $group->first_row('array');

		// Member backgrounds
		$memberBackgrounds = [];
		
		if ($userOnlyRetrieval) {
			$this->db->select("
				s.id,
				s.fileName,
				s.active,
				s.order,
				s.userId,
				u.info,
				c.bgParams
				")
			->from('SubjectDisplay AS s')
			->join('SubjectDisplayToUser AS u', 'u.subjectDisplayId = s.id AND u.userId = ' . $userId, 'LEFT')
			->join('Content AS c', 'c.fileName = s.fileName')
			->where("(s.userId = $userId OR s.userId IS NULL)")
			->where(['s.subjectId' => $id, 's.type' => 'memberBg']);
			$bgResult = $this->db->get()->result_array();
			foreach($bgResult as $bg) {
				if(!is_null($bg['info'])) {
					// retrieve order, active and deleted
					$active = $bg['info'] & self::SUBJECTDISPLAYTOUSER_ACTIVEMASK;
					$order = $bg['info'] & self::SUBJECTDISPLAYTOUSER_ORDERMASK;
					$deleted = $bg['info'] & self::SUBJECTDISPLAYTOUSER_DELETEDMASK;
				} else {
					$active = $bg['active'];
					$order = $bg['order'];
					$deleted = false;
				}
				if (!$deleted) {
					$bgObject = [
						'id' => $bg['id'],
						'fileName' => $bg['fileName'],
						'src' => $bg['fileName'].'-ucbackground',
						'userId' => $bg['userId'],
						'active' => (boolean)$active,
						'order' => $order
					];
					$bgObject = $this->addBackgroundParameters($bg['bgParams'], $bgObject);
					$memberBackgrounds[] = $bgObject;
				}
			}
			// Sort backgrounds by order
			usort($memberBackgrounds, function($a, $b) {
				return $a['order'] - $b['order'];
			});
		} else {
			// for subject wide images eg. creator or admin
			$this->db->select("s.id, s.fileName, s.active, c.bgParams")
				->from('SubjectDisplay AS s')
				->join('Content AS c', 'c.fileName = s.fileName')
				->where([
						's.subjectId' => $id,
						's.userId' => NULL,
						's.type' => 'memberBg'
				])
				->order_by('s.order', 'ASC');
			foreach($this->db->get()->result_array() as $bg) {
				$bgObject = [
					'id' => $bg['id'],
					'fileName' => $bg['fileName'],
					'src' => $bg['fileName'].'-ucbackground',
					'userId' => NULL,
					'active' => (boolean)$bg['active']
				];
				$bgObject = $this->addBackgroundParameters($bg['bgParams'], $bgObject);
				$memberBackgrounds[] = $bgObject;
			}
		}
		
		$thirdPartyBackgrounds = [];
		$carouselImages = [];
		$avatar = null;
		$categories = [];

		if(!$userOnlyRetrieval) {
			// Third party backgrounds, carousel images and avatar
			$this->db->select("s.id, s.fileName, s.active, s.type, c.bgParams")
				->from('SubjectDisplay AS s')
				->join('Content AS c', 'c.fileName = s.fileName')
				->where([
					's.subjectId' => $id,
					's.userId' => NULL,
				])
				//->where("(s.type = 'thirdPartyBg' OR s.type = 'carousel' OR s.type = 'avatar')")
				->where("(s.type = 'thirdPartyBg' OR s.type = 'avatar')")
				->order_by('s.type, order', 'ASC');
			
			foreach($this->db->get()->result_array() as $bg) {
				$type = $bg['type'];
				if($type === 'thirdPartyBg') {
					$bgObject = [
						'id' => $bg['id'],
						'fileName' => $bg['fileName'],
						'src' => $bg['fileName'].'-ucbackground',
						'original' => $bg['fileName'].'-ucoriginal',
						'active' => (boolean)$bg['active']
					];
					$bgObject = $this->addBackgroundParameters($bg['bgParams'], $bgObject);
					$thirdPartyBackgrounds[] = $bgObject;
				/* } else if ($type === 'carousel') {
					$carouselImages[] = [
						'id' => $bg['id'],
						'fileName' => $bg['fileName'],
						'src' => $bg['fileName'].'-hqdefault',
						'active' => (boolean)$bg['active']
					]; */
				} else if ($type === 'avatar') {
					$avatar = $avatar = [
						'id' => $bg['id'],
						'fileName' => $bg['fileName'],
						'src' => $bg['fileName'] . '-avatar'];
				}
			}
			
			// categories
			$categoryQuery = $this->db->query('CALL getCategoryBranch(0, 99999999, ?, ?)', [$id, $userId]);
			// Type visible to a boolean
			$categories = array_map(function($a) {
				$a['visible'] = (boolean)$a['visible'];
				return $a;
			}, $categoryQuery->result_array());
		}
		
		$this->db->select('forumId')
			->from('adsDisabled')
			->where([
				'forumId' => $id,
				'status' => 1
		]);
		$adsEnabled = $this->db->get()->num_rows() === 0;
		
		return ['group' => [
			'id' => $id,
			'name' => $group['name'],
			'description' => $group["description"],
			'type' => $this->getTypeLabel($group['type']),
			'parentId' => $group["parentId"],
			'createdBy' => $group["createdBy"],
			'createdByUserName' => $group["userName"],
			'accessType' => $accessType,
			'primaryColour' => $group['primaryColour'],
			'secondaryColour' => $group['secondaryColour'],
			'primaryFontColour' => $group['primaryFontColour'],
			'secondaryFontColour' => $group['secondaryFontColour'],
			'theme' => $group['theme'],
			'opacity' => $group['opacity'],
			'avatar' => $avatar,
			'privacy' => $this->subjectAttribute->getForumVisibility($id, $group['private']),
			'adsEnabled' => $adsEnabled,
			'ageBlock' => (boolean)$group['ageBlock'], 
			'memberBackgrounds' => $memberBackgrounds,
			'thirdPartyBackgrounds' => $thirdPartyBackgrounds,
			//'carouselImages' => $carouselImages,
			'categories' => $categories,
			'attributes' => $this->subjectAttribute->getSubjectAttributesArray($id)
		]];
		
	}
	
	/**
	 * Adds display parameters for the forum creation background tool. If none have been set defaults will be added.
	 * 
	 * @param array $paramString - json string containing left, top, size, flipH and flipV display parameters
	 * @param array $bgObject
	 */
	private function addBackgroundParameters($paramString, $bgObject) {
		$bgParams = json_decode($paramString, true);
		if ($bgParams) {
			$left = $bgParams['left'];
			$top = $bgParams['top'];
			$size = $bgParams['size'];
			$flipH = $bgParams['flipH'];
			$flipV = $bgParams['flipV'];
		} else {
			$left = 0;
			$top = 0;
			$size = 100;
			$flipH = false;
			$flipV = false;
		}
		$bgObject['left'] = $left;
		$bgObject['top'] = $top;
		$bgObject['size'] = $size;
		$bgObject['flipH'] = $flipH;
		$bgObject['flipV'] = $flipV;
		
		return $bgObject;
	}
	
	/**
	 * Fetch all info about a specific group
	 *
	 * @param array $data
	 * @return array|boolean
	 */
	function info($data) {
		
		if (!is_array($data)) {
			return false;
		}
		if (!isset($data['group'])) {
			return false;
		}

		if(isset($data['dashboard']) && $data['dashboard']) {
			return $this->dashboardInfo($data['group']);
		}

		// must be logged in
		$userId = $this->user->authCheck();

		// mn Add handling of subjectNames as input
		// This needs to be removed, as forum names won't be unique
		if (!is_numeric($data["group"]) ){
			$data["group"] = $this->makeSubjectId($data["group"],$userId);
		}

		$forumType = $this->getType($data["group"]);
		$thirdParty = false;
		if(!empty($data["referrer"]) && !preg_match('/ramblur\.com/',$data["referrer"])) {
			if($forumType != self::TYPE_RAMBLUR) {
				$thirdParty = true;
			}
		}
		
		$forumPrivate = $this->getForumPrivate($data["group"]);
		$subscribed = (boolean)$this->user->isForumSubscribed($data["group"]);
		
		if ($forumPrivate) {
			// non-members can't get group info if it's not a third party request
			if (!$thirdParty && (!$userId || !$subscribed) && !$this->user->adminCheck()) {
				return false;
			}
		}
		
		$group = [];
		// for overviews, etc
		if ($data["group"] <= 0 ) {
			// set a blank entry for now
			$group["id"] = -1;
			$group["properties"] = array();
			$group["backgrounds"] = array();
		} else {
		
			if (!$subscribed) {
				
				// Not following, so get values from Subject table - anonymous or non-member
				$this->db->select("
						s.subjectName,
						s.private,
						'' AS 'template',
						s.primaryColour,
						s.secondaryColour,
						fp.value AS 'primaryFontColour',
						fs.value AS 'secondaryFontColour',
						t.value AS 'theme',
						'0' AS forumThemeSet, 
						'' AS forumTheme,
						s.opacity,
						s.banner,
						s.facebookLink,
						'' AS 'catFilterList'
					")
					->from('Subject AS s')
					->join('ThemeColourOptions AS t', 't.id = s.themeColourOptionId')
					->join('ThemeFontOptions AS fp', 'fp.id = s.primaryThemeFontOptionId')
					->join('ThemeFontOptions AS fs', 'fs.id = s.secondaryThemeFontOptionId')
					->where('s.subjectId', $data['group']);
			
			} else if ($data['group'] == 1) {
				
				////////////////////////////////test s*****************************************************8888//
				// my feed details are stored on the User table (from some reason...)
				$this->db->select("
						'my feed' AS 'subjectName',
						0 AS 'private',
						u.template,
						u.primaryColour,
						u.secondaryColour,
						fp.value AS 'primaryFontColour',
						fs.value AS 'secondaryFontColour',
						t.value AS 'theme',
						'0' AS forumThemeSet, 
						'' AS forumTheme,
						u.opacity,
						'' AS 'facebookLink',
						'' AS 'catFilterList'
					")
					->from('User AS u')
					->join('ThemeColourOptions AS t', 't.id = u.themeColourOptionId')
					->join('ThemeFontOptions AS fp', 'fp.id = u.primaryThemeFontOptionId')
					->join('ThemeFontOptions AS fs', 'fs.id = u.secondaryThemeFontOptionId')
					->where('u.userId', $userId);
				
			} else {
			
				$this->db->select("
						s.subjectName,
						s.private,
						u.template,
						u.primaryColour,
						u.secondaryColour,
						fp.value AS 'primaryFontColour',
						fs.value AS 'secondaryFontColour',
						t.value AS 'theme',
						u.opacity,
						s.banner,
						s.facebookLink,
						u.catFilterList,
						u.forumThemeSet,
						u.forumTheme
					")
					->from('Subject AS s')
					->join('UserToSubject AS u', 's.subjectId = u.subjectId')
					->join('ThemeColourOptions AS t', 't.id = u.themeColourOptionId')
					->join('ThemeFontOptions AS fp', 'fp.id = u.primaryThemeFontOptionId')
					->join('ThemeFontOptions AS fs', 'fs.id = u.secondaryThemeFontOptionId')
					->where([
						's.subjectId' => $data['group'],
						'u.userId' => $userId
					]);
			}
			
			$subDetails = $this->db->get();
			
			if ($subDetails->num_rows() > 0) {
				$subDetails = $subDetails->first_row('array');
				$group['properties'] = [
					['name' => 'template', 'value' => $subDetails["template"]],
					['name' => 'primaryColour', 'value' => $subDetails["primaryColour"]],
					['name' => 'secondaryColour', 'value' => $subDetails["secondaryColour"]],
					['name' => 'primaryFontColour', 'value' => $subDetails["primaryFontColour"]],
					['name' => 'secondaryFontColour', 'value' => $subDetails["secondaryFontColour"]],
					['name' => 'theme', 'value' => $subDetails["theme"]],
					['name' => 'opacity', 'value' => $subDetails["opacity"]],
					['name' => 'catFilterList', 'value' => $subDetails["catFilterList"]],
					['name' => 'name', 'value' => $subDetails["subjectName"]],
					['name' => 'private', 'value' => (boolean)$subDetails["private"]],
					['name' => 'facebookLink', 'value' => $subDetails["facebookLink"]],
					['name' => 'attributes', 'value' => $this->subjectAttribute->getSubjectAttributesArray($data['group'])],
					['name' => 'visibility', 'value' => $this->subjectAttribute->getForumVisibility($data['group'], $forumPrivate)],
					['name' => 'forumThemeSet', 'value' => $subDetails["forumThemeSet"]],
					['name' => 'forumTheme', 'value' => $subDetails["forumTheme"]]
				];
				$group['id'] = $data['group'];
				if(!empty($subDetails["banner"])) {
					$group['banner'] = $subDetails["banner"];
				}
			} else {
				// No access to the subject, or doesn't exist
				return false;
			}
			
			$group["backgrounds"] = array();
			$group['type'] = $this->getTypeString($forumType);
	
			$tmp = $this->backgrounds(array('groupId' => $data["group"],'thirdParty' => $thirdParty));
	
			if ($tmp !== false) {
				$group["backgrounds"] = $tmp;
			}
			unset($tmp);
		}
	
		// add the default backgrounds
		$group["backgroundsDefault"] = [
			["background" => "background-1-default_v2.jpg"]
		];

		return $group;
	}

// ##################################################################################################################

	// fetch all active backgrounds for a specific group
	function backgrounds($data) {
		$userId = $this->user->authCheck();
		$anonymous = false;
		$followingForum = false;
		if($userId === false){
			$anonymous = true;
		}
		$backgrounds = array();
		
		$this->db->select('s.subjectId, s.private, s.type')
			->from('Subject AS s')
			->where('s.subjectId', $data['groupId']);
		

		$groupResult = $this->db->get();
		if ($groupResult->num_rows() === 0) {
			return false;
		}
		$group = $groupResult->first_row('array');
		
		if (!$anonymous) {
			$followingForum = $this->user->isForumSubscribed($data['groupId']);
		}
		
		$this->db->select("
			d.fileName,
			d.subjectId,
			d.active AS 'backgroundActive',
			c.license,
			c.licensePhotourl,
			c.licenseUserurl,
			c.licenseTitle,
			c.licenseUsername, 
			s.private
			")
			->select("IF(u.subjectDisplayId IS NULL, d.order, u.info & " . self::SUBJECTDISPLAYTOUSER_ORDERMASK . ") AS 'order'", FALSE)
			->from('SubjectDisplay AS d')
			->join('Content AS c', 'c.fileName = d.fileName')
			->join('Subject AS s', 's.subjectId = d.subjectId')
			// If ramblur backgrounds have been customised, base active and order on user settings, rather than group-wide settings
			->join('SubjectDisplayToUser AS u', "u.subjectDisplayId = d.id AND u.userId = " . ($anonymous ? 0 : $userId), 'LEFT')
			// Always show 3rd party bgs if the user isn't following the forum and it's a non-ramblur forum, otherwise show member bg
			->where('d.type', (int)$group['type'] === self::TYPE_RAMBLUR || $followingForum ? 'memberBg' : 'thirdPartyBg')
			->where("(d.subjectId = ANY (SELECT subjectId FROM subjectGroups WHERE userId = " . ($anonymous ? 0 : $userId)." AND groupWith = ${group['subjectId']} AND subjectId != ${group['subjectId']}) OR d.subjectId = ${group['subjectId']})")
			->where('IF(u.subjectDisplayId IS NULL, d.active = 1, u.info & ' . self::SUBJECTDISPLAYTOUSER_ACTIVEMASK . ')', null, FALSE)
			// If not signed in, only return subject backgrounds, otherwise return both subject and user-defined backgrounds
			->where($anonymous ? 'd.userId IS NULL' : "(d.userId IS NULL OR d.userId = $userId)")
			// order by customised order
			->order_by('order', 'ASC');

		$query = $this->db->get();
		$tmp = $query->result_array();

		// go through all the backgrounds
		for ( $i = 0; $i < count($tmp); $i++ ) {

			$original = $tmp[$i]["fileName"];
			$ucbackground = $original.'-'.'ucbackground';
			$background = $original.'-'.'background';
			$mobile = $original.'-'.'mobile';
			$maxres = $original.'-'.'maxresdefault';
			$default = $original.'-'.'default';
			// Query only returns active backgrounds. If client filters by active later on, can retrieve active and inactive, and show here
			$active = true;
			$order = $tmp[$i]["order"];
			$private = (boolean)$tmp[$i]["private"];

			if (
				$original !== false &&
				$ucbackground !== false &&
				$background !== false &&
				$mobile !== false &&
				$default !== false
			) {

				// thumb & target are sent for globalMediaThumbnail compatibility.
				$backgrounds[] = array(
					"id" => $tmp[$i]["subjectId"],
					"original" => $original,
					"target" => $original,
					"ucbackground" => $ucbackground,
					"background" => $background,
					"mobile" => $mobile,
					"default" => $default,
					"thumb" => $default,
					"active" => $active,
					"maxres" => $maxres,
					"order" => $order,
					"license" => '',
					"license_title" => '',
					"license_username" => '',
					"license_photourl" => '',
					"license_userurl" => '',
					"private" => $private
				);

				// now add the license info
				$license = $tmp[$i]["license"];
				if (($license !== false ) && ( $license != '')) {

					$backgrounds[count($backgrounds)-1]["license"] = $license;

					if ($license == 'CC BY') {
						$backgrounds[count($backgrounds)-1]["license_title"] = $tmp[$i]["licenseTitle"];
						$backgrounds[count($backgrounds)-1]["license_username"] = $tmp[$i]["licenseUsername"];
						$backgrounds[count($backgrounds)-1]["license_photourl"] = $tmp[$i]["licensePhotourl"];
						$backgrounds[count($backgrounds)-1]["license_userurl"] = $tmp[$i]["licenseUserurl"];
					}
				}
			}
		}

		if (count($backgrounds) > 0) {
			return $backgrounds;
		} else {
			return false;
		}
	}
	
	function getDefaultBackgrounds($userId = false, $maxCount) {
		
		$backgrounds = [];
		for ($i = 0; $i < $maxCount; $i++) {
			
			$iNum = $i + 1;
			$suffix = 'img/backgrounds/'.$iNum.'.jpg';
			$srcFile = $this->config->item('static_assets_external_url').$suffix;
			$checkSrcFile = $this->config->item('static_assets_internal_url').$suffix;
			// Make sure the background number is in the file system
			if (!$this->file->URLFileExists($checkSrcFile)) {
				continue;
			}
			
			$bg = [
				'id' => 'sample'.$iNum,
				'fileName' => 'sample'.$iNum,
				'src' => $srcFile,
				'active' => true,
				'order' => $iNum
			];
			
			$backgrounds[] = $bg;
		}
		
		return $backgrounds;
	}

	function getThirdPartyAvatar($groupIdentifier) {
		
		if (!is_numeric($groupIdentifier) ){
			return ['avatar' => false];
		}
	
		$this->db->select("CONCAT(fileName, '-avatar') AS 'avatar'", FALSE)
			->from('SubjectDisplay')
			->where([
				'subjectId' => $groupIdentifier,
				'type' => 'avatar'
			]);

		$result = $this->db->get();
		if ($result->num_rows() === 0) {
			return ['avatar' => false];
		} else {
			return $result->first_row('array');
		}
	}
	function extras($data) {

		$extras = array();
		$userId = $this->user->authCheck();

		if (!is_numeric($data["group"]) ){
			$data["group"] = $this->makeSubjectId($data["group"],$userId);
		}
		
		// If user is logged in, check they have access to the subject. Anonymous
		// access is in the retrieval query, by excluding private forums
		if ($userId && !$this->getUserAccess($data['group'], $userId)) {
			return false;
		}
		
		//@todo - change $userId to placeholder
		$this->db->select("
				c.fileName,
				c.fileType as 'type',
				c.URL as 'url',
				c.subjectId as 'id',
				c.userTitle AS 'title',
				c.description,
				c.duration,
				c.numViews,
				c.license,
				p.postType,
				s.private")
			->from('Content AS c')
			->join('Subject AS s', 's.subjectId = c.subjectId')
			->join('ContentToNodes AS cn', 'cn.fileName = c.fileName')
			->join('Nodes AS n', 'n.nodeId = cn.nodeID')
			->join('Post AS p', 'p.postId = n.postId')
			->where("((cn.draftNode = '0' OR cn.draftNodeVisible = '1') OR (cn.draftNode = '1' AND p.userId = ".($userId ? $userId : "false")."))")
			->where('p.postType !=', 'message')
			->where('p.modDeleted', 0)
			->order_by('c.timeStamp', 'DESC')
			->limit(20);
				
		if($userId){
			if($data["group"] > 1 ){
				$this->db->where('c.subjectId', $data['group']);
			}else{
				$this->db->join('UserToSubject AS u', 'u.subjectId = c.subjectId')
				->where('u.userId', $userId)
				->where('c.subjectId !=', $data['group']);
			}
		}else{
			// allow anonymous access to everything except private forums
			$this->db->where([
					'c.subjectId' => $data['group'],
					's.private' => 0
			]);
		}
	 
		// find all the children that match the specified extra
		if ( $data["extra"] == 'gallery' ) {
			$this->db->where("(c.fileType='photo' OR c.fileType='video' OR c.fileType='link' OR c.fileType = 'drawing')");
			// NOTE: LINKS ARE INCLUDED FOR YOUTUBE THUMBNAILS

		} else if ($data["extra"] == 'mediaThumbs' ) {
			$this->db->where("(c.fileType='video' OR (c.fileType='link' AND (c.URL like '%youtube%' OR c.URL like '%vimeo%')))")
				->where('c.status', 0);

		} else {
			return false;
		}

		$children = $this->db->get()->result_array();
		/* mn 20150313:  Calling the Youtube API here is too slow.  Just use values on the db for now, will work out a strategy
		 for updating the db values later*/
/*		$apiKey = "AIzaSyBobbCj5F26t85qW1AU7N61C9RPxIT3BEk";

		// if there are children
		if ( ( $children !== false ) && ( count($children) > 0 ) ) {

		  // go through all the children
		  $i = 0;
		  while ( $i < count($children) ) {
		    $children[$i]["numViews"] = -1;
		    // if its a link and youtube
		    if ( ( $children[$i]["type"] == "link" ) && ( stripos($children[$i]["url"], "youtube") !== false ) ) {
		      //parse_str(parse_url($children[$i]["url"], PHP_URL_QUERY), $tmp);

		      $pattern = '/\/([a-zA-Z0-9_-]{11})\?rel=/';

		      preg_match($pattern,$children[$i]["url"],$match);

		      if ( isset($match[1]) ){
			//mn 20150313 - retrieve numViews using youtube api and add to the output

			$result = file_get_contents("https://www.googleapis.com/youtube/v3/videos?part=statistics&id=".$match[1]."&fields=items(id%2Cstatistics(viewCount))&key=".$apiKey);

			if ( $result !== false ) {

			  // decode it
			  $result = json_decode($result, true);

			  if ( ! isset($result["error"]) && isset($result["items"][0]["statistics"]["viewCount"]) ) {
			    $children[$i]["numViews"] = $result["items"][0]["statistics"]["viewCount"];

			  }else{
			    $children[$i]["numViews"] = -2;
			  }
			}else{
			  $children[$i]["numViews"] = -3;
			}
		      }
		    }else{
		      $children[$i]["numViews"] = -4;
		    }
		  $i++;
		  }
		}
*/


		// work out our pages
		$page = 1;  //mn  will need to change this, restricts number of videos in side panel 
		// if a page was set
		if(isset($data["page"]) && !filter_var($data["page"],FILTER_VALIDATE_INT)){return false;}
		if ( isset($data["page"]) ) {
			$page = intval($data["page"]);
		}


		for ( $i = (($page-1) * 20), $ilen = ($page * 20); $i < $ilen; $i++ ) {

			if ( isset($children[$i]) ) {

				$extras[] = array(
					"user_name" => '',
					"user_id" => $userId,
					"id" => $children[$i]['id'],
					"type" => $children[$i]['type'],
					"url" => $children[$i]['url'],
					"title" => $children[$i]['title'],
					"description" => $children[$i]['description'],
					"duration" => $children[$i]['duration'],
					"numViews" => $children[$i]['numViews'],
					"private" => $children[$i]['private'],
					"postType" => $children[$i]['postType']
				);

				if ( $data['extra'] == 'gallery' || $data['extra'] == 'mediaThumbs' ) {

					$thumbnail=$children[$i]["fileName"].'-default';  // mn May change the size
					$original=$children[$i]["fileName"];  // mn May change the size
					// if there is a thumbnail to show

					if ($thumbnail !== false) {
			
						$extras[count($extras)-1]["target"] = $original;
						$extras[count($extras)-1]["thumb"] = $thumbnail;
					}


					// if there is a flickr title/license/etc use it
					$license = $this->globals->findProperty("license", $children[$i]);
					if ( ( $license !== false ) && ( $license != '' ) ) {

						$extras[count($extras)-1]["license"] = $license;

							// most likely a flickr one
						if ( $license == 'CC BY' ) {
							$extras[count($extras)-1]["license_title"] = $this->globals->findProperty("license_title", $children[$i]);
							$extras[count($extras)-1]["license_photourl"] = $this->globals->findProperty("license_photourl", $children[$i]);
							$extras[count($extras)-1]["license_username"] = $this->globals->findProperty("license_username", $children[$i]);
							$extras[count($extras)-1]["license_userurl"] = $this->globals->findProperty("license_userurl", $children[$i]);
						}
					}
		
				} else {
					$extras[count($extras)-1]["subject"] = $this->globals->findProperty("subject", $children[$i]);
					$extras[count($extras)-1]["body"] = $this->globals->findProperty("body", $children[$i]);

					// for reviews
					$extras[count($extras)-1]["rating"] = $this->globals->findProperty("rating", $children[$i]);
				}
			// somehow find if there are any attachments here (to create a thread?)
			}
		}
		return $extras;
	}

	function getId($data){
		$userId = $this->user->authCheck();

		$query = "CALL getSubjectId(?,?);";
		$params = array($data["subjectName"],$userId);
		$this->db = $this->load->database($this->config->item('activegroup'), TRUE); 
 
		$query = $this->db->query($query, $params); 
		$result = $query->result_array(); 

		if (!isset($result)) {
			return false;
		} else {
			return ['id' => $result[0]['subjectId'], 'subjectName' => $data['subjectName']];
		}
	}
	
	/**
	 * Retrieves the subject id for a given subject name. Doesn't check user tables, unlike
	 * the stored procedure getSubjectId()
	 * @param string $name
	 * @return int
	 */
	function findByName($name) {
		$this->db->select("subjectId AS 'id'")
			->from('Subject')
			->where('subjectName', $name);
		$result = $this->db->get();
		if($result->num_rows() > 0) {
			return $result->result_array()[0]["id"];
		} else {
			return false;
		}
	}
	
	/**
	 * Retrieves the subject id for a given subject name and type
	 * @param string $name
	 * @return int
	 */
	function findByNameAndType($name, $type) {
		$this->db->select("subjectId")
			->from('Subject')
			->where('subjectName', $name)
			->where('type', $type);
		$result = $this->db->get();
		if($result->num_rows() > 0) {
			return $result->result_array()[0]["subjectId"];
		} else {
			return false;
		}
	}
	
	function getName($subjectId) {
		$this->db->select('subjectName')
			->from('Subject')
			->where('subjectId', $subjectId);
		$subject = $this->db->get();
		if($subject->num_rows() == 0) {
			return '';
		} else {
			return $subject->first_row('array')["subjectName"];
		}
	}
	function getSubjectDetails($subjectId) {
		$this->db->select('subjectName,description,type')
			->from('Subject')
			->where('subjectId', $subjectId);
		$subject = $this->db->get();
		if($subject->num_rows() == 0) {
			return false;
		} else {
			return $subject->first_row('array');
		}
	}
	
	function getDisplayDetails($subjectId) {
		$this->db->select("s.subjectName AS 'name', s.type, s.description, s.private, s.secondaryColour, t.value AS 'secondaryFontColour'")
			->from('Subject AS s')
			->join('ThemeFontOptions AS t', 't.id = s.secondaryThemeFontOptionId')
			->where('s.subjectId', $subjectId);
		$subject = $this->db->get();
		if($subject->num_rows() == 0) {
			return '';
		} else {
			$result = $subject->first_row('array');
			$result['type'] = $this->getTypeString($result['type']);
			$result['private'] = (boolean)$result['private'];
			$result['attributes'] = $this->subjectAttribute->getSubjectAttributesArray($subjectId);
			$result['visibility'] = $this->subjectAttribute->getForumVisibility($subjectId, $result['private']);
			return $result;
		}
	}
	/*
		Temporary, or otherwise, function motivated by requirement for a little bit more info via an API requst
		than is needed for the Desktop version

		Once in use all over device code, can remove the additions from above...(typeId & get Avatar & colour?)

	*/
	function getDeviceDisplayDetails($subjectId) {

		$this->db->select("s.subjectName AS 'name', s.type, s.description, s.private, s.secondaryColour, t.value AS 'secondaryFontColour'")
			->from('Subject AS s')
			->join('ThemeFontOptions AS t', 't.id = s.secondaryThemeFontOptionId')
			->where('s.subjectId', $subjectId);
		$subject = $this->db->get();
		if($subject->num_rows() == 0) {
			return '';
		} else {
			$result = $subject->first_row('array');
			// added cjt 080817 - needed more than getForumType, but still needed id not string
			$result['typeId'] = $result['type'];
			$result['type'] = $this->getTypeString($result['type']);
			$result['private'] = (boolean)$result['private'];
			$result['avatar'] = (!$result['private']) ? $this->getThirdPartyAvatar($subjectId) : false;
			$result['subd'] = $this->user->isForumSubscribed($subjectId);

			return $result;
		}

	}

	function getType($subjectId) {
		$this->db->select('type')
			->from('Subject')
			->where('subjectId', $subjectId);
		$subject = $this->db->get();
		if($subject->num_rows() == 0) {
			return '';
		} else {
			return $subject->first_row('array')["type"];
		}
	}
	
	function getTypeString($type) {
		switch($type){
			case Group::TYPE_RAMBLUR;
				return 'Ramblur';
				break;
			case Group::TYPE_RELATED:
				return 'Related';
				break;
			case Group::TYPE_BUSINESS:
				return 'Business';
				break;
			case Group::TYPE_GENERAL:
				return 'General';
				break;
			case Group::TYPE_CLUB18:
				return 'Club18';
				break;
			case Group::TYPE_SCHOOLS:
				return 'Schools';
				break;
			default:
				return 'Ramblur';
		}
	}

	function getSubjects() {
		$userId = $this->user->authCheck(); 
		if ($userId == false){return false;}

		$results = array();
		$results["cats"] = array();
		$query = "CALL getSubjects(?);";
		$params = array($userId); 

		$query = $this->db->query($query, $params);
		$result["subs"] = $query->result_array();

		foreach ($result["subs"] as $row) {
			$query = "CALL getCategoryBranch(0,4,?,?);";
			$params = array($row["subjectId"],$userId);
			$query = $this->db->query($query, $params);
			$result["cats"][$row["subjectName"]] = $query->result_array();
		}

		if (!isset($result)) {
			return false;
		} else {
			return($result);
		}
	}
	
	function getCategories($data){
		$userId = $this->user->authCheck(); 
		if($userId == false){return false;}

		if (!is_numeric($data["group"])) {
			$data["group"] = $this->makeSubjectId($data["group"],$userId);
		}

		$results=array();

		$query = "CALL getCategoryBranch(0,30,?,?);"; //cat limit is 38 due to db out of range snv value, but setting max to 30
		$params = array($data["group"],$userId);
		$query = $this->db->query($query, $params);
		$result["cats"] = $query->result_array();

		if (!isset($result)) {
			return false;
		} else {
			return($result);
		}
	}
	
	function setFilter($data) {
		$userId = $this->user->authCheck();
		if($userId == false) {return false;}
		
		$hasAccess = $this->getUserAccess($subjectId, $userId);
		if(!$hasAccess) {return false;}

		if (!is_numeric($data["group"])) {
			$data["group"] = $this->makeSubjectId($data["group"],$userId);
		}

		$query = "UPDATE UserToSubject SET catFilterList=? WHERE userId=? AND subjectId = ?"; 
		$params = array($data["filter"],$userId,$data["group"]); 
		$query = $this->db->query($query, $params);  
		return true;
	}

	function getSocials($data){ 
		$userId = $this->user->authCheck();

		if (!is_numeric($data["group"])) {
			$data["group"] = $this->makeSubjectId($data["group"],$userId);
		}

		$query = "CALL getSocials(?,?);";  
		$params = array($userId,$data["group"]);  

		$query = $this->db->query($query, $params);   
		$result = $query->result_array();   

		if (!isset($result)) {
			return false;
		} else {
			return($result);
		}
	}
	
	// Toggle the 'displayed' flag for a given entry in the db table 'UserToSocial'.

	// When set to false, the display of that particular social following is turned off.
	// The existence of that particular entry in the table is still shown in the drop down menu
	// that can be found in the social feed header.  That menu allows the toggling of 'displayed'
	// for each 'following'.

	function setSocials($data) {

		$userId = $this->user->authCheck();

		if ($userId != false) {
			$this->load->helper(array('htmlpurifier'));
			$query = "CALL setUserToSocial(?,?,?);";
			$params = array(html_purify($data["subjectName"],'post'),html_purify($data["socialName"],'post'),$userId);

			$query = $this->db->query($query, $params);
			$result = $query->result_array();
		}

		if (empty($result)) {
			return false;
		} else {
			return($result[0]['success']);
		}
	}

	function getStickie($id) {
		// Don't need to be authorised
		$this->db->select("id, subjectId, authorId, text")
			->from('Stickies')
			->where('id', $id);
		$result =  $this->db->get();
		if ($result->num_rows() === 1) {
			return $result->first_row('array');
		}
		return null;
	}

	function getStickies($subjectId) {
		$userId = $this->user->authCheck();
		$hasAccess = $this->getUserAccess($subjectId, $userId);
		if(!$hasAccess) {return false;}

		$this->db->select("id, authorId, text")
			->from('Stickies')
			->where('subjectId', $subjectId);
		return $this->db->get()->result_array();
	}
	
	function createStickie($subjectId, $authorId, $text) {
		// authorise before calling this function
		$this->load->helper(array('htmlpurifier'));

		$this->db->insert('Stickies', [
			'subjectId' => $subjectId,
			'authorId' => $authorId,
			'text' => html_purify($text, 'post')
		]);
		return  $this->db->affected_rows() > 0;
	}
	
	function editStickie($id, $text) {
		// authorise before calling this function
		$this->load->helper(array('htmlpurifier'));
		$this->db->update('Stickies', ['text' => html_purify($text,'post')], ['id' => $id]);
		
		return $this->db->affected_rows() > 0;
	}
	
	function deleteStickie($id) {
		// authorise before calling this function
		$this->db->delete('Stickies', ['id' => $id]);
		
		return $this->db->affected_rows() > 0;
	}

	/**
	 * Check user has access to subject.
	 * @param int|string $subjectId
	 * @param int|string $userId
	 * @return boolean
	 */
	function getUserAccess($subjectId, $userId) {
		$accessQuery1 = $this->db->query('CALL checkAccess(?, ?, @access, true)', array($subjectId, $userId));
		$hasAccess1 = $accessQuery1->first_row('array')['access'];
		$accessQuery2 = $this->db->query('CALL checkBanned(?, ?, @access,true)', array($subjectId, $userId));
		$banned = $accessQuery2->first_row('array')['access'];

		return ($hasAccess1 & !$banned);
	}
	
	/**
	 * Allows forum owners (and admin) to remove access for a forum.
	 * Works the same as if a user unfollowed the forum.
	 * 
	 * @param int|string $subjectId
	 * @param int|string $userId
	 * @return boolean
	 */
	function removeUserAccess($subjectId, $userId) {
		$authId = $this->user->authCheck();
		if (!$authId) {
			return false;
		}
		$authType = $this->getUserAccessType($subjectId, $authId);
		if ($authType === 'admin' || $authType === 'owner') {
			if ($this->subject->follow_subject($subjectId, $userId, 0, false)) {
				$forumPrivate = $this->getForumPrivate($subjectId);
				$forumVisibility = $this->subjectAttribute->getForumVisibility($subjectId, $forumPrivate);
				$this->message->systemMessage($authId, $userId, $subjectId, Message::MSG_USER_REMOVED_FROM_FORUM, ['visibility' => $forumVisibility]);
				return true;
			}
		}
		
		return false;
	}

	function getThumbnails($data){

		$userId = $this->user->authCheck();

		$query="CALL getNodeFiles(?,?)";
		$params = array($userId, $data["nodeId"]);
		
		$query = $this->db->query($query, $params);
		$result = $query->result_array();

		if (!isset($result)) {
			return false;
		} else {
			return($result);
		}
	}
	
	/**
	 * Removes thread action buttons for a specific user and subject.
	 * No access control or validation, as this isn't directly accesses by the API,
	 * so make sure has been checked first.
	 */
	function deleteActionButtons($subjectId, $userId) {
		$query = 'DELETE u.*
			FROM UserToPost AS u
			JOIN Post AS p ON p.postId = u.postId
			WHERE u.userId = ? AND p.subjectId = ?';
		
		$query = $this->db->query($query, [$userId, $subjectId]);
	}

	function makeSubjectId($subjectName,$userId){
		$subjectName = str_replace("-"," ",$subjectName);
		$query = "CALL getSubjectId(?,?);";
		$params = array($subjectName,$userId);
		$query = $this->db->query($query, $params);
		$tmp = $query->result_array(); 
		if (!isset($tmp[0]["subjectId"]) || !filter_var($tmp[0]["subjectId"],FILTER_VALIDATE_INT)){
			return false;
		}
		return($tmp[0]["subjectId"]);
	}
	
	/**
	 * Returns a list of user ids for users who moderate the given subject.
	 * 
	 * @param int $subjectId
	 * @return array
	 */
	function getModerators($subjectId) {
		$this->db->select('userId')
			->from('ModeratorToSubject')
			->where(array(
				'subjectId' => $subjectId,
				'approved' => 1,
				'moderator' => 1
			));
		return $this->db->get()->result_array();
	}
	
	/**
	 * Returns a list of user ids for users who supervise the given subject.
	 *
	 * @param int $subjectId
	 * @return array
	 */
	function getSupervisors($subjectId) {
		$this->db->select('userId')
			->from('SupervisorToSubject')
			->where('subjectId', $subjectId);
		return $this->db->get()->result_array();
	}
	
	/**
	 * Returns a list of node ids for posts created by the given user in the given subject.
	 * Useful for moderators.
	 *
	 * @param int $subjectId
	 * @return array
	 */
	function getNewsPosts($userId, $subjectId) {
		$userLevel = $this->user->getUserLevel($userId);
		$this->db->select("n.nodeId AS 'id', n.userId")
			->from('Nodes AS n')
			->join('Post as p', 'p.postId = n.postId')
			->where(array(
				'p.subjectId' => $subjectId,
				'p.postType' => 'newsPost',
				'n.parentNodeId' => 0
			))
			->order_by('p.timeStamp DESC');
		switch ($userLevel) {
			case User::USER_MODERATOR:
				$this->db->where('n.userId', $userId);
				break;
			case User::USER_SUPERVISOR:
			case User::USER_MANAGER:
			case User::USER_ADMIN:
				break;
			default:
				return false;
		}
		return $this->db->get()->result_array();
	}
	
	function getModeratorAdminPosts($subjectId) {
		$this->db->select("u.id")
			->from('UserToAdminPost AS u')
			->join('Post AS p', 'p.postId = u.postId')
			->join('ModeratorToSubject AS s', 's.userId = u.userId')
			->where(array(
				's.subjectId' => $subjectId,
				's.approved' => 1,
				's.moderator' => 1,
				'p.visible' => 1
			))
			->order_by('u.readIt ASC, p.timeStamp DESC');
		return $this->db->get()->result_array();
	}
	
	function getModeratorPendingCount($subjectId) {
		$returnData = array();
		if(is_null($subjectId)) {
			$returnData["adminPosts"] = 0;
			$returnData["reportedPosts"] = 0;
			$returnData["messages"] = 0;
		} else {
			$returnData["adminPosts"] = $this->getModeratorUnacknowlegedAdminPostCount($subjectId);
			$returnData["reportedPosts"] = $this->getModeratorActiveReportedPostCount($subjectId);
			$returnData["messages"] = $this->getUnreadModeratorMessageCount($subjectId);
		}
		return $returnData;
	}
	
	function getModeratorUnacknowlegedAdminPostCount($subjectId) {
		// unacknowledged admin posts for any moderator who managed the given subject
		$adminPostSql = "
			SELECT COUNT(`u`.`postId`) AS 'count'
			FROM `UserToAdminPost` AS `u`
			JOIN `ModeratorToSubject` AS `s` ON `s`.`userId` = `u`.`userId` AND `s`.`approved` = 1 AND `s`.`moderator` = 1
			JOIN `Post` AS `p` ON `p`.`postId` = `u`.`postId`
			WHERE `u`.`readIt` = 0 AND `s`.`subjectId` = ? AND `p`.`visible` = 1
			";
		return $this->db->query($adminPostSql, array($subjectId))->first_row('array')["count"];
	}
	
	function getModeratorActiveReportedPostCount($subjectId) {
		$this->load->model('reported_content');
		return $this->reported_content->getActiveReportedPostCount(null, $subjectId, 'moderator');
	}
	
	function getUnreadModeratorMessageCount($subjectId) {
		$this->load->model('message');
		return $this->message->moderatorMessages('unseen', $this->user->authCheck(), $subjectId, FALSE, TRUE);
	}
	
	
	function getCurrentForumMembers($subjectId, $checkAccessType = true) {
		$userId = $this->user->authCheck();
		if (!$userId) {
			return [];
		}
		
		$this->db->select('userId')
				->from('UserToSubject')
				->where([
				'subjectId' => $subjectId,
				'active' => 1,
				'userId !=' => $userId // Don't include owner
			]);
		return $this->db->get()->result_array();
	}
	
	function getMembers($subjectId) {
		$userId = $this->user->authCheck();
		if (!$userId) {
			return [];
		}
		
		$accessType = $this->getUserAccessType($subjectId, $userId);
		if (!$accessType || !($accessType === 'admin' || $accessType === 'owner')) {
			return [];
		}
		
		$memberData = [];
		$userInfoSelect = "`s`.`userId`,
			IF(`p`.`userNameSearch` = 1, `u`.`userName`, '') AS 'username',
			IF(`p`.`firstNameSearch` = 1, `u`.`firstName`, '') AS 'firstname',
			IF(`p`.`lastNameSearch` = 1, `u`.`lastName`, '') AS 'lastname',
			IF(`p`.`emailSearch` = 1, `u`.`email`, '') AS 'email'";
		
		// Gets all current members
		$this->db->select($userInfoSelect)
			->select("
				IF(`s`.`banned` > UTC_TIMESTAMP, `s`.`banned`, NULL) AS 'banned',
				1 AS 'currentMember'
			", FALSE)
			->from('UserToSubject AS s')
			->join('User AS u', 'u.userId = s.userId')
			->join('Permissions AS p', 'p.userId = u.userId')
			->where([
				's.subjectId' => $subjectId,
				's.active' => 1,
				'p.verified' => 1,
				'p.deleted' => 0,
				'p.suspended' => 0,
				's.userId !=' => $userId // Don't include owner/admin
			])
			// Is this necessary? An owner should be able to see anyone regardless of public permissions?
			->where("(p.userNameSearch = 1 OR p.emailSearch = 1 OR p.firstNameSearch = 1 OR p.lastNameSearch = 1)");
			
		$currentQuery = $this->db->get_compiled_select();
		
		// Gets all past members
		$this->db->select($userInfoSelect)
			->select("0 AS 'banned', 0 AS 'currentMember'")
			->from('UserToSubjectHistory AS s')
			->join ('UserToSubject AS cs', 'cs.userId = s.userId and cs.subjectId = s.subjectId AND cs.active = 1', 'LEFT')
			->join('User AS u', 'u.userId = s.userId')
			->join('Permissions AS p', 'p.userId = u.userId')
			->where([
					's.subjectId' => $subjectId,
					'cs.userId' => NULL,
					'p.verified' => 1,
					'p.deleted' => 0,
					'p.suspended' => 0,
					's.userId !=' => $userId // Don't include owner/admin
			])
			->where("(p.userNameSearch = 1 OR p.emailSearch = 1 OR p.firstNameSearch = 1 OR p.lastNameSearch = 1)");
			
		$pastQuery = $this->db->get_compiled_select();
		
		// Union of both above queries
		$this->db->from("($currentQuery UNION $pastQuery) AS u");
		
		$members = $this->db->get()->result_array();
		foreach($members as $m) {
			if($m['firstname'] !== '' && $m['lastname'] !== '') {
				$displayName = $m['firstname'] . ' ' . $m['lastname'];
			} else if ($m['username'] !== '') {
				$displayName = $m['username'];
			} else if ($m['email'] !== '') {
				$displayName = $m['email'];
			} else if ($m['lastName'] !== '') {
				$displayName = $m['lastname'];
			} else if ($m['firstname'] !== '') {
				$displayName = $m['firstname'];
			}
			if($displayName !== '') {
				$memberData[] = [
					'userId' => $m['userId'],
					'banned' => !is_null($m['banned']),
					'banEnd' => $m['banned'],
					'displayName' => $displayName,
					'currentMember' => (boolean)$m['currentMember']
				];
			}
		}
		usort($memberData, function($a, $b) {
			return strcasecmp($a['displayName'], $b['displayName']);
		});
		return $memberData;
	}
	
	/**
	 * Returns id and name of all subjects found matching the provided search string.
	 * Match can be by name or description.
	 *
	 * @param string $search
	 * @param number $page
	 * @param number $limit
	 * @return array|boolean
	 */
	function search ($search, $page = 0, $limit = 50) {
		$limit = 1 * $limit;
		$page = 1 * $page;
		$query = "
				SELECT `subjectId` as 'id', `subjectName` AS 'name'
				FROM `Subject`
				WHERE `subjectName` LIKE ?
				OR `description` LIKE ?
				ORDER BY `subjectId`
				LIMIT ?,?";
		$search = ('%' . $search . '%');
		$query = $this->db->query($query, array($search, $search, $limit * $page, $limit));
		if($query->num_rows() > 0) {
			foreach($query->result_array() as $row) {
				$result[] = $row;
			}
			return $result;
		} else {
			return false;
		}
	}
	
	function resetHeadNode($headNodeId){

		$query = "select nodeId from Nodes where postId in (select postId from Nodes where nodeId = ?) and nv = 0.0;";

		$query = $this->db->query($query, array($headNodeId));
		if($query->num_rows() > 0) {
			$result = $query->result_array();
			return $result[0]['nodeId'];
		} else {
			return false;
		}
	}

	function getTypeLabel($type) {
		switch ($type) {
			case self::TYPE_BUSINESS:
				return 'business';
				break;
			case self::TYPE_CLUB18:
				return 'club 18';
				break;
			case self::TYPE_GENERAL:
				return 'general';
				break;
			case self::TYPE_RAMBLUR:
				return 'ramblur';
				break;
			case self::TYPE_RELATED:
				return 'related';
				break;
			case self::TYPE_SCHOOLS:
				return 'schools';
				break;
			default:
				return '';
		}
	}

	/**
	 * Returns what sort of access the user has for the given forum. Can be false (no access), 'admin', 'owner' or 'follower'
	 * 
	 * @param int|string $subjectId
	 * @param int|string $userId
	 * @return string|boolean
	 */
	function getUserAccessType($subjectId, $userId) {
		$accessCheck = $this->db->query('CALL checkUser(?, ?, @outParam, true)', [$subjectId, $userId]);
		if($accessCheck->result_array()[0]['valid']) {
			if($this->user->isAdmin($userId)) {
				return 'admin';
			}
			$this->db->select('createdBy')
				->from('Subject')
				->where('subjectId', $subjectId);
			$result = $this->db->get();
			if($result->num_rows() > 0) {
				$owner = $result->first_row('array')['createdBy'];
				return $owner == $userId ? 'owner' : 'follower';
			}
		}
		return false;
	}

	/**
	 * Returns id and name of all subjects found beginning with the provided letter.
	 *
	 * @param string $search
	 * @return array|boolean
	 */
	function searchAtoZ ($search) {

		// setup an array of subscribed groups to compare against later on
		$groups = $this->getSubjects($data=false)['subs'];
		$active_groups = array();
		if(is_array($groups)){
			foreach($groups as $group) {
				array_push($active_groups, $group['subjectId']);
			}
		}
		// figure out which forum types we shouldn't be looking in
		// 9999 = dummy value which will never be matched, and will be the only array item if all forum types are "on"
		// added to reduce the need for a condition to check if not2search was empty
		$not2search = array(9999);
		
		// If user is underage, club18 property won't be included, so add specifically here.
		if (!isset($search['forumsState']['club18'])) {
			$not2search[] = self::TYPE_CLUB18;
		}

		foreach($search['forumsState'] as $k => $v) {

			if($v === 0) {

				switch($k) {

					case 'related':
						array_push($not2search, self::TYPE_RELATED);
						break;

					case 'business':
						array_push($not2search, self::TYPE_BUSINESS);
						break;

					case 'general':
						array_push($not2search, self::TYPE_GENERAL);
						break;

					case 'club18':
						array_push($not2search, self::TYPE_CLUB18);
						break;

				}

			}

		}		

		$this->db->select("subjectId as id, subjectName as name, description, hasOffSpring, type")
			->from('Subject')
			->like('subjectName', trim($search['letter']), 'after')
			->where(array(
				'private' => 0,
				'parentSubjectId' => 1,
				'visible' => 1
			))
			->where('subjectId != 714')
			->where_not_in('type', $not2search)
			->order_by('subjectName', 'ASC');
		$result = $this->db->get();

		if ($result->num_rows()>0){

			$data = array();

			foreach ($result->result_array() as $row) {

				// pass back subscription info for status display purposes
				$row['isSubscribed'] = (in_array($row['id'], $active_groups)) ? '1' : '0';
				// Can't be private, as above query filters them out
				$row['visibility'] = $this->subjectAttribute->getForumVisibility($row['id'], false);
				$row['attributes'] = $this->subjectAttribute->getSubjectAttributesArray($row['id']);
				array_push($data, $row);

			}

			return $data;

		}
		return false;

	}

	/**
	 * Returns all subjects that are sub-subjects by level (not sure how useful level will be...)
	 *
	 * @param array $subjectData
	 * @return array|boolean
	 */
	function displaySubTopicsByLevel($subjectData){

		$userId = $this->user->authCheck();
		$subjectId = $subjectData['subjectId'];
		$otherTypeBlocked = false;

		//print_r($subjectData);

		// figure out which forum types we shouldn't be looking in
		// 9999 = dummy value which will never be matched, and will be the only array item if all forum types are "on"
		// added to reduce the need for a condition to check if not2search was empty
		$not2search = array(9999);

		foreach($subjectData['forumsState'] as $k => $v) {

			if($v === 0) {

				switch($k) {

					case 'related':
						array_push($not2search, self::TYPE_RELATED);
						break;

					case 'business':
						array_push($not2search, self::TYPE_BUSINESS);
						break;

					/*case 'general':
						array_push($not2search, 3);
						break;

					case 'club18':
						array_push($not2search, 4);
						break;*/

				}

			}

		}

		// setup an array of subscribed groups to compare against later on
		$groups = $this->getSubjects($data=false)['subs'];
		$active_groups = array();
		foreach($groups as $group) array_push($active_groups, $group['subjectId']);

		// NEW CHECK 1: are there any groups in this subject for RELATED or BUSINESS
		$sql = "SELECT count(*) AS count FROM Subject WHERE parentSubjectId = ? AND type IN (1, 2) AND private = 0 AND visible = 1 AND type NOT IN (".implode(',', $not2search).")";
		$params = array($subjectId);
		
		if ($sql = $this->db->query($sql, $params)) {

			$result = $sql->row();

			// there *are* RELATED or BUSINESS sub-forums in this forum
			// return whichever other forum types are applicable and ramblur forum?
			if ($result->count > 0) {

				// basically re-run the above query to include 0 (ramblur type) so that we get the correct id for further ahead
				$sql = "SELECT subjectId as id, subjectName as name, description, hasOffSpring, parentSubjectId as parent, type FROM Subject WHERE parentSubjectId = ? AND type IN (0, 1, 2) AND private = 0 AND visible = 1 AND type NOT IN (".implode(',', $not2search).")";
				$params = array($subjectId);

				if ($sql = $this->db->query($sql, $params)) {

					$result = $sql->result_array();

					$scdata = array();

					foreach ($result as $row) {

						// pass back subscription info for status display purposes
						$row['isSubscribed'] = (in_array($row['id'], $active_groups)) ? '1' : '0';
						// Can't be private, as above query filters them out
						$row['visibility'] = $this->subjectAttribute->getForumVisibility($row['id'], false);
						$row['attributes'] = $this->subjectAttribute->getSubjectAttributesArray($row['id']);
						array_push($scdata, $row);

					}

					$scdata["otherType"] = 1;
					return $scdata;

				}
				return false;

			// ONLY ramblur forums listed
			} else {

				// if the call to get child groups was from an "other type", get the parent subject id and adjust the query to include the parent forum
				// EG:

				/*

				"id"	"name"				"description"	"hasOffSpring"	"parent"	"type"

				"103"	"boats"				" "				"1"				"1"			"0"
				"105"	"boat building"		" "				"0"				"686"		"0"
				"106"	"motorboats"		" "				"0"				"686"		"0"
				"107"	"sailboats"			" "				"1"				"686"		"0"
				"104"	"super yachts"		" "				"0"				"686"		"0"

				*/

				/* IDEA to display all ramblur forums only, with no heading, if related & business forum types have been hidden by user (ie. not2search entry = 1)

					we're here because there are no "other forum types" to display (rel/bus) and in this scenario they've been hidden by user

					so.

					set a flag here...? how?

					then get subjectId of the "ramblur forums" forum for this subject (eg. 686 for ramblur forums for boats, 103)

					what do we know/not know and when/how:

					we know parensubjectid 103

					we dont yet know the ramblur groups parentid 686

					how do we know we need to get the 686 id for a new qry? SET A FLAG looking for not2search values for related/business?  if either or both (?? not sure if either or both yet) set a flag that says "we need all ramblue forums using both 103 and 686, having found out that 686 = 686"

					NB: Level also needs an increment, as level 2 forums are now level 3 AFAICT


				*/

				//print_r($not2search);		

				$i=0;			

				foreach ($not2search as $k => $v) {

					if($v==1 || $v==2) $i++;

				}
				if($i>0) $otherTypeBlocked = true;

				// without the parentSubjectId (103) we don't get "boats" as it's parentId is different now it's in a "ramblur forums" group...

				if (isset($subjectData['otherType']) && $subjectData['otherType'] == 1) {

					$parentSubjectId = $this->getParentSubjectId($subjectId);

					$sql = "SELECT subjectId as id, subjectName as name, description, hasOffSpring, parentSubjectId as parent, type FROM Subject WHERE (parentSubjectId = ? AND level = ? || subjectId = ?) AND private = 0 AND visible = 1 AND type NOT IN (".implode(',', $not2search).") ORDER BY parentSubjectId ASC, subjectName ASC";
					$params = array($subjectId, $subjectData['level'], $parentSubjectId);

				} else if ($otherTypeBlocked) {

					// get 686 from 103
					// get 691 from 107
					$ramblurForumId = $this->getRamblurForumId($subjectId);

					//echo "--- i: ".$i;
					//echo "--- rfid: ".$ramblurForumId;
					//echo "--- sid: ".$subjectId;

					if($ramblurForumId === $subjectId && $i === 2) {
						$newSubjectLevel = intval($subjectData['level']) + 2; // 2? works for all???
					} else if ($ramblurForumId === $subjectId && $i === 1) {
						$newSubjectLevel = $subjectData['level'];
					} else $newSubjectLevel = $this->getNewSubjectLevel($subjectData['level']);

					$sql = "SELECT subjectId as id, subjectName as name, description, hasOffSpring, parentSubjectId as parent, type FROM Subject WHERE (parentSubjectId = ? AND level = ? || subjectId = ?) AND private = 0 AND visible = 1 AND type NOT IN (".implode(',', $not2search).") AND subjectName NOT IN ('club18', 'general forums') ORDER BY parentSubjectId ASC, subjectName ASC";				
					$params = array($ramblurForumId, $newSubjectLevel, $subjectId);

				} else {

					// added kwik kludge to remove "self-named" groups from result set
					$sql = "SELECT subjectId as id, subjectName as name, description, hasOffSpring, parentSubjectId as parent, type FROM Subject WHERE (parentSubjectId = ? AND level = ? || subjectId = ?) AND private = 0 AND visible = 1 AND type NOT IN (".implode(',', $not2search).") AND subjectName NOT IN ('club18', 'general forums') ORDER BY parentSubjectId ASC, subjectName ASC";
					$params = array($subjectId, $subjectData['level'], $subjectId);

				}

	            if ($sql = $this->db->query($sql, $params)) {

					if ($sql->num_rows() > 0) {

		                $result = $sql->result_array();

						$scdata = array();

						foreach ($result as $row) {

							// if we're in "otherType" mode (see above) and id === parentSubjectId - change hasOffSpring to 0 so that toggle icon doesn't display in DOM
							if ((isset($subjectData['otherType']) && $subjectData['otherType'] == 1) && $row['id'] == $parentSubjectId) {
								$row['hasOffSpring'] = '0';
							}

							// pass back subscription info for status display purposes
							$row['isSubscribed'] = (in_array($row['id'], $active_groups)) ? '1' : '0';
							// Can't be private, as above query filters them out
							$row['visibility'] = $this->subjectAttribute->getForumVisibility($row['id'], false);
							$row['attributes'] = $this->subjectAttribute->getSubjectAttributesArray($row['id']);
							array_push($scdata, $row);

						}
						$scdata["otherType"] = 0;
						return $scdata;

					}
					return false;
	                
	            }
	            return false;

			}



		}
		return false;

		// query adjusted to include the parent subject so that it can be "tickable" on the page and info about whether it's grouped or not
		// REMOVED BECAUSE NOT SURE WHY UserToSubject EVEN NEEDED TO BE INVOLVED.....
		//$query = $ln->prepare("SELECT s.subjectId as id, s.subjectName as name, s.description, s.hasOffSpring, s.parentSubjectId as parent, u.grouped, u.allSelected, s.type FROM subject as s, usertosubject as u WHERE (s.parentSubjectId = ? AND s.level = ? || s.subjectId = ?) AND s.private = 0 AND s.visible = 1 AND s.subjectId = u.subjectId AND u.userId = ? AND type NOT IN (".implode(',', $not2search).") ORDER BY s.parentSubjectId ASC, s.subjectName ASC");

		/*		// replacement query for above - just get the info from Subject
		$this->db->select("subjectId as id, subjectName as name, description, hasOffSpring, parentSubjectId as parent, type")
			->from('Subject')
			->where("(parentSubjectId = {$subjectData['subjectId']} AND level = {$subjectData['level']} OR subjectId = {$subjectData['subjectId']})")
			->where(array(
				'private' => 0,
				'visible' => 0
			))
			->where_not_in('type', $not2search)
			->order_by('parentSubjectId ASC, subjectName ASC');
		$result = $this->db->get();

		if ($result->num_rows()>0){*/

	}

	function getForumType ($subjectId, $returnLabel) { // test this with a failure!!!!!!!!!!!!!
		$userId = $this->user->authCheck();

		$hasAccess = $this->getUserAccess($subjectId, $userId);

		if(!$hasAccess){return false;}

		$this->db->select('type')->from('Subject')->where('subjectId', $subjectId);
		$res = $this->db->get()->row();
		$type = $res->type;

		if ($returnLabel) {
			return $this->getTypeLabel($type);
		} else {
			return $type;
		}

	}
	
	function getForumPrivate($subjectId) {
		$this->db->select('private')
			->from('Subject')
			->where('subjectId', $subjectId);
		$forum = $this->db->get();
		if ($forum->num_rows() === 0) {
			return null; // since privacy is boolean, return null instead of false for not found
		}
		return (boolean)$forum->first_row('array')['private'];
	}
	
	public function getPrivateForums() {
		
		if(!$this->user->adminCheck()) {
			return false;
			
		}
		
		$privateForums = [];
		
		$this->db->select('subjectId')
				->from('Subject')
				->where('private', 1)
				->where('visible', 1);
		
		$query = $this->db->get();
		if ($query->num_rows() > 0) {
			foreach ($query->result_array() as $f) {
				$privateForums[] = $f['subjectId'];
			}
			return $privateForums;
		}
		return null;
	}
	
	function getDefaultThemeColourOption() {
		if (is_null($this->defaultThemeColourOption)) {
			$this->db->select('id, value')
				->from('ThemeColourOptions')
				->where('isDefault', 1);
			$theme = $this->db->get();
			if ($theme->num_rows() > 0) {
				$this->defaultThemeColourOption = $theme->first_row('array');
			} else {
				// Should light be hardcoded here? Should never get here, as the db needs to be maintained
				// to have the value, so probably a moot point
				$this->defaultThemeColourOption = ['id' => 0, 'value' => 'light'];
			}
		}
		return $this->defaultThemeColourOption;
	}
	
	function getDefaultThemeFontOption() {
		if (is_null($this->defaultThemeFontOption)) {
			$this->db->select('id, value')
				->from('ThemeFontOptions')
				->where('isDefault', 1);
			$theme = $this->db->get();
			if ($theme->num_rows() > 0) {
				$this->defaultThemeFontOption = $theme->first_row('array');
			} else {
				// Should font colour be hardcoded here? Should never get here, as the db needs to be maintained
				// to have the value, so probably a moot point
				$this->defaultThemeFontOption = ['id' => 0, 'value' => '#FFFFFF'];
			}
		}
		return $this->defaultThemeFontOption;
	}

	function getBasicThreadData ($postId, $subjectId) {

		//echo $postId;
                $userId = $this->user->authCheck();

		$hasAccess = $this->getUserAccess($subjectId, $userId);

		if(!$hasAccess){return false;}

		if(is_numeric($postId)) {

			$sql = "SELECT p.postType as 'type', p.subjectId as 'group', n.nodeId as 'node', s.type as 'forumType' FROM Post p, Nodes n, Subject s WHERE p.postId = n.postId AND p.subjectId = s.subjectId AND n.postId = ? AND p.subjectId = ? AND n.parentNodeId = 0 AND p.visible = 1";
			$params = array($postId, $subjectId);
			$sql = $this->db->query($sql, $params);

			if ($sql->num_rows()===1) {

				return $result = $sql->row_array();

			}
			return false;

		}
		return false;

	}

	// get the parentSubjectId of the "parent" calling forum, which no longer has the parentId of the "other" forum type
	function getParentSubjectId ($subjectId) {

		$sql = "SELECT parentSubjectId FROM Subject WHERE subjectId = ?";
		$params = array($subjectId);

		if ($sql = $this->db->query($sql, $params)) {

			$result = $sql->row_array();
			return $result['parentSubjectId'];

		}
		return false;

	}

	// get the something id from something else to get something....ptwee boing papa
	function getRamblurForumId ($parentSubjectId) {

		$sql = "SELECT subjectId FROM Subject WHERE parentSubjectId = ? AND subjectName = 'ramblur forums'";
		$params = array($parentSubjectId);

		if ($sql = $this->db->query($sql, $params)) {

			if($sql->num_rows() > 0) {

				$result = $sql->row_array();
				return $result['subjectId'];

			} else return $parentSubjectId;// if this fails, it means there's no 'ramblur forums' forum available, so just return the argument back!

		}
		return false;

	}

	// structure of Subject table changed, related to groups (ramblur/bus/rel), so need to know what new level numbers will be
	function getNewSubjectLevel ($level) {

		switch($level) {

			case 1: // don't think this will ever apply....
				$nl = 1;
				break;

			case 2:
				$nl = 3;
				break;

			case 3:
				$nl = 5;
				break;

			case 4:
				$nl = 7;
				break;

		}

		return $nl;

	}


	/**
	 * Returns node information for that feed type
	 *
	 * @param array $data
	 * @return array|boolean
	 */

	function loadFeed($data) {

		//var_dump($data);

		$userId = $this->user->authCheck();

		if(!isset($data["offset"]) || !filter_var($data["offset"],FILTER_VALIDATE_INT)) $data["offset"] = 0;
		if(!isset($data["limit"])) $data["limit"] = 20;

		if (!is_numeric($data["group"])) $data["group"] = $this->makeSubjectId($data["group"], $userId);
		
		if ($data["group"] == -1){
			return [];
		}
		
		// Kludge workaround for mobile not sending main feed group id properly
		if ($data['group'] === 0) {
			$data['group'] = $this->findByNameAndType('main feed', self::TYPE_RAMBLUR);
		}
		
		// Check access permissions for private forums
		if (!$this->getUserAccess($data["group"], $userId)){
			return [];
		}

		$feed = array();

		switch($data['type']){

			case "social":
				
				$feed["nodes"] = $this->feedSocial($data["group"], $data['offset'], $data['limit'], $userId, true);
				break;

			case "currentTopics":
			case "currentTopics2": // <<<< when "Most Viewed" selected
			case "currentTopicsSearch": // when a search is being done
			case "currentTopics2Search":  // when a search is being done with 'Most Viewed' selected
				// true = "this is a device, i need some extra info"

				$type = (substr($data['type'], 0, strlen('currentTopics2') === 'currentTopics2'))
				? 'mostViewed' : 'mostRecent';

				$feed["nodes"] = $this->feedCurrentTopics($data["group"], $type, $userId, true, (isset($data['filter'])) ? $data['filter'] : false, (isset($data['ctSearch'])) ? $data['ctSearch'] : false, $data['limit'], $data['offset']);
				break;
				
			case "home":
				$feed["nodes"] = $this->feedQuestionsPosts2($data["type"], $data['limit'], $data['offset'], true);
				break;

			case "main":
				// true = "this is a phone/tablet, i need some extra info in my object"
				// feedQuestionsPosts2 - used because feedQuestionsPosts had changed significantly - quicker to shoehorn this in first
				$feed["nodes"] = $this->feedQuestionsPosts2($data["type"], $data['limit'], $data['offset'], true);
				break;

			case "post":
				// true = "this is a phone/tablet, i need some extra info in my object"
				// feedQuestionsPosts2 - used because feedQuestionsPosts had changed significantly - quicker to shoehorn this in first
				$feed["nodes"] = $this->feedQuestionsPosts2($data["group"], $data['limit'], $data['offset'], true);
				break;

			case "comment":

				//print_r($data);
				//exit;
				$feed = $this->feed($data);

				foreach($feed['nodes'] as $k => $node) {

					$feed['nodes'][$k]['info'] = $this->node->info($node['nodeId']);
					// is user a super user
					$feed['nodes'][$k]['info']['isMod'] = ($this->user->canManageSubject($feed['nodes'][$k]['info']['userId'], $node['subjectId'])) ? 1 : 0;
					// passes userId of owner and subjectId - gets an array
					$feed['nodes'][$k]['statuses'] = $this->node->iconStatuses($feed['nodes'][$k]['info']['userId'], $node['subjectId'], $node['nodeId'], $node['id']);

				}

				break;

			default:
				$feed = "Feed data failed to load [ElF01]";
				break;

		}

		$feed["forumAvatar"] = $this->getThirdPartyAvatar($data["group"]);
		return $feed;

	}

	// for AJAXy zing retrieval (and original node) - added cjt
	// former vars: $postId, $headNodeId, $userId, $threadType, scrollNodeId
	// $data contains about 6 properties, but only zingNode is required for this first query, then getBranch
	// i've left them in for laziness/convenenience/ease
	function nodeWithZings($data) {

        $userId = $this->user->authCheck();

		$query = "SELECT subjectId FROM Post Join Nodes ON Post.postId = Nodes.postId WHERE nodeId = ?;";

		$params = array($data['zingNode']);
		$query = $this->db->query($query, $params);
		$tmp = $query->result_array(); 
		if(filter_var($tmp[0]['subjectId'],FILTER_VALIDATE_INT)==false){
		  return false;
		}

		$hasAccess = $this->getUserAccess($tmp[0]['subjectId'], $userId);

		if(!$hasAccess){return false;}

		//print_r($data);

		/****************************

		SURELY THIS JUST NEEDS TO RETURN A 'BRANCH' WHATEVER THE TYPE????  NO NEED FOR CONDITIONS...mn: I like the white listing that it provides...

		*****************************/

		if($data['threadType'] == "post" || $data['threadType'] == "question" || $data['threadType'] == "subscription" || $data['threadType'] == "article" || $data['threadType'] == "blog" || $data['threadType']=="review"|| $data['threadType']=="event" || $data['threadType'] == "vlog" || $data['threadType'] == 'comment'){

		    $query="SELECT Subject.subjectName, Subject.subjectId, Post.postId,User.userId,Nodes.nodeId AS 'id', "
					. "postType AS 'type',Post.title, timeStamp AS 'created',startTime,endTime,Post.timezone,userName,countryId AS 'country', "
					. "gender,age,avatar, User.timeZone AS userTimezone, text AS 'body',Nodes.hasOffSpring, tick AS 'ticked', "
					. "Post.userId AS 'threadOwner', score, parentNodeId,lastEdit,reason, Nodes.visible, author,aboutAuthor, "
					. "cat.name AS catName, cat.level AS catLevel "
					. "FROM Subject "
					. "JOIN Post ON Post.subjectId = Subject.subjectId "
					. "LEFT JOIN Category AS cat on cat.categoryId = Post.categoryId "
					. "LEFT JOIN Nodes ON Post.postId = Nodes.postId "
					. "JOIN User ON User.userId = Nodes.userId WHERE Nodes.nodeId = ? AND Post.visible = TRUE AND Post.subjectId = Subject.subjectId AND ?=true;";
		  //$query = "SELECT Subject.subjectName, Subject.subjectId, Post.postId,User.userId,Nodes.nodeId AS 'id',postType AS 'type',Post.title, timeStamp AS 'created',startTime,endTime,userName,Country.countryId AS 'country',gender,age,avatar, text AS 'body',Nodes.hasOffSpring, tick AS 'ticked',Post.userId AS 'threadOwner', score, parentNodeId,lastEdit,reason, Nodes.visible, author,aboutAuthor FROM Subject, Post LEFT JOIN Nodes ON Post.postId = Nodes.postId,User JOIN Country ON Country.countryId = User.countryId WHERE nodeId = ? AND Post.visible = TRUE AND User.userId IN (SELECT userId FROM Nodes WHERE nodeId = ?) AND Post.subjectId = Subject.subjectId;";

		    $params = array($data['zingNode'], $hasAccess);
		    $query = $this->db->query($query, $params);
		    $tmp = $query->result_array(); 

		    if (!isset($tmp[0]["avatar"])) {
				// filler avatar
				$tmp[0]["avatar"] = '';
		    } else $tmp[0]["avatar"]= $tmp[0]["avatar"] . '-avatar';

			// needed to unify mobile code for two separate cases - make this conditional on being invoked by phone?
			$tmp[0]["statuses"] = $this->node->iconStatuses($tmp[0]["userId"], $tmp[0]["subjectId"], $tmp[0]['id'], $tmp[0]['postId']);

			// some user settings
		    $query1 = "
		    	SELECT 
				t.value AS 'theme',
				IF(u.opacity IS NULL, s.opacity, u.opacity)  AS 'opacity',
				IF(u.primaryColour IS NULL, s.primaryColour, u.primaryColour)  AS 'primaryColour',
				IF(u.secondaryColour IS NULL, s.secondaryColour, u.secondaryColour)  AS 'secondaryColour',
				fp.value AS 'primaryFontColour',
				fs.value AS 'secondaryFontColour'
				FROM 
				Subject AS s
				LEFT JOIN UserToSubject u ON u.subjectId = s.subjectId AND u.userId = ? 
				JOIN ThemeColourOptions AS t ON t.id = IF(u.themeColourOptionId IS NULL, s.themeColourOptionId, u.themeColourOptionId)
				JOIN ThemeFontOptions AS fp ON fp.id = IF(u.primaryThemeFontOptionId IS NULL, s.primaryThemeFontOptionId, u.primaryThemeFontOptionId)
				JOIN ThemeFontOptions AS fs ON fs.id = IF(u.secondaryThemeFontOptionId IS NULL, s.secondaryThemeFontOptionId, u.secondaryThemeFontOptionId)
				WHERE s.subjectName = ? AND ? = true
		    ";
		    if(isset($data['userId']) && $data['userId'] != ''){
		      $params1 = array($data['userId'], $tmp[0]["subjectName"],$hasAccess);
		    } else $params1 = array(null, $tmp[0]["subjectName"]);

		    $query1 = $this->db->query($query1, $params1);
		    $tmp2 = $query1->result_array(); 

		    foreach($tmp2 as $row){

				$theme = $row["theme"];
				$opacity = $row["opacity"];
				$primaryColour = $row["primaryColour"];
				$secondaryColour = $row["secondaryColour"];
				$primaryFontColour = $row["primaryFontColour"];
				$secondaryFontColour = $row["secondaryFontColour"];
		    } 

		    if(!isset($theme)){$tmp[0]["theme"] = $this->getDefaultThemeColourOption()['value'];}else{$tmp[0]["theme"] = $theme;}
		    if(!isset($opacity)){$tmp[0]["opacity"] = self::DEFAULT_OPACITY;}else{$tmp[0]["opacity"] = $opacity;}
		    if(!isset($primaryColour)){$tmp[0]["primaryColour"] = self::DEFAULT_PRIMARYCOLOUR;}else{$tmp[0]["primaryColour"] = $primaryColour;}
		    if(!isset($secondaryColour)){$tmp[0]["secondaryColour"] = self::DEFAULT_SECONDARYCOLOUR;}else{$tmp[0]["secondaryColour"] = $secondaryColour;}
		    if(!isset($primaryFontColour)){$tmp[0]["primaryFontColour"] = $this->getDefaultThemeFontOption()['value'];}else{$tmp[0]["primaryFontColour"] = $primaryFontColour;}
		    if(!isset($secondaryFontColour)){$tmp[0]["secondaryFontColour"] = $this->getDefaultThemeFontOption()['value'];}else{$tmp[0]["secondaryFontColour"] = $secondaryFontColour;}

		    $query="SELECT nodeId AS 'zeroNode' FROM Nodes WHERE postId = ? and parentNodeId=0";
		    $params = array($tmp[0]["postId"]);
		    $query = $this->db->query($query, $params); 
		    $tmp1=$query->result_array();

		    $tmp[0]["zeroNode"] = $tmp1[0]["zeroNode"];

		    $query="SELECT COUNT(nodeId) AS 'replies' FROM Nodes WHERE postId = ?";
		    $params = array($tmp[0]["postId"]);
		    $query = $this->db->query($query, $params); 
		    $tmp1=$query->result_array();

		    $tmp[0]["replies"] = $tmp1[0]["replies"] - 1;

		    $query="SELECT numViews FROM Post WHERE postId = ?";
		    $params = array($tmp[0]["postId"]);
		    $query = $this->db->query($query, $params); 
		    $tmp1=$query->result_array();

		    $tmp[0]["numViews"] = $tmp1[0]["numViews"];

			if($tmp[0]["type"] == "article" || $tmp[0]["type"] == "event" || $tmp[0]["type"] == "blog" || $tmp[0]["type"] == "vlog" || $tmp[0]["type"] == "review"){

				$tmp[0]["subs"] = $this->post->getSubscribedCount($tmp[0]['postId'], $tmp[0]['type']);
				$tmp[0]["subscribed"] = $this->post->getSubscribed($tmp[0]['postId'], $userId, $tmp[0]['type']);
			}

			$query="SELECT thumbsUp FROM Votes WHERE userId = ? AND nodeId = ?";
			$params = array($data['userId'],$tmp[0]["id"]);
			$query = $this->db->query($query, $params); 
			$tmp1=$query->result_array();
			if(isset($tmp1[0]["thumbsUp"]) && $tmp1[0]["thumbsUp"] == true){
				$tmp[0]["liked"] = $tmp1[0]["thumbsUp"];
			} else $tmp[0]["liked"] = false;

			//$query1="SELECT userTitle as 'title',description,URL as 'url',numViews, ContentToNodes.fileName as 'post', ContentToNodes.fileName as 'original',fileType as 'type',nodeId as 'node',timeStamp FROM ContentToNodes JOIN Content ON ContentToNodes.fileName = Content.fileName where nodeId = ? ORDER BY timeStamp";

			// GET PRIVATE STATUS ABOVE TOO!

			//$params = array($data['zingNode']);
			//$query1 = $this->db->query($query1, $params);
			//foreach($query1->result_array() as $row) $tmp[0]["attachments"][] = $row;

			/*$query2 = "CALL getNodeFiles(?,?);"; 
			$params = array($userId,$data['zingNode']);
			$query2 = $this->db->query($query2, $params);

			if ( $query2->num_rows() > 0 ) {
				$tmp[0]["attachments"] = $query2->result_array();
			}*/

			// also get node::info
			$tmp[0]["info"] = $this->node->info($data['zingNode']);

			// and are we subscribed info
			// this returns '0' for not logged in, so will work onwards in js
			$tmp[0]["isSubd"] = $this->user->isForumSubscribed($tmp[0]["subjectId"]);

			// depth adjustment if a comment thread
			$depthToRetrieve = ($data['threadType']==='comment') ? 3 : 4;

			$query11="Call getBranch(?, ?, ?, ?, 1000000);";
			$params11 = array($data['zingNode'], $depthToRetrieve, $data['postId'], $data['userId']);

			$query11 = $this->db->query($query11, $params11);

			//mysqli_next_result($this->db->conn_id); // added cjt

			$tmp[0]["children"] = $query11->result_array();
	  
		    for($i =0;$i<count($tmp[0]["children"]);$i++){

		      $tmp[0]["children"][$i]["theme"] = $theme;
		      $tmp[0]["children"][$i]["opacity"] = $opacity;
		      $tmp[0]["children"][$i]["primaryColour"] = $primaryColour;
		      $tmp[0]["children"][$i]["secondaryColour"] = $secondaryColour;
		      $tmp[0]["children"][$i]["primaryFontColour"] = $primaryFontColour;
		      $tmp[0]["children"][$i]["secondaryFontColour"] = $secondaryFontColour;
		      $tmp[0]["children"][$i]["threadTypeId"] = $data['threadType'];
		      $tmp[0]["children"][$i]["scrollNodeId"] = $data['scrollNodeId'];
		      // added - cjt
		      // needed to unify mobile code for two separate cases - make this conditional on being invoked by phone?
		      $tmp[0]["children"][$i]["statuses"] = $this->node->iconStatuses($tmp[0]["children"][$i]["userId"], $tmp[0]["children"][$i]["subjectId"], $tmp[0]["children"][$i]['id'], $tmp[0]['postId']);

		      $query="SELECT thumbsUp FROM Votes WHERE userId = ? AND nodeId = ?";
		      $params = array($data['userId'], $tmp[0]["children"][$i]["id"]);
		      $query = $this->db->query($query, $params); 
		      $tmp22 = $query->result_array();

				if(isset($tmp22[0]["thumbsUp"]) && $tmp22[0]["thumbsUp"] == true){
					$tmp[0]["children"][$i]["liked"] = $tmp22[0]["thumbsUp"];
				} else $tmp[0]["children"][$i]["liked"] = false;

				$query1="SELECT userId,userTitle as 'title',description,URL as 'url',ContentToNodes.fileName as 'post', ContentToNodes.fileName as 'original',fileType as 'type', nodeId as 'node', timeStamp FROM ContentToNodes JOIN Content ON ContentToNodes.fileName = Content.fileName where nodeId = ? ORDER BY timeStamp";
				$params1 = array($tmp[0]["children"][$i]['id']);
				$query1 = $this->db->query($query1, $params1);
				$tmp2 = $query1->result_array();

				foreach($tmp2 as $row) $tmp[0]["children"][$i]["attachments"][] = $row;

		    }

		} else if ($data['threadType'] == 'social'  || $data['threadType'] == 'currentTopics') {

		    $query = "SELECT Post.subjectId,Post.postId,User.userId,Nodes.nodeId AS 'id',postType AS 'type',datetime AS 'created',userName,Country.countryId AS 'country',gender,age,avatar,title AS 'subject', text AS 'body',Nodes.level - ".$zingLevel * ($numZings+1) ." AS 'depth',Nodes.hasOffSpring, tick as 'ticked',Post.userId AS 'threadOwner',score, parentNodeId, lastEdit, reason, Nodes.visible,author,aboutAuthor FROM Nodes JOIN Post on Nodes.postId = Post.postId JOIN User ON Nodes.userID = User.userID JOIN Country ON Country.countryId = User.countryId where nodeId = ?;"; 
		    $params = array($data['headNodeId']);                  
		    $query = $this->db->query($query, $params); 
		    $tmp=$query->result_array();

			$query = "
				SELECT
				s.subjectName
				t.value AS 'theme',
				IF(u.opacity IS NULL, s.opacity, u.opacity)  AS 'opacity',
				IF(u.primaryColour IS NULL, s.primaryColour, u.primaryColour)  AS 'primaryColour',
				IF(u.secondaryColour IS NULL, s.secondaryColour, u.secondaryColour)  AS 'secondaryColour',
				fp.value AS 'primaryFontColour',
				fs.value AS 'secondaryFontColour'
				FROM
				Subject AS s
				LEFT JOIN UserToSubject u ON u.subjectId = s.subjectId AND u.userId = ?
				JOIN ThemeColourOptions AS t ON t.id = IF(u.themeColourOptionId IS NULL, s.themeColourOptionId, u.themeColourOptionId)
				JOIN ThemeFontOptions AS fp ON fp.id = IF(u.primaryThemeFontOptionId IS NULL, s.primaryThemeFontOptionId, u.primaryThemeFontOptionId)
				JOIN ThemeFontOptions AS fs ON fs.id = IF(u.secondaryThemeFontOptionId IS NULL, s.secondaryThemeFontOptionId, u.secondaryThemeFontOptionId)
				WHERE s.subjectId = ?
			";
			if(isset($data['userId']) && $data['userId'] != ''){
				$params=array($data['userId'], $tmp[0]["subjectId"]);
			} else $params=array(null, $tmp[0]["subjectId"]);
			$query = $this->db->query($query, $params); 
			$tmp1=$query->result_array();

			$tmp[0]["subjectName"] = $tmp1[0]["subjectName"];
			$tmp[0]["theme"] = $tmp1[0]["theme"];
			$tmp[0]["opacity"] = $tmp1[0]["opacity"];
			$tmp[0]["primaryColour"] = $tmp1[0]["primaryColour"];
			$tmp[0]["secondaryColour"] = $tmp1[0]["secondaryColour"];
			$tmp[0]["primaryFontColour"] = $tmp1[0]["primaryFontColour"];
			$tmp[0]["secondaryFontColour"] = $tmp1[0]["secondaryFontColour"];

			$query="SELECT nodeId AS 'zeroNode' FROM Nodes WHERE postId = ? and parentNodeId=0";
			$params=array($tmp[0]["postId"]);
			$query = $this->db->query($query, $params); 
			$tmp1=$query->result_array();

			$tmp[0]["zeroNode"] = $tmp1[0]["zeroNode"];

            $query="SELECT COUNT(nodeId) AS 'replies' FROM Nodes WHERE postId = ?"; 
            $params=array($tmp[0]["postId"]); 
            $query = $this->db->query($query, $params);  
            $tmp1=$query->result_array(); 
 
            $tmp[0]["replies"] = $tmp1[0]["replies"] - 1; 
 
            $query="SELECT numViews FROM Post WHERE postId = ?"; 
            $params=array($tmp[0]["postId"]); 
            $query = $this->db->query($query, $params);  
            $tmp1=$query->result_array(); 
 
            $tmp[0]["numViews"] = $tmp1[0]["numViews"]; 

            $query="SELECT thumbsUp FROM Votes WHERE userId = ? AND nodeId = ?"; 
            $params=array($data['userId'],$tmp[0]["id"]); 
            $query = $this->db->query($query, $params);  
            $tmp1=$query->result_array();

            if(isset($tmp1[0]["thumbsUp"]) && $tmp1[0]["thumbsUp"] == true){ 
              $tmp[0]["liked"] = $tmp1[0]["thumbsUp"]; 
            } else $tmp[0]["liked"] = false;

			//$query1="SELECT userTitle as 'title',description,URL as 'url',numViews, ContentToNodes.fileName as 'post', ContentToNodes.fileName as 'original',fileType as 'type', nodeId as 'node',timeStamp FROM ContentToNodes JOIN Content ON ContentToNodes.fileName = Content.fileName where nodeId = ? ORDER BY timeStamp"; 
			//$params=array($tmp[0]['id']); 
			//$params = array($data['headNodeId']); 
			//$query1 = $this->db->query($query1, $params); 
			//foreach($query1->result_array() as $row) $tmp[0]["attachments"][] = $row;

			$query2 = "CALL getNodeFiles(?,?);"; 
			$params = array($userId,$data['zingNode']);
			$query2 = $this->db->query($query2, $params);

			if ( $query2->num_rows() > 0 ) {
				$tmp[0]["attachments"] = $query2->result_array();
			}


	  }

	  return($tmp[0]);

	}
	
	function sendInvites($subjectId, $users, $emails, $message, $inviteFromName, $inviteFromEmail) {
		// limit to 1000 total at a time?
		$userId = $this->user->authCheck();
		$this->db->select("s.subjectName, s.private, s.type, s.description, s.primaryColour, t.value AS 'primaryFontColour', s.secondaryColour, s.createdBy AS 'forumCreatedById'")
			->from('Subject AS s')
			->join('ThemeFontOptions AS t', 't.id = s.primaryThemeFontOptionId')
			->where('s.subjectId', $subjectId);
		$forumResult = $this->db->get();
		// forum must exist
		if ($forumResult->num_rows() === 0) {
			return false;
		}
		$forum = $forumResult->first_row('array');
		$forumEntity = $this->subjectAttribute->getForumEntity($subjectId);
		
		$forumName = $forum['subjectName'];
		$forumDescription = $forum['description'];
		$forumType = (int)$forum['type'];
		$inviteOnlyForum = $forumEntity->is(Attribute::INVITE_ONLY());
		$forumVisibility = ForumVisibility::getVisibilityValue($forumEntity, $forum['private']);
		
		(boolean)$forum['private'];
		$ramblurForum = $forumType === self::TYPE_RAMBLUR;
		$over18Forum = $forumType === self::TYPE_CLUB18;
		$primaryColour = $forum['primaryColour'];
		$primaryFontColour = $forum['primaryFontColour'];
		$secondaryColour = $forum['secondaryColour'];
		$forumCreatedById = $forum['forumCreatedById'];
		
		// user must be allowed to issue invitations - owner or admin for inviteOnly, at least follower for public
		$accessType = $this->getUserAccessType($subjectId, $userId);
		if ($inviteOnlyForum) {
			if (!($accessType ==='admin' || $accessType === 'owner')) {
				return false;
			}
		} else {
			if (!$accessType) {
				return false;
			}
		}

		$subjectInviteInsertData = [];
		$messageInvites= [];
		$memberEmailInvites = [];
		$nonMemberEmailInvites = [];
		
		if (!empty($users)) {
			$this->db->select('u.userId, u.userName, u.email, u.DOB')
				->from('User AS u')
				->join('Permissions AS p', 'p.userId = u.userId')
				// if already following, don't invite
				->join('UserToSubject AS s', 's.userId = u.userId AND s.subjectId = '.$subjectId, 'LEFT')
				->where([
					'p.verified' => 1,
					'p.suspended' => 0,
					'p.deleted' => 0,
					's.subjectId' => NULL
				])
				->where_in('u.userId', $users);
			$existingUsers = $this->db->get()->result_array();
			
			// Only include valid users. Ignore non-valid user ids
			foreach($existingUsers as $user) {
	
				$token = $this->globals->uuid();
				$inviteData = [
					'userId' => $user['userId'],
					'email' => $user['email'],
					'subjectId' => $subjectId,
					'token' => $token
				];
	
				// Don't send the invite if the user is under 18, but invited to a club18 forum.
				if ($over18Forum) {
					$dob = new DateTime($user['DOB']);
					$now = new DateTime('today');
					$age = $dob->diff($now)->y;
					if ($age < 18) {
						$inviteData['result'] = 0;
						$subjectInviteInsertData[] = $inviteData;
						continue;
					}
				}
				$subjectInviteInsertData[] = $inviteData;
				
				// add to internal messages list
				$messageInvites[] = [
					'subjectId' => $subjectId,
					'forumName' => $forumName,
					'userId' => $user['userId'],
					'token' => $token,
					'visibility' => $forumVisibility
				];
				
				// add to email list
				$memberEmailInvites[] = [
					'forumId' => $subjectId,
					'forumName' => $forumName,
					'forumDescription' => $forumDescription,
					'email' => $user['email'],
					'token' => $token,
					'visibility' => $forumVisibility
				];
			}
		}
		// remove duplicates
		$emails = array_unique($emails);
		foreach ($emails as $email) {
			// only include valid emails
			if ($this->globals->emailVerify($email) === false) {
				continue;
			}
			$token = $this->globals->uuid();
			
			// Check if email belongs to a registered member
			$this->db->select('u.userId, u.userName, s.subjectId, u.DOB')
				->from('User AS u')
				->join('Permissions AS p', 'p.userId = u.userId')
				->join('UserToSubject AS s', 's.userId = u.userId AND s.subjectId = '.$subjectId, 'LEFT')
				->where([
					'u.email' => $email,
					'p.verified' => 1,
					'p.suspended' => 0,
					'p.deleted' => 0
				]);
			$emailUser = $this->db->get();
			$emailRegistered = $emailUser->num_rows() > 0;
			// add to internal message list AND email list if the email is registered, otherwise only add to email list
			if ($emailRegistered) {
				$registeredUser = $emailUser->first_row('array');
				// if already following, don't invite
				if (is_null($registeredUser['subjectId'])) {
					$inviteData = [
						'subjectId' => $subjectId,
						'userId' =>  $registeredUser['userId'],
						'email' => $email,
						'token' => $token
					];
					
					// Don't send the invite if the user is under 18, but invited to a club18 forum.
					if ($over18Forum) {
						$dob = new DateTime($registeredUser['DOB']);
						$now = new DateTime('today');
						$age = $dob->diff($now)->y;
						if ($age < 18) {
							// Mark the invite as declined, so we have a record the user was invited
							$inviteData['result'] = 0;
							$subjectInviteInsertData[] = $inviteData;
							continue;
						}
					}
					$subjectInviteInsertData[] = $inviteData;
					
					$messageInvites[] = [
						'subjectId' => $subjectId,
						'forumName' => $forumName,
						'userId' => $registeredUser['userId'],
						'token' => $token,
						'visibility' => $forumVisibility
					];
					$memberEmailInvites[] = [
						'forumId' => $subjectId,
						'forumName' => $forumName,
						'forumDescription' => $forumDescription,
						'email' => $email,
						'token' => $token,
						'visibility' => $forumVisibility
					];
				}
			} else {
				$nonMemberEmailInvites[] = [
					'forumId' => $subjectId,
					'forumName' => $forumName,
					'forumDescription' => $forumDescription,
					'email' => $email,
					'token' => $token,
					'visibility' => $forumVisibility
				];
				$subjectInviteInsertData[] = [
					'subjectId' => $subjectId,
					'email' => $email,
					'userId' => NULL,
					'token' => $token
				];
			}
		}

		$config = new Ramblur\CIUtils\ConfigHelper(get_instance());
		// Set a limit of 1000 invites at a time.
		if (count($subjectInviteInsertData) > $config->getConfig("max_email_batch", 30000)) {
			return false;
		}
		
		if (count($subjectInviteInsertData) > 0) {
			$this->db->insert_batch('SubjectInvite', $subjectInviteInsertData);
		}
		
		if (count($messageInvites) > 0) {
			$this->load->model('message');
			if (!$this->sendInviteMessages($messageInvites, $forumVisibility, $ramblurForum, $message, $inviteFromName, $inviteFromEmail, $forumCreatedById)) {
				return false;
			}
		}
		if (count($memberEmailInvites) > 0) {
			$template = new \Ramblur\Email\Builder\MembersSubjectInviteTemplateBuilder($ramblurForum, Logger::getLogger());
			if (!$this->sendInviteEmails($template, $memberEmailInvites, $forumVisibility, $primaryColour, $primaryFontColour, $secondaryColour, $message, $inviteFromName, $inviteFromEmail, $forumCreatedById)) {
				return false;
			}
		}
		
		if (count($nonMemberEmailInvites) > 0) {
			$template = new \Ramblur\Email\Builder\NonMembersSubjectInviteTemplateBuilder($ramblurForum, Logger::getLogger());
			if (!$this->sendInviteEmails($template, $nonMemberEmailInvites, $forumVisibility, $primaryColour, $primaryFontColour, $secondaryColour, $message, $inviteFromName, $inviteFromEmail, $forumCreatedById)) {
				return false;
			}
		}
		
		return true;
	}
	
	private function sendInviteMessages($recipients, $forumVisibility, $ramblurForum, $message='', $inviteFromName='', $inviteFromEmail='', $forumCreatedById='') {
		foreach($recipients as $r) {
			$user = $this->user->authCheck();
			$forumManagedByMsg = '';
			if($forumCreatedById === $user && !$ramblurForum) {
				$forumManagedByMsg = ' created and managed by ' . $this->user->getUserName($forumCreatedById);
			} else {
				if($ramblurForum) {
					$forumManagedByMsg = ' hosted by ramblur, of which ' . $this->user->getUserName($user) . ' is a member';
				} else {
					$forumManagedByMsg = ' of which ' . $this->user->getUserName($user) . ' is a member';
				}
			}
			$messageData = [
				'visibility' => $forumVisibility === 'private' ? ' private' : '',
				'subjectName' => $r['forumName'],
				'message' => '&ldquo;' . $message . '&rdquo;',
				'inviteFromName' => $inviteFromName . '<br/>',
				'inviteFromEmail' => $inviteFromEmail . '<br/>',
				'managedBy' => $forumManagedByMsg
			];
			$relatedData = [
				'type' => 'subjectInvite',
				'id' => $r['token']
			];
			$this->message->systemMessage($this->user->authCheck(), $r['userId'], $r['subjectId'], message::MSG_FORUM_INVITE, $messageData, $relatedData);
		}
		return true;
	}
	
	private function sendInviteEmails(\Ramblur\Email\Builder\SubjectInviteTemplateBuilder $template, $recipients, $forumVisibility, $primaryColour, $primaryFontColour, $secondaryColour, $message, $inviteFromName, $inviteFromEmail, $forumCreatedById) {		
		
		$userId = $this->user->authCheck();
		
		$template->getHeader()->setSecondaryColour($secondaryColour);

		$template->inviteMessage($message)
				->inviteFromName($inviteFromName)
				->inviteFromEmail($inviteFromEmail)
				->visibility($forumVisibility)
				->fromName($this->user->getUserName($userId))				
				->primaryColour($primaryColour)
				->primaryFontColour($primaryFontColour) ;

		$safeEmails = [];
		foreach ($recipients as $r) {			
			$recipient = $r['email'];
			$safeEmails[] = $r['email'];
			$forumUrl = base_url(urlencode(str_replace(' ', '-', $r['forumName'])) . '-forum/' . $r['forumId']);
			$template->addRecipientSubstitution($recipient, "token", $r['token'])
					->addRecipientSubstitution($recipient, "forumName", $r['forumName'])
					->addRecipientSubstitution($recipient, "forumURL", $forumUrl)
					->addRecipientSubstitution($recipient, "forumDescription", $r['forumDescription']);
		}
		
		$this->load->model("email");
		return $this->email->sendSubjectInviteEmails($safeEmails, $template, $forumCreatedById) ;	
	}
	
	public function respondToInvite($accept, $inviteId) {
		$this->db->trans_begin();
		// Only logged in user can do this
		$userId = $this->user->authCheck();
		if (!$userId) {
			return false;
		}
		$this->db->from('SubjectInvite')
			->where([
				'id' => $inviteId,
				'userId' => $userId,
				'result' => null
			]);
		$invite = $this->db->get();
		
		// Invite couldn't be found, has been already answered or wasn't sent to this user
		if ($invite->num_rows() === 0) {
			return false;
		}
		$invite = $invite->first_row('array');
		
		$this->db->select('userId')
			->from('UserToSubject')
			->where([
				'userId' => $userId,
				'subjectId' => $invite['subjectId']
			]);
		
		// User is already (or had been and is blocked) following the forum
		if ($this->db->get()->num_rows() > 0) {
			return false;
		}
		
		if ($accept) {
			$isPrivate = $this->group->getForumPrivate($invite['subjectId']);
			$this->db->query('CALL addSubjectToUserList(?, ?, 0, 1)', [$userId, $invite['subjectId']]);
			if ($this->db->affected_rows() === 0) {
				$this->db->trans_rollback();
				return false;
			}
			if ($isPrivate) {
				$this->db->update('UserToSubject', ['privateAccess' => 1], ['userId' => $userId, 'subjectId' => $invite['subjectId']]);
				if ($this->db->affected_rows() === 0) {
					$this->db->trans_rollback();
					return false;
				}
			}
			$this->user->addUserToSubjectHistory($userId, $invite['subjectId'], true);
		}
		
		// flag invite as complete. Don't delete as the message should still be available to the user
		$this->db->update('SubjectInvite', ['result' => $accept ? self::SUBJECTINVITE_ACCEPT : self::SUBJECTINVITE_DECLINE], ['id' => $inviteId]);
		if ($this->db->affected_rows() === 0) {
			$this->db->trans_rollback();
			return false;
		}
		// also complete all other invites to that same forum - mark as invalid
		$this->db->update('SubjectInvite', ['result' => self::SUBJECTINVITE_INVALID], [
			'userId' => $userId,
			'subjectId' => $invite['subjectId'],
			'id !=' => $inviteId
		]);
		
		$this->db->trans_commit();
		return $invite['subjectId'];
	}
	
	public function requestInvite($subjectIdentifier, $requesterName, $requesterEmail, $message) {
		if (!is_numeric($subjectIdentifier)){
			$subjectIdentifier = $this->findByName(urldecode(str_replace('-', ' ', $subjectIdentifier)));
		}
		if (!$subjectIdentifier) {
			return false;
		}
		$this->load->helper(array('htmlpurifier'));
		
		$this->db->select("s.subjectName, s.private, s.type, s.createdBy, s.primaryColour, t.value AS 'primaryFontColour', s.secondaryColour")
			->from('Subject AS s')
			->join('ThemeFontOptions AS t', 't.id = s.primaryThemeFontOptionId')
			->where('s.subjectId', $subjectIdentifier);
			
		$forumResult = $this->db->get();
		// forum must exist
		if ($forumResult->num_rows() === 0) {
			return false;
		}
		$forum = $forumResult->first_row('array');
		$forumEntity = $this->subjectAttribute->getForumEntity($subjectIdentifier);
		
		// Can only request invites for forums with the inviteOnly attribute
		if (!$forumEntity->is(new Attribute(Attribute::INVITE_ONLY))) {
			return false;
		}
		
		$visibility = ForumVisibility::getVisibilityValue($forumEntity, $forum['private']);
		
		$toUserDetails = $this->user->info($forum['createdBy'], true);
		if (!$toUserDetails) {
			return false;
		}
		$toName = '';
		
		if($toUserDetails['firstName'] !== '' && $toUserDetails['lastName'] !== '') {
			$toName = $toUserDetails['firstName'] . ' ' . $toUserDetails['lastName'];
		} else if ($toUserDetails['userName'] !== '') {
			$toName = $toUserDetails['userName'];
		} else if ($toUserDetails['email'] !== '') {
			$toName = $toUserDetails['email'];
		} else if ($toUserDetails['lastName'] !== '') {
			$toName = $toUserDetails['lastName'];
		} else if ($toUserDetails['firstName'] !== '') {
			$toName = $toUserDetails['firstName'];
		}
		$toAddress = $toUserDetails['email'];
		if (!$toAddress) {
			return false;
		}
		
		$template = new \Ramblur\Email\Builder\InviteRequestTemplateBuilder(Logger::getLogger());		
		$template->getHeader()->setSecondaryColour($forum["secondaryColour"]);
		$template->forumName($forum['subjectName'])
				->visibility($visibility)
				->from($requesterName)
				->email($requesterEmail)
				->message(html_purify($message));						
		$template->addRecipientSubstitution($toAddress, "to", $toName);
		
		$this->load->model("email");
		return $this->email->sendInviteRequest([$toAddress], $template) ;	

		// email owner?
		// store request, and display to owner in dashboard?
		// message owner to check dashboard?
		// include text from the requester?
		// new table if need to include text, otherwise can use SubjectInvite, with no token
	}
	
	/* 
	 * checks if the post has any maps attached and if so, returns the details
	 */
	private function getMaps($headNodeId) {
		
		$this->db->select('lat')
					->select('lng')
					->from('UserToMapMarker')
					->where('nodeId', $headNodeId);
			$mapQuery = $this->db->get();

			if ($mapQuery->num_rows() > 0) {
				
				$maps = $mapQuery->result_array();
				
				//note this url should be in config but references to google are all over the place already!
				$mapArr["node"] = $headNodeId;
				$mapArr["type"] = 'pinloc';
				$mapArr["url"]  = 'https://www.google.com/maps/@' . $maps[0]['lat'] . ',' . $maps[0]['lng'] . ',15z';
				return($mapArr);
			}
			return NULL;
	}
	
	/*
	 * returns posts for the ramblur front page (landing page)
	 * 
	 * @param int $offset
	 * @param int $limit
	 * @param date $date
	 * @param string $type
	 * @return array
	 * 
	 */
	function getLandingPageFeed($offset = 0, $limit = 10, $maxDate = NULL, $minDate = NULL, $type='post') {
		return (NULL);
		$this->load->model('user');
		$posts = array();
		
		if (empty($minDate)) {
			$minDate = date('Y-m-d', strtotime("-1000 days"));
		}
		
		if (empty($maxDate)) {
			// put in the future, so we get everything, as no max date was set
			$maxDate = date('Y-m-d', strtotime("+2 days"));
		}
		
		/*

		NB: see feedQuestionsPosts2, $type = 'home'
		changes to here will have to be reflected in fQP2 too - cjt

		*/

		$query = "SELECT
					p.postId AS 'id',
					p.postType AS 'type',
					p.subjectId,
					TIMESTAMPDIFF(SECOND, p.`timeStamp`,NOW()) as 'age',
					t.value AS 'theme', 
					IF(us.opacity IS NULL, s.opacity, us.opacity) AS 'opacity'
					FROM Post AS p
					JOIN (
						SELECT p.postId 
						FROM Post AS p
						JOIN Subject AS s ON p.subjectId = s.subjectId 
						WHERE p.timeStamp > ?
						AND p.timeStamp < ?
						AND s.private = FALSE 
						AND s.visible = TRUE
						AND (postType='post' OR postType = 'post_ad' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' OR postType = 'vlog')
						AND ((p.postId IN (SELECT postId FROM postWhiteList WHERE landingPage = TRUE AND deleted = FALSE)) 
											OR (p.postId IN (SELECT postId FROM postWhiteListPending WHERE landingPage = TRUE AND deleted = FALSE)) 
											OR (p.subjectId IN (SELECT subjectId FROM forumWhiteList WHERE landingPage = TRUE)))
						AND p.postId NOT IN (SELECT postId FROM postBlackList WHERE landingPage = TRUE)
						AND p.subjectId NOT IN (SELECT subjectId FROM forumBlackList WHERE landingPage = TRUE)
						AND p.userId NOT IN (SELECT userId FROM userPostBlackList WHERE landingPage = TRUE)
						AND (p.draftPost = FALSE OR p.draftPostVisible = TRUE)
						AND p.modDeleted = 0
						ORDER BY p.score DESC LIMIT 500
					) as s1 ON p.postId = s1.postId
					JOIN Subject AS s ON s.subjectId = p.subjectId 
					LEFT JOIN UserToSubject AS us ON us.subjectId = s.subjectId AND us.userId = ?
					JOIN ThemeColourOptions AS t ON t.id = IF(us.themeColourOptionId IS NULL, s.themeColourOptionId, us.themeColourOptionId)
					ORDER BY age ASC LIMIT $offset, $limit";

		$params = array($minDate, $maxDate, NULL);
		$query = $this->db->query($query, $params);

		if ($query->num_rows() > 0) {
			
			foreach ($query->result_array() as $row) {
				
				$threads[] = $row;
				
				$nodeCountQuery = "SELECT COUNT(nodeId) as 'count' FROM Nodes WHERE postId = ?";
				$params = array($row['id']);
				$nodeCountQuery = $this->db->query($nodeCountQuery, $params);
				$nodeCount = $nodeCountQuery->row();
				$threads[count($threads) - 1]['replies'] = $nodeCount->count;
				
				$parentNodeQuery = "SELECT nodeId FROM Nodes WHERE postId = ? and parentNodeId = 0;";
				$params = array($row['id']);
				$parentNodeQuery = $this->db->query($parentNodeQuery, $params);
				$parentNode = $parentNodeQuery->row();
				
				if ($parentNodeQuery->num_rows() > 0) {
					$threads[count($threads) - 1]['nodeId'] = $parentNode->nodeId;
				}
				
				$posts[] = $this->post($row["id"], $parentNode->nodeId, false, 0, 0, $type, 0, false, false, true, false);
				
			}
			
			return $posts;
		} else {
			return (NULL);
		}
	}
	
	/**
	 * Count of viewable (viable, useful) nodes
	 * @return type
	 */
	public function getViewableNodeCount(){
		$this->db->select("count(*) as nodeCount");
		$this->db->join("Subject","Post.subjectId = Subject.subjectId");
		$this->db->join("Nodes","Post.postId = Nodes.postId");
		$this->db->join("User","Nodes.userId = User.userId");
		$this->db->where_in("postType",['post','question','article','blog','review','event','vlog']);
		$this->db->where('(Nodes.draftNode = 0 OR draftNodeVisible = 1)');
		$this->db->where('(User.email NOT LIKE "%ramblur.com" OR Subject.private = 0)');
		$this->db->where('(User.email NOT LIKE "%zenure.com" OR Subject.private = 0)');
		return $this->db->get("Post")->row()->nodeCount;
	}
	
	/**
	 * Retrieve a summary of all viewable (viable, useful) user posts and replies 
	 * along with display relevant subject data and user data
	 * @param type $offset
	 * @param type $limit
	 * @return boolean
	 */
	public function getViewableNodesSummary(int $offset = 0, int $limit = 100){
		if(!is_numeric($offset) || !is_numeric($limit)){
			Logger::getLogger()->addError("Offset and limit must be numeric", [__FILE__,__LINE]);
			return false;
		}
		$this->db->select("Post.title,	"
							. "Post.subjectId,"
							. "Post.postId,"
							. "Nodes.userId,"
							. "Nodes.nodeId,"
							. "Nodes.datetime,"
							. "Nodes.text,"
							. "Nodes.lastEdit,"
							. "Nodes.draftNode,"
							. "Nodes.draftNodeVisible,"
							. "User.userName,"
							. "Subject.subjectName,"
							. "Subject.private,"
							. "Subject.primaryColour,"							
						);
		$this->db->join("Subject","Post.subjectId = Subject.subjectId");
		$this->db->join("Nodes","Post.postId = Nodes.postId");
		$this->db->join("User","Nodes.userId = User.userId");
		$this->db->where_in("postType",['post','question','article','blog','review','event','vlog']);
		$this->db->where('(Nodes.draftNode = 0 OR Nodes.draftNodeVisible = 1)');
		$this->db->where('(User.email NOT LIKE "%ramblur.com" OR Subject.private = 0)');
		$this->db->where('(User.email NOT LIKE "%zenure.com" OR Subject.private = 0)');
		$this->db->order_by("lastEdit", "DESC") ;
		$this->db->offset($offset);
		$this->db->limit($limit);
		$query = $this->db->get("Post") ;
		if($query->num_rows()){
			return $query->result_array();
		}
		return false;
	}
	
	function excludePost($postId, $landingPage, $mainFeed, $forum, $subjectId, $edit=false, $draft=false) {
		/* Note subjectId is the current forum subjectId */
		
		if(!$this->user->authCheck()) {
			return false;
		}
		
		if(!$edit && !$draft) {
			if(!$this->checkLandingPageForumAccess($userId, $subjectId, 'ramblur excluded landing page posts')) {
				return false;
			}
		}
		
		$deleteValues = array(
            'postId' => $postId,
			'deleted' => 1
        );
		
		$this->db->where('postId', $postId)
					->where('postId', $postId)
					->where('landingPage', $landingPage)
					->where('mainFeed', $mainFeed)
					->update('postWhiteList', $deleteValues);
		
		if($edit || $draft) {
			 $this->db->delete('postWhiteList', ['postId' => $postId]);
			 $this->db->delete('postWhiteListPending', ['postId' => $postId]);
		}
		
		$this->db->delete('nodeWhiteList', ['postId' => $postId]);
		
		return true;
	}
	
	function includePost($postId, $postUserId, $postSubjectId, $subjectId, $landingPage, $mainFeed, $forum, $draft=false) {
		
		
		$userId = $this->user->authCheck();
		$maxPosts = 200; //just in case not set later!
		
		if(!$userId) {
			return false;
		}
		
		if (!$draft) {
			if (!$this->checkLandingPageForumAccess($userId, $subjectId, 'ramblur landing page posts')) {
				return false;
			}
		}

		if (!$draft) {
			$accessType = $this->getUserAccessType($subjectId, $userId);
			if (!$accessType === 'admin' || !$accessType === 'owner' || !$accessType === 'follower') {
				return false;
			}
		}

		$query = $this->db->select('timeStamp')
					->select('lastInput')
					->select('score')		
					->where('postId', $postId)
					->where('userId', $postUserId)
					->where('subjectId', $postSubjectId)
					->get('Post');

        if ($query->num_rows() > 0) {
            $row = $query->row();
        } else {
			return false;
		}  
		
		 $postValues = array(
            'postId' => $postId,
			'timeStamp' => $row->timeStamp,
            'landingPage' => $landingPage,
			'mainFeed'=> $mainFeed
        );
		 
		$this->db->select('postId')
				->from('postWhiteListPending')
				->where('postId', $postId);

		$query = $this->db->get();

		if ($query->num_rows() <= 0) {
			$this->db->insert('postWhiteListPending', $postValues);
		}


		//get maxPosts
		$query = $this->db->select('maxPosts')
							->limit(1)
							->get('landingPageAdmin');
	
        if ($query->num_rows() > 0) {
            $maxPosts = $query->row()->maxPosts;
        } else {
			$maxPosts = 200; //default it to 200
		}  
		
		//delete oldest posts leaving maxposts count
		$query =	"DELETE 
					 FROM postWhiteList 
					 WHERE postId not in (
						SELECT * FROM (
							SELECT postId 
							FROM postWhiteList 
							ORDER BY timestamp desc limit 0, $maxPosts
									 ) 
					                 as p);";
		
		$query = $this->db->query($query);
		
		
		//update the nodeWhiteList
		$query = $this->db->select('Nodes.nodeId')
					->where('postId = '. $postId .' AND (draftNode = 0 OR draftNodeVisible = 1)')
					->get('Nodes');
		
		if ($query->num_rows() > 0) {
			
			foreach ($query->result_array() as $row) {
				
				$nodeWhiteListValues = array(
					'postId' => $postId,
					'nodeId' => $row["nodeId"],
					'landingPage' => $landingPage,
					'mainFeed' => $mainFeed
				);
				
				$this->db->select('postId')
							->select('nodeId')
							->from('nodeWhiteList')
							->where('postId', $postId)
							->where('nodeId', $row["nodeId"]);

				$queryCheck = $this->db->get();
				//$row = $queryCheck->row();

				if ($queryCheck->num_rows() <= 0) {
					$this->db->insert('nodeWhiteList', $nodeWhiteListValues);
				}
			}
			
		}  
		
		return true;
	}
	
	private function checkLandingPageForumAccess($userId, $subjectId, $forumName) {
		
		if(!$this->user->authCheck()) {
			return false;
		}
		
		$query = $this->db->select('subjectId')
					->select('subjectName')
					->select('type')		
					->where('subjectId', $subjectId)
					->get('Subject');

        if ($query->num_rows() > 0) {
            $row = $query->row();
        } else {
			return false;
		}
		
		$accessType = $this->getUserAccessType($subjectId, $userId);
		if(((int)$row->type !== self::TYPE_GENERAL && $this->getName($subjectId) !== $forumName) &&
				(!$accessType === 'admin' || !$accessType === 'owner' || !$accessType === 'follower')) {
			return false;
		} else {
			return true;
		}
		
	}
	private function getLandingPagePostSubjectType($postId) {
		
		if(!$this->user->authCheck()) {
			return false;
		}
		
		$query = $this->db->select('Subject.type')
					->join('Post', 'Post.subjectId = Subject.subjectId')
					->where('Post.postId', $postId)
					->get('Subject');

        if ($query->num_rows() > 0) {
            $row = $query->row();
			return $row->type;
        } else {
			return false;
		}
		
	}
	
	private function processWhiteList() {
		
		if(!$this->user->authCheck()) {
			return false;
		}

		$this->db->delete('postWhiteList', ['deleted' => 1]);

		$postWhiteListPendingQuery = $this->db->get('postWhiteListPending');

		//$postWhiteListValues[] = array();
		foreach ($postWhiteListPendingQuery->result() as $postWhiteListPendingRow) {
			$postWhiteListValues = array(
				'postId' => $postWhiteListPendingRow->postId,
				'landingPage' => $postWhiteListPendingRow->landingPage,
				'timeStamp' => $postWhiteListPendingRow->timeStamp,
				'mainFeed' => $postWhiteListPendingRow->mainFeed,
				'deleted' => $postWhiteListPendingRow->deleted
			);
			
			 $this->db->select('postId')
                        ->from('postWhiteList')
						->where('postId',  $postWhiteListPendingRow->postId);
						
			$query = $this->db->get();

            if ($query->num_rows() <= 0) {
				$this->db->insert('postWhiteList', $postWhiteListValues);	
			}
		}
		$this->db->empty_table('postWhiteListPending');
	}
	
	private function processWhiteListBatch() {
		
		if(!$this->user->authCheck()) {
			return false;
		}
		
		$this->db->delete('postWhiteList', ['deleted' => 1]);

		$postWhiteListPendingQuery = $this->db->get('postWhiteListPending');

		//$postWhiteListValues[] = array();
		foreach ($postWhiteListPendingQuery->result() as $postWhiteListPendingRow) {
			$postWhiteListValues[] = array(
				'postId' => $postWhiteListPendingRow->postId,
				'landingPage' => $postWhiteListPendingRow->landingPage,
				'timeStamp' => $postWhiteListPendingRow->timeStamp,
				'mainFeed' => $postWhiteListPendingRow->mainFeed,
				'deleted' => $postWhiteListPendingRow->deleted
			);
		}
		if (!empty($postWhiteListValues[0])) {
			$this->db->insert_batch('postWhiteList', $postWhiteListValues);
		}
		$this->db->empty_table('postWhiteListPending');
	}
	
	
	function checkPostOnLandingPage($postId) {
		
		if(!$this->user->authCheck()) {
			return false;
		}
		
        $this->db->select('postId')
                ->where('postId', $postId);
		$query = $this->db->get('postWhiteList');

        if ($query->num_rows() > 0) {
            return TRUE;
        } else {
			$this->db->select('postId')
                ->where('postId', $postId);
			$query = $this->db->get('postWhiteListPending');

			if ($query->num_rows() > 0) {
				return TRUE;
			} else {
				return FALSE;
			}
		}
	}
	
	function checkNodeOnLandingPage($nodeId) {
		
		if(!$this->user->authCheck()) {
			return false;
		}
		
        $this->db->select('nodeId')
                ->where('nodeId', $nodeId);
		$query = $this->db->get('nodeWhiteList');
		
        if ($query->num_rows() > 0) {
            return true;
        } 
		return false;
	}
		

	/*
	 * returns draft posts
	 * 
	 * @param int $offset
	 * @param int $limit
	 * @param date $date
	 * @param string $type
	 * @return array
	 * 
	 */
	function getDraftPosts($draftStatus, $postType = 0, $singlePost = 0, $forumId = 0, $draftUserId = 0, $ramblurAuthorSelection = 0, $draftPriorityDatePost = 0, $newForum = null, $newUserId = null, $postId = null, $nodeId = null, $offset = 0, $limit = 10, $maxDate = NULL, $minDate = NULL) {
		
		$userId = $this->user->authCheck();
		if(!$this->user->isDraftMetaUser($userId) && !$this->user->isAdmin($userId)) {
			return false;
		}
		
		if(empty($singlePost)) {
			$singlePost = 0;
		}
		
		$currentForumId = null;
		$posts = array();
		
		if (empty($minDate)) {
			$minDate = date('Y-m-d', strtotime("-1000 days"));
		}
		
		if (empty($maxDate)) {
			// put in the future, so we get everything, as no max date was set
			$maxDate = date('Y-m-d', strtotime("+2 days"));
		}
		
		if (!empty($newForum)) {
			if (!empty($postId)) {

				$this->db->select('subjectId')
						->from('Post')
						->where('postId', $postId);
				$query = $this->db->get();
				if ($query->num_rows() > 0) {
					$currentForumId = $query->row()->subjectId;
				}

				$this->db->set('subjectId', $newForum)
						->where('postId', $postId)
						->update('Post');
			}
			

			if (!empty($nodeId)) {
				
				$query = "update Content set subjectId = ? where fileName in "
						. "(select fileName from ContentToNodes where nodeID in "
						. "(select nodeId from Nodes where postId = ?))";
				$this->db->query($query, array($newForum, $postId)); 
				
				//$this->db->set('subjectId', $newForum)
				//		->where("fileName in (select fileName from ContentToNodes where nodeID in (select nodeId from Nodes where postId = $postId))")
				//		->update('Content');

				//if being moved from a private forum to public, or vice versa, need to move assets
				if (!empty($currentForumId)) {
					$privateToPublic = NULL;
					if ($this->group->getForumPrivate($currentForumId) && !$this->group->getForumPrivate($newForum)) {
						$privateToPublic = TRUE;
					} else if (!$this->group->getForumPrivate($currentForumId) && $this->group->getForumPrivate($newForum)) {
						$privateToPublic = FALSE;
					}
					if($privateToPublic !== NULL) {
						$this->moveAssets($currentForumId, $newForum, $postId, $privateToPublic);
					}
				}

				//in case its a map marker
				$this->db->set('subjectId', $newForum)
						->where('nodeId', $nodeId)
						->update('UserToMapMarker');
			}
		}


		if(!empty($newUserId) && !empty($postId)) {
			$this->db->set('userId', $newUserId)
				->where('postId', $postId)
				->update('Post');
			
		}
		
		if(!empty($newUserId) && !empty($nodeId)) {
			$this->db->set('userId', $newUserId)
				->where('nodeId', $nodeId)
				->update('Nodes');
			
			$query = "update Content set userId = ? where fileName in (select fileName from ContentToNodes where nodeID = ?)";
			$this->db->query($query, array($newUserId, $nodeId)); 
			
			//$this->db->set('userId', $newUserId)
			//	->where("fileName in (select fileName from ContentToNodes where nodeID = $nodeId)")
				//->update('Content');
			
			//in case its a map marker
			$this->db->set('userId', $newUserId)
				->where('nodeId', $nodeId)
				->update('UserToMapMarker');
			
		}
		
		/*

		NB: see feedQuestionsPosts2, $type = 'home'
		changes to here will have to be reflected in fQP2 too - cjt

		*/

		$isAdmin = $this->user->isAdmin($userId);

		$query = "SELECT
					p.postId AS 'id',
					p.postType AS 'type',
					p.subjectId,
					TIMESTAMPDIFF(SECOND, p.`timeStamp`,NOW()) as 'age',
					t.value AS 'theme', 
					IF(us.opacity IS NULL, s.opacity, us.opacity) AS 'opacity'
					FROM Post AS p
					JOIN (
						SELECT p.postId 
						FROM Post AS p
						JOIN Subject AS s ON p.subjectId = s.subjectId 
						WHERE s.visible = TRUE
						AND p.DraftPost = 1
						AND (p.DraftPostVisible = 0 OR p.draftPostReplyCount > 0)
						AND (postType='post' OR postType='question' OR postType='article' OR postType = 'blog' OR postType = 'review' OR postType = 'event' OR postType = 'vlog')
						AND (? = '0' OR p.postType = ?)
						AND (? = '0' OR p.subjectId = ?)
						AND (? = '0' OR p.userId = ?)
						AND (? = '0' OR p.userId in (select draftUserId from draftUserMapping where userId = ?))
						AND (? = '0' OR p.postId = ?)
						AND (? = '0' OR p.postId = ?)
						AND (? = '2' OR p.draftPostStatus = ?)
					) as s1 ON p.postId = s1.postId
					JOIN Subject AS s ON s.subjectId = p.subjectId 
					LEFT JOIN UserToSubject AS us ON us.subjectId = s.subjectId AND us.userId = ?
					JOIN ThemeColourOptions AS t ON t.id = IF(us.themeColourOptionId IS NULL, s.themeColourOptionId, us.themeColourOptionId)
					ORDER BY age"; 
		
		$params = array($postType, $postType, $forumId, $forumId, $draftUserId, $draftUserId, $ramblurAuthorSelection, $ramblurAuthorSelection, $draftPriorityDatePost, $draftPriorityDatePost, $singlePost, $singlePost, $draftStatus, $draftStatus, NULL);
		$query = $this->db->query($query, $params);
		
		if ($query->num_rows() > 0) {
			foreach ($query->result_array() as $row) {
				
				$threads[] = $row;
				
				$nodeCountQuery = "SELECT COUNT(nodeId) as 'count' FROM Nodes WHERE postId = ?";
				$params = array($row['id']);
				$nodeCountQuery = $this->db->query($nodeCountQuery, $params);
				$nodeCount = $nodeCountQuery->row();
				$threads[count($threads) - 1]['replies'] = $nodeCount->count;
				
				$parentNodeQuery = "SELECT nodeId FROM Nodes WHERE postId = ? and parentNodeId = 0;";
				$params = array($row['id']);
				$parentNodeQuery = $this->db->query($parentNodeQuery, $params);
				$parentNode = $parentNodeQuery->row();
				
				if ($parentNodeQuery->num_rows() > 0) {
					$threads[count($threads) - 1]['nodeId'] = $parentNode->nodeId;
				}
				
				$posts[] = $this->post($row["id"], $parentNode->nodeId, $userId, 0, 0, 'comment', 0, false, false, false, true);
				
			}
			
			return $posts;
		} else {
			return (NULL);
		}
	}
	
	function getMessageThread($postId) {
		
		$userId = $this->user->authCheck();
		if(!$this->user->isDraftMetaUser($userId) && !$this->user->isAdmin($userId)) {
			return false;
		}
		
		$posts = array();
		
		$query = " SELECT
					p.postId AS 'id',
					p.postType AS 'type',
					p.subjectId,
					TIMESTAMPDIFF(SECOND, p.`timeStamp`,NOW()) as 'age'
					FROM Post AS p
					JOIN (
						SELECT p.postId 
						FROM Post AS p
						JOIN Subject AS s ON p.subjectId = s.subjectId 
						WHERE s.visible = TRUE
						AND postType='message'
						AND postId = ?
					) as s1 ON p.postId = s1.postId
					JOIN Subject AS s ON s.subjectId = p.subjectId";
		
		$params = array($postId);
		$query = $this->db->query($query,$params);
		if ($query->num_rows() > 0) {
			foreach ($query->result_array() as $row) {
				
				$threads[] = $row;
				
				$nodeCountQuery = "SELECT COUNT(nodeId) as 'count' FROM Nodes WHERE postId = ?";
				$params = array($row['id']);
				$nodeCountQuery = $this->db->query($nodeCountQuery, $params);
				$nodeCount = $nodeCountQuery->row();
				$threads[count($threads) - 1]['replies'] = $nodeCount->count;
				
				$parentNodeQuery = "SELECT nodeId FROM Nodes WHERE postId = ? and parentNodeId = 0;";
				$params = array($row['id']);
				$parentNodeQuery = $this->db->query($parentNodeQuery, $params);
				$parentNode = $parentNodeQuery->row();
				
				if ($parentNodeQuery->num_rows() > 0) {
					$threads[count($threads) - 1]['nodeId'] = $parentNode->nodeId;
				}
				
				$posts[] = $this->post($row["id"], $parentNode->nodeId, $userId, 0, 0, 'comment', 0, false, false, false, true);
				
			}
			
			return $posts;
		} else {
			return (NULL);
		}
					
		
	}
	
	function getDraftPostsOverview($forumSelection, $priorityDatesOnly = false) {
		
		if(!$this->user->authCheck()) {
			return false;
		}
		
		$this->load->model('post');
		
		$forum = '';
		$params = array();
		if($forumSelection) {
			$forum = " AND p.subjectId = ? ";
			$params[] = $forumSelection;
		}
		
		// The sorter is a callable function that will be given to usort the
		// result array after it is compiled (if sorter is defined)
		$sorter = false;
		if($priorityDatesOnly) {
			$priorityDates = " AND p.postId IN (SELECT Nodes.postId FROM Nodes WHERE "
					. "Nodes.postId = p.postId "
					. "AND Nodes.draftNode = 1 "
					. "AND Nodes.draftNodeVisible = 0 "
					. "AND Nodes.nodePriorityDate IS NOT NULL) "
					. "AND p.draftPostStatus = 1 ";
			$sorter = function($a, $b){
						return ($a['nextPriorityDate'] < $b['nextPriorityDate']) ? -1 : 1;
					} ;
		}
		
		$query = "SELECT 
			p.postId,
			p.postType,
			p.draftPostVisible,
			p.title,
			p.subjectId,
			p.draftPost,
			p.draftPostVisible,
			p.draftPostReplyCount,
			p.draftPostStatus,
			s.subjectName
			FROM Post p
			JOIN Subject s ON p.subjectId = s.subjectId AND s.private = 0
			WHERE (p.userid in (select draftUserid from draftUserMapping) OR p.draftPost = 1) 
			AND p.postType NOT IN ('message', 'comment') " ;

		
		if($forumSelection){
			$query .= $forum ;			
		}
		
		if($priorityDatesOnly){
			$query .= $priorityDates;			
 			$query .= "ORDER BY s.subjectName, p.postType";
			
		}else{
			$query .= "ORDER BY s.subjectName, p.draftPostStatus DESC, p.draftPost DESC, p.draftPostVisible ASC, p.postType;";
		}
		
		$query = $this->db->query($query, $params);
		
		
		$posts = array();
		if ($query->num_rows() > 0) {
			$i = 0;
			foreach ($query->result_array() as $post) {
				$posts[$i] = $post;
				if ($post["draftPost"] == 1 && $post["draftPostStatus"] == 1) {
					$posts[$i]["totalDraftPostCountByForum"] = $this->post->getTotaldraftPostCountByForum($post["subjectId"]);
					$posts[$i]["totalDraftRepliesByForum"] = $this->post->getTotaldraftPostReplyCountByForum($post["subjectId"]);
					$post["draftPostVisible"] == 0 ? $posts[$i]["draftPostCount"] = 1 : $posts[$i]["draftPostCount"] = 0;
					if ($post["postType"] !== 'post') {
						$posts[$i]["title"] = substr($post["title"], 0, 40);
						if(strlen($post["title"]) >= 40) {
							$posts[$i]["title"] = $posts[$i]["title"] . "...";
						}
					} else {
						$posts[$i]["title"] = $this->post->getPostSnippet($post["postId"]);
					}
					$posts[$i]["draftReplyCount"] = $this->post->getDraftReplyCount($post["postId"]);
					$posts[$i]["hasPriorityDate"] = $this->checkPriorityDate($post["postId"]);
					$posts[$i]["nextPriorityDate"] = $this->post->getNextDraftPriorityDate($post["postId"]);
				} else {
					$posts[$i]["totalDraftPostCountByForum"] = 0;
					$posts[$i]["totalDraftRepliesByForum"] = 0;
					$posts[$i]["draftPostCount"] = 0;
					$posts[$i]["title"] = '';
					$posts[$i]["draftReplyCount"] = 0;
					$posts[$i]["hasPriorityDate"] = FALSE;
					$posts[$i]["nextPriorityDate"] = FALSE;

					$draftPost['postId'] = 0;
				}
				$i++;				
			}
//var_dump($posts);
		
			if($sorter){
				usort($posts, $sorter);
			}
			
			return $posts;
        } else {
            return (NULL);
        }
	}
	
	/**
	 * Gets a list of all asset 'filenames' in a forum from the Content table
	 * @param type $subjectId
	 * @return boolean
	 */
	function getForumFilenames($subjectId){
			if(!is_cli() && !$this->user->authCheck()){
				return false;
			}
			
			if(!$subjectId){
				return false;
			}

			$this->db->select('fileName')
					->from('Content')
					->where('subjectId',$subjectId);
			$query = $this->db->get();

			if ($query->num_rows() > 0) {
				return $query->result_array();
			}
			return [];
	}
	
	/**
	 * Gets a list of all non-personalised wallpapers for a forum. Doesn't check access or privacy,
	 * so access restricted to cli tool.	 	 
	 * 
	 * @param int|string $subjectId
	 * @return array
	 */
	function getForumBackgrounds($subjectId) {
		if(!is_cli()){
			return false;
		}
		if (!$subjectId) {
			return false;
		}
		
		$this->db->select('fileName')
			->from('SubjectDisplay')
			->where('subjectId', $subjectId)			
			->where_in('type', ['memberBg', 'thirdPartyBg']);
		$query = $this->db->get();
		
		if ($query->num_rows() > 0) {
			return $query->result_array();
		}
		return [];
	}
	
	function moveAssets($currentForumId, $newForumId, $postId, $privateToPublic) {

		$this->db->select('fileName')
				->from('ContentToNodes')
				->where('nodeID in (select nodeId from Nodes where postId = ' . $postId . ')');

		$query = $this->db->get();

		if ($query->num_rows() > 0) {
			$this->load->model('file');
			foreach ($query->result_array() as $row) {
				if ($privateToPublic) { 
					$this->file->moveFilesToPublic($row["fileName"]);
				} else {
					$this->file->moveFilesToPrivate($row["fileName"]);
				}
			}
		}
		return false;
	}

	function updateDraftPost($postId, $nodeId, $status) {
		
		if(!$this->user->adminCheck()) {
			return false;
		}
		$this->db->select('userId')
				->from('Post')
                ->where('postId', $postId);
		$query = $this->db->get();
        if ($query->num_rows() > 0) {
			if($this->user->isDraftMetaUserSelected($query->row()->userId)) {
				return false;
			}
		}
		
		$this->db->set('draftPostVisible', $status)
			->set('timeStamp', date("Y-m-d H:i:s"))	
			->set('lastInput', date("Y-m-d H:i:s"))	
			->where('postId', $postId)
			->update('Post');
		
		$this->db->set('datetime', date("Y-m-d H:i:s"))	
			->set('lastEdit', date("Y-m-d H:i:s"))
			->where('nodeId',$nodeId)
			->update('Nodes');
		
		$this->db->set('draftNodeVisible', $status)
			->set('datetime', date("Y-m-d H:i:s"))	
			->set('lastEdit', date("Y-m-d H:i:s"))
			->set('reason', NULL)
			->where('nodeId', $nodeId)
			->update('Nodes');
		
		$this->db->set('draftNodeVisible', $status)
			->where('nodeId', $nodeId)
			->update('ContentToNodes');
		
		return true;
		
	}
	
	function updateDraftPostStatus($postId, $nodeId, $status) {
		
		if(!$this->user->authCheck()) {
			return;
		}
		
		$this->db->set('draftPostStatus', $status)
			->where('postId', $postId)
			->update('Post');
		
		return true;
		
	}
	
	
	function updateDraftNode($postId, $nodeId, $hasZing, $status) {
		
		if(!$this->user->adminCheck()) {
			return false;
		}
			
		$this->db->select('userId')
				->from('Nodes')
                ->where('nodeId', $nodeId);
		$query = $this->db->get();
        if ($query->num_rows() > 0) {
			if($this->user->isDraftMetaUserSelected($query->row()->userId)) {
				return false;
			}
		}
		
		$this->db->set('draftNodeVisible', $status)
			->set('datetime', date("Y-m-d H:i:s"))	
			->set('lastEdit', date("Y-m-d H:i:s"))
			->set('reason', NULL)	
			->where('nodeId', $nodeId)
			->update('Nodes');
		
		$this->db->set('draftNodeVisible', $status)
			->where('nodeId', $nodeId)
			->update('ContentToNodes');
		
		if($status) {
			$this->db->set('draftPostReplyCount', 'draftPostReplyCount-1', FALSE); 
		} else {
			$this->db->set('draftPostReplyCount', 'draftPostReplyCount+1', FALSE);
		}
			$this->db->where('postId', $postId)
				->update('Post');
			
		//if it's got a zing, approve first child in the zing
		//@todo : Note - could approve all zings under this parent and then reduce reply counts
		//Check if this is required functionality	
		if($hasZing) {
			$this->db->set('draftNodeVisible', $status)
			->set('datetime', date("Y-m-d H:i:s"))	
			->set('lastEdit', date("Y-m-d H:i:s"))
			->set('reason', NULL)	
			->where('parentNodeId', $nodeId)
			->update('Nodes');
			
			if($status) {
				$this->db->set('draftPostReplyCount', 'draftPostReplyCount-1', FALSE); 
			} else {
				$this->db->set('draftPostReplyCount', 'draftPostReplyCount+1', FALSE);
			}
				$this->db->where('postId', $postId)
							->update('Post');
		}
			
		return true;
		
	}
	
	function deleteDraftNode($postId, $nodeId) {
		
		if(!$this->user->adminCheck()) {
			return false;
		}
		
		$query = "CALL deleteNode(?)";
		$params = array($nodeId);
		$query = $this->db->query($query, $params);
		
		$this->db->set('draftPostReplyCount', 'draftPostReplyCount-1', FALSE)
			->where('postId', $postId)
			->update('Post');
		
		return $this->db->affected_rows() > 0;
	}

	function updateDraftPostReplyCount($postId) {
		
		if(!$this->user->authCheck()) {
			return false;
		}
		
		$this->db->select('draftPost')
				->from('Post')
                ->where('postId', $postId);
		$query = $this->db->get();
		$makeDraft = false;
        if ($query->num_rows() > 0) {
			if($query->row()->draftPost == 0) {
				$makeDraft = true;
			}
		}
		
		$this->db->set('draftPostReplyCount', 'draftPostReplyCount+1', FALSE)
					->set('draftPostStatus', 0); //set back to pending
				if($makeDraft) {
			$this->db->set('draftPost', 1)
					->set('draftPostVisible', 1);
		}
			$this->db->where('postId', $postId)
					->update('Post');
			
			
		$this->db->set('draftNodeVisible', 1)
				->where('postId', $postId)
				->where('draftNode', 0)
				->where('draftNodeVisible', 0)
				->update('Nodes');		
		
		return true;
		
	}
        
	function setNodePriorityDate($dateVal, $nodeId) {
		
		if(!$this->user->authCheck()) {
			return false;
		}
		
		if (empty($dateVal)) {
			$this->db->set('nodePriorityDate', null);
		} else {
			$tz = new DateTimeZone('Australia/Brisbane');
			$dt = new DateTime($dateVal);
			$dt->setTimezone($tz);
			$this->db->set('nodePriorityDate', $dt->format('Y-m-d'));
		}
		
		$this->db->where('nodeId', $nodeId);
		$this->db->update('Nodes');
		return $this->db->affected_rows() > 0;
	}
	
	
	function checkPriorityDate($postId) {
		
		$this->db->select('nodePriorityDate')
				->from('Nodes')
				->where('postId', $postId)
				->where('draftNode', 1)
				->where('draftNodeVisible', 0)
				->where('nodePriorityDate !=', NULL)
				->limit(1);

		$query = $this->db->get();

		if ($query->num_rows() > 0) {
			return $query->row()->nodePriorityDate;
		}
		return FALSE;
	}
	
	function nextPriorityDate($postId) {
		
		$this->db->select('nodePriorityDate')
				->from('Nodes')
				->where('postId', $postId)
				->where('draftNode', 1)
				->where('draftNodeVisible', 0)
				->where('nodePriorityDate !=', NULL)
				->limit(1);

		$query = $this->db->get();

		if ($query->num_rows() > 0) {
			return $query->row()->nodePriorityDate;
		}
		return FALSE;
	}

	
	function ifValidDraftPostKillReplies($postId) {
		
		if (!$this->user->authCheck()) {
			return false;
		}

		$this->db->select('draftPostReplyCount')
				->from('Post')
				->where('postId', $postId)
				->where('draftPost', 1);

		$query = $this->db->get();

		if ($query->num_rows() > 0) {
			if ($query->row()->draftPostReplyCount > 0) {
				$this->db->set('draftNodeKilled', 1)
						->where('postId', $postId)
						->where('draftNode', 1)
						->where('draftNodeVisible', 0)
						->update('Nodes');

				$this->db->set('draftNodeVisible', 1)
						->where('postId', $postId)
						->where('draftNode', 0)
						->where('draftNodeVisible', 0)
						->update('Nodes');
			}
		}
		return true;
	}

	function killPostReplies($postId) {
		
		if (!$this->user->authCheck()) {
			return false;
		}

		$this->db->set('draftNodeKilled', 1)
				->where('postId', $postId)
				->where('draftNode', 1)
				->where('draftNodeVisible', 0)
				->update('Nodes');
		
		$this->db->set('draftNodeVisible', 1)
				->where('postId', $postId)
				->where('draftNode', 0)
				->where('draftNodeVisible', 0)
				->update('Nodes');
	}
	
	
	function clearDraftReplyCount($postId) {
		
		if(!$this->user->adminCheck()) {
			return false;
		}
		
		$this->db->set('draftPostReplyCount', 0)
			->where('postId', $postId)
			->update('Post');
		
		if($this->db->affected_rows()) {
				return TRUE;
			} else { 
				return FALSE;
			}
	
	}
	
	function setToPending($postId) {
		
		if(!$this->user->adminCheck()) {
			return false;
		}
		
		$this->db->set('draftPostStatus', 0)
			->where('postId', $postId)
			->update('Post');
		
		if($this->db->affected_rows()) {
				return TRUE;
			} else { 
				return FALSE;
			}
	
	}
	
	function mapDraftUserToMetaUser($metaUserId, $draftUserId) {
		
		if (!$this->user->adminCheck()) {
			return false;
		}
		
		$this->db->insert('draftUserMapping', array('userId' => $metaUserId, 'draftUserId' => $draftUserId));

		return $this->db->affected_rows();
	
	}
	
	/**
	 * Returns the filenames of the background image to be shown as 
	 * search result thumbnails for the subjects
	 * matching the subjectIds array.
	 * 
	 * Notes
	 * - Retrieves active backgrounds only
	 * - Backgrounds are ordered by the order column, if a background is inactive it must
	 *   retrieve the first active background - hence the min() inner join below
	 * - Ramblur and private forums get the memberBg background
	 * - Ramblur Black forums get the thirdPartyBg background
	 *
	 * Note: authorisation for forum access should be checked prior to 
	 * calling this function
	 *
	 * @param array $subjectIds
	 */
	function getSearchThumbnailBackground(array $subjectIds) {
		if (empty($subjectIds)) {
			return;
		}
		$thumbs = [];

		foreach (array_chunk($subjectIds, 200) as $chunkOfIds) {			
			$query = "SELECT
							SubjectDisplay.subjectId, SubjectDisplay.fileName
						FROM
							SubjectDisplay	
						INNER JOIN(
								SELECT
									SubjectDisplay.subjectId,
									min( `order` ) as bgOrder
								FROM
									SubjectDisplay,
									Subject
								WHERE
									`userId` IS NULL
									AND `active` = 1
									AND SubjectDisplay.type = IF(
										Subject.`type` = ?
										OR Subject.`private` = 1,
										'memberBg',
										'thirdPartyBg'
									)
									AND SubjectDisplay.subjectId = Subject.subjectId
									AND Subject.subjectId IN ?
								group by
									SubjectDisplay.subjectId
							) sub ON
							SubjectDisplay.subjectId = sub.subjectId
							AND SubjectDisplay.`order` = sub.bgOrder
						INNER JOIN Subject ON SubjectDisplay.subjectId = Subject.subjectId
						WHERE
							`userId` IS NULL
							AND `active` = 1
							AND SubjectDisplay.type = IF(
								Subject.`type` = ?
								OR Subject.`private` = 1,
								'memberBg',
								'thirdPartyBg'
							);" ;
			$results = $this->db->query($query,[Group::TYPE_RAMBLUR,$chunkOfIds, Group::TYPE_RAMBLUR])->result_array();
		
			if (count($results)) {
				$thumbs = array_merge($thumbs, $results);
			}
		}		
		
		if (!empty($thumbs)) {
			return $thumbs;
		}
		return false;
	}
	
	function infoFeed($subjectId) {

		$infoFeed = array();
		$userId = $this->user->authCheck();

		$this->db->select("t.value AS 'theme'", FALSE)
				->select("f.value AS 'themeFontSecondary'", FALSE)
				->select("ff.value AS 'themeFontPrimary'", FALSE)
				->select("sa.name AS 'vis'", FALSE)
				->select("IF(`u`.`opacity` IS NULL, `s`.`opacity`, `u`.`opacity`) AS 'opacity'", FALSE)
				->select('s.subjectId')
				->select('s.subjectName')
				->select('s.type')
				->select('s.description')
				->select('s.primaryColour AS primaryColour')
				->select('s.secondaryColour AS secondaryColour')
				->select('s.opacity AS opacity')
				->select('s.banner')
				->select('u.primaryColour AS userprimaryColour')
				->select('u.secondaryColour AS usersecondaryColour')
				->select('u.opacity AS userOpacity')
				->select('ss.subscribers')
				->select('mod.moderator AS forumModerator')
				->select('about.aboutUsText')
				->from('Subject AS s')
				->join('UserToSubject AS u', 'u.subjectId = s.subjectId AND u.active = 1 AND u.userId ' . ($userId ? '= ' . $userId : 'IS NULL'), 'LEFT')
				->join('ThemeColourOptions AS t', 't.id = IF(u.themeColourOptionId IS NULL, s.themeColourOptionId, u.themeColourOptionId)', 'INNER', FALSE)
				->join('ThemeFontOptions AS f', 'f.id = IF(u.secondaryThemeFontOptionId IS NULL, s.secondaryThemeFontOptionId, u.secondaryThemeFontOptionId)', 'INNER', FALSE)
				->join('ThemeFontOptions AS ff', 'ff.id = IF(u.primaryThemeFontOptionId IS NULL, s.primaryThemeFontOptionId, u.primaryThemeFontOptionId)', 'INNER', FALSE)
				->join('SubjectAttributeToSubject AS sas', 'sas.subjectId = s.subjectId', 'LEFT')
				->join('SubjectAttributes AS sa', 'sa.id = sas.attributeid', 'LEFT')
				->join('SubjectSubscribers AS ss', 'ss.subjectId = s.subjectId', 'LEFT')
				->join('ModeratorToSubject AS mod', 'mod.approved = 1 AND mod.subjectId = s.subjectId AND mod.userId ' . ($userId ? '= ' . $userId : 'IS NULL'), 'LEFT')
				->join('SubjectToAboutText AS about', 's.subjectId = about.id', 'LEFT')
				//->where('s.subjectId !=', 873)
				//->where('s.subjectId !=', 131)
				//->where('s.subjectId !=', 463)
				//->where('s.subjectId !=', 95)
				//->where('s.subjectId !=', 550)
				->where('s.subjectId', $subjectId);


		$subjectinfoFeedResults = $this->db->get();

		if ($subjectinfoFeedResults->num_rows() > 0) {
			$infoFeed["infoFeedData"] = $subjectinfoFeedResults->result_array()[0];

			$forumName = $this->getName($subjectId);
			
			$infoFeed["relatedForums"] = $this->getRelatedForums($subjectId, $forumName);
			
			if($subjectId == '714') { //change this to main feed and type check!!!!!!!!!!!11111
				$infoFeed["allPublicForums"] = $this->getAllPublicForums();
			}
			$topForumIds = $this->getTopForumIds();
			if($topForumIds) {
				$infoFeed["topForumThumbnails"] = $this->getSearchThumbnailBackground($topForumIds);
			}
			
			$latestForumIds = $this->getLatestForumIds();
			if($latestForumIds) {
				$infoFeed["latestForumThumbnails"] = $this->getSearchThumbnailBackground($latestForumIds);
			}
			
			$allForumIds = $this->getAllPublicForumIds();
			if($allForumIds) {
				$infoFeed["allForumThumbnails"] = $this->getSearchThumbnailBackground($allForumIds);
			}
			
			$infoFeed["forumTheme"] = $this->getForumTheme($userId);
			
			return $infoFeed;
		}
		return false;
	}
	
	function getForumTheme($userId) {
		
		$this->db->select('forumTheme')
				->from('UserToSubject')
				->where('userId', $userId)
				->where('subjectId', 1);

		$forumTheme = $this->db->get();

		if ($forumTheme->num_rows() > 0) {
			return $forumTheme->result_array()[0]["forumTheme"];
		}
		return null;
	}

	function getRelatedForums($subjectId, $forumName) {

		$userId = $this->user->authCheck();

		if (empty($userId)) {
			$userId = 0;
		}

		$relatedForums = array();
		$relatedForums["level1"] = [];
		$relatedForums["level2"] = [];
		$relatedForums["level2dups"] = [];

		$forumName = (string) $forumName;

		$this->db->select('categoryLevel2, Subject.subjectId AS forumId, subjectName, UserToSubject.subjectId AS subscribed, Subject.type')
				->from('ForumToForumCategories')
				->join('Subject', 'ForumToForumCategories.forumName = Subject.subjectName AND Subject.private = 0 AND Subject.subjectName not in (select relatedForumName from RelatedForums where RelatedForums.forumName = "' . $forumName . '")', null, false)
				->join('UserToSubject', 'UserToSubject.subjectId = Subject.subjectId AND ' . $userId . ' = UserToSubject.userId', 'LEFT')
				//->join('Post', 'Post.subjectId = Subject.subjectId AND Post.visible = 1 AND (Post.draftPost = 0 OR Post.draftPostVisible = 1)', 'LEFT', null, false)
				->where('categoryLevel2 in (select categoryLevel2 from ForumToForumCategories where ForumToForumCategories.forumName = "' . $forumName . '") and ForumToForumCategories.forumName != "' . $forumName . '"')
				->DISTINCT()
				->group_by('categoryLevel2, forumId, subjectName, subscribed');;
				//->order_by('numPosts', 'DESC')->order_by('categoryLevel2', 'DESC');

		$relatedForumsResults1 = $this->db->get();
		if ($relatedForumsResults1->num_rows() > 0) {
			$relatedForums["level2"] = $relatedForumsResults1->result_array();
		}

		$this->db->select('categoryLevel1, Subject.subjectId AS forumId, subjectName, UserToSubject.subjectId AS subscribed, Subject.type')
				->from('ForumToForumCategories')
				->join('Subject', 'ForumToForumCategories.forumName = Subject.subjectName AND Subject.private = 0 AND Subject.subjectName not in (select relatedForumName from RelatedForums where RelatedForums.forumName = "' . $forumName . '")', null, false)
				->join('UserToSubject', 'UserToSubject.subjectId = Subject.subjectId AND ' . $userId . ' = UserToSubject.userId', 'LEFT')
				//->join('Post', 'Post.subjectId = Subject.subjectId AND Post.visible = 1 AND (Post.draftPost = 0 OR Post.draftPostVisible = 1)', 'LEFT', null, false)
				->where('categoryLevel1 in (select categoryLevel1 from ForumToForumCategories where forumName = "' . $forumName . '") and forumName != "' . $forumName . '"')
				//if you want top level only, use line below
				//->where('categoryLevel2 is null and categoryLevel1 in (select categoryLevel1 from ForumToForumCategories where forumId = ' . $subjectId . ') and forumId != ' . $subjectId . '')
				->DISTINCT()
				->group_by('categoryLevel1, forumId, subjectName, subscribed');
			//	->order_by('numPosts', 'DESC')->order_by('categoryLevel1', 'DESC');

		$relatedForumsResults2 = $this->db->get();

		if ($relatedForumsResults2->num_rows() > 0) {
			foreach ($relatedForumsResults2->result_array() as $forum) {
				foreach ($relatedForumsResults1->result_array() as $forum2) {
					if ($forum["forumId"] == $forum2["forumId"]) {
						array_push($relatedForums["level2dups"], $forum2["forumId"]);
					}
				}
			}
			$relatedForums["level1"] = $relatedForumsResults2->result_array();
		}

		$relatedForums["mostPopular"] = null;
		$this->db->select('SubjectAttributes.name as inviteStatus, Subject.subjectId AS forumId, Subject.subjectName, UserToSubject.subjectId AS subscribed, Subject.type, Subject.description')
				->from('TopForums')
				->join('Subject', 'TopForums.forumId = Subject.subjectId '
						. 'AND Subject.private = 0 AND Subject.visible = 1 AND (Subject.subjectName != "my feed") AND (Subject.subjectName != "main feed")')
				->join('UserToSubject', 'UserToSubject.subjectId = Subject.subjectId AND ' . $userId . ' = UserToSubject.userId', 'LEFT')
				->join('SubjectAttributeToSubject', 'SubjectAttributeToSubject.subjectId = Subject.subjectId', 'LEFT')
				->join('SubjectAttributes', 'SubjectAttributeToSubject.attributeId = SubjectAttributes.id', 'LEFT')
				->order_by('position');

		$relatedForumsResults = $this->db->get();

		if ($relatedForumsResults->num_rows() > 0) {
			$relatedForums["mostPopular"] = $relatedForumsResults->result_array();
		}
		
		
		//latest forums
		$relatedForums["latestForums"] = [];
		$this->db->select('SubjectAttributes.name as inviteStatus, Subject.subjectId AS forumId, Subject.subjectName, UserToSubject.subjectId AS subscribed, Subject.type, Subject.description')
				->from('LatestForums')
				->join('Subject', 'LatestForums.forumId = Subject.subjectId '
						. 'AND Subject.private = 0 AND Subject.visible = 1 AND (Subject.subjectName != "my feed") AND (Subject.subjectName != "main feed")')
				->join('UserToSubject', 'UserToSubject.subjectId = Subject.subjectId AND ' . $userId . ' = UserToSubject.userId', 'LEFT')
				->join('SubjectAttributeToSubject', 'SubjectAttributeToSubject.subjectId = Subject.subjectId', 'LEFT')
				->join('SubjectAttributes', 'SubjectAttributeToSubject.attributeId = SubjectAttributes.id', 'LEFT')
				->order_by('position');

		$relatedForumsResults = $this->db->get();

		if ($relatedForumsResults->num_rows() > 0) {
			$relatedForums["latestForums"] = $relatedForumsResults->result_array();
		}
		
		
		
		//special cases	
		$relatedForums["specialCases"] = [];
		
		$this->db->select('Subject.subjectId as forumId, subjectName, UserToSubject.subjectId AS subscribed, Subject.type, 1 AS numPosts')
				->from('RelatedForums')
				->join('Subject', 'relatedForumName = subjectName AND Subject.private = 0 ')
				->join('UserToSubject', 'UserToSubject.subjectId = Subject.subjectId AND ' . $userId . ' = UserToSubject.userId', 'LEFT')
				//->join('Post', 'Post.subjectId = Subject.subjectId AND Post.visible = 1 AND (Post.draftPost = 0 OR Post.draftPostVisible = 1)', 'LEFT')
				->where('forumName', $forumName)
				//if you want top level only, use line below
				//->where('categoryLevel2 is null and categoryLevel1 in (select categoryLevel1 from ForumToForumCategories where forumId = ' . $subjectId . ') and forumId != ' . $subjectId . '')
				->DISTINCT()
				->group_by('forumId, subjectName, subscribed');
				//->order_by('numPosts', 'DESC');

		$relatedForumsResults = $this->db->get();

		if ($relatedForumsResults->num_rows() > 0) {
			$relatedForums["specialCases"] = $relatedForumsResults->result_array();
		}

		return $relatedForums;
	}
	
	
	function getTopForumIds() {

		$topForumIds = [];

		$this->db->select('forumId AS subjectId')
				->from('TopForums');

		$topForums = $this->db->get();

		if ($topForums->num_rows() > 0) {
			
			forEach($topForums->result_array() as $topForumId) {
				array_push($topForumIds, $topForumId["subjectId"]);
			}
			return $topForumIds;
		}
		return null;
	}
	
	function getLatestForumIds() {

		$latestForumIds = [];

		$this->db->select('forumId AS subjectId')
				->from('LatestForums');

		$latestForums = $this->db->get();

		if ($latestForums->num_rows() > 0) {
			
			forEach($latestForums->result_array() as $latestForumId) {
				array_push($latestForumIds, $latestForumId["subjectId"]);
			}
			return $latestForumIds;
		}
		return null;
	}


